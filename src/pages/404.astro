---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout lang="zh" title="404 / 页面不存在" metadata={{title:'页面不存在',description:'找不到请求的页面。',canonicalPath:'/404',noindex:true}}>
  <main class="not-found-fallback">
    <p>404 / PAGE NOT FOUND</p>
    <h1>找不到这个页面</h1>
    <p>正在打开对应语言的找回页面。你也可以直接返回首页。</p>
    <a href="/zh/">返回首页</a>
  </main>
  <script is:inline>
    (() => {
      const locale = location.pathname.match(/^\/(zh-tw|zh-hk|zh|ja|en)(?:\/|$)/)?.[1] || 'zh';
      const destination = new URL(`/${locale}/404/`, location.origin);
      if (location.pathname !== destination.pathname) {
        destination.searchParams.set('from', location.pathname + location.search);
        location.replace(destination);
      }
    })();
  </script>
</BaseLayout>
<style>
  .not-found-fallback{min-height:100dvh;display:grid;align-content:center;justify-items:start;gap:1rem;width:min(64rem,calc(100% - 2rem));margin:auto;color:var(--theme-fg)}
  .not-found-fallback :is(h1,p){margin:0}.not-found-fallback h1{font:400 clamp(2rem,6vw,4rem)/1.2 var(--font-serif)}
  .not-found-fallback a{display:inline-flex;align-items:center;min-height:44px;border:1px solid currentColor;padding:.7rem 1rem}
</style>
