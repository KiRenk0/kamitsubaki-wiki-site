---
import WorkspaceLayout from '../../../layouts/WorkspaceLayout.astro';
import WorkspaceButton from '../../../components/WorkspaceButton.astro';
import {supportedLocales,resolveLocaleCopy} from '../../../lib/i18n.mjs';
import '../../../styles/galleryArchive.css';
export function getStaticPaths(){return supportedLocales.map(locale=>({params:{locale}}));}
const locale=Astro.params.locale!;
const api=import.meta.env.PUBLIC_GALLERY_API_URL||import.meta.env.PUBLIC_AI_OBSERVER_API_BASE||'https://api.kamitsubaki.wiki';
const copy=resolveLocaleCopy({
 zh:{title:'设定资料图库',intro:'以角色与形态整理视觉档案。一套设定收录一组图片，保留来源与公开记录。',back:'返回探索',upload:'上传与完善',roles:'角色目录',rolesHint:'选择角色，查看其形态与设定组。',latest:'最新设定组',roleSets:'设定组',allForms:'全部形态',unclassified:'未分类',search:'搜索设定名称',clear:'清除条件',more:'加载更多设定',retry:'重新加载',loading:'正在载入图库…',error:'图库暂时无法加载，请重试。',empty:'还没有公开的设定组。',noMatch:'没有符合条件的设定组。',images:'张图片',sets:'套设定',allRoles:'全部角色',backToSets:'返回设定组',backToRecord:'返回投稿记录',source:'资料来源',original:'查看原图',date:'资料日期',publisher:'发布机构',notes:'设定备注',edit:'完善这套设定',related:'词条档案'},
 ja:{title:'設定資料ギャラリー',intro:'キャラクターと形態から視覚資料を探せます。一つの設定に複数の画像と出典を記録します。',back:'探索に戻る',upload:'投稿・編集',roles:'キャラクター',rolesHint:'キャラクターを選ぶと形態別の設定が表示されます。',latest:'新着の設定',roleSets:'設定一覧',allForms:'すべての形態',unclassified:'未分類',search:'設定名を検索',clear:'条件をクリア',more:'さらに読み込む',retry:'再読み込み',loading:'読み込み中…',error:'読み込めません。再試行してください。',empty:'公開済みの設定はまだありません。',noMatch:'該当する設定はありません。',images:'枚の画像',sets:'件の設定',allRoles:'すべて',backToSets:'設定一覧へ',backToRecord:'投稿記録へ戻る',source:'出典',original:'原画像を見る',date:'資料の日付',publisher:'公開元',notes:'補足',edit:'設定を編集',related:'関連項目'},
 en:{title:'Reference gallery',intro:'Explore visual archives by character and form. Each set brings its images and sources together.',back:'Back to Explore',upload:'Upload / edit',roles:'Characters',rolesHint:'Choose a character to browse forms and design sets.',latest:'Latest design sets',roleSets:'Design sets',allForms:'All forms',unclassified:'Unclassified',search:'Search set titles',clear:'Clear filters',more:'Load more sets',retry:'Retry',loading:'Loading gallery…',error:'Gallery unavailable. Please try again.',empty:'No published design sets yet.',noMatch:'No matching sets.',images:'images',sets:'sets',allRoles:'All characters',backToSets:'Back to sets',backToRecord:'Back to submission',source:'Source',original:'View original',date:'Date',publisher:'Publisher',notes:'Notes',edit:'Improve this set',related:'Related entry'}
},locale);
---
<WorkspaceLayout locale={locale} title={copy.title} intro={copy.intro} path="/gallery/" eyebrow="EXPLORE / VISUAL ARCHIVE" backHref={`/${locale}/explore/`} backLabel={copy.back} width="wide" mainAttributes={{class:'gallery-archive','data-gallery':'','data-api':api,'data-locale':locale,'data-copy':JSON.stringify(copy)}}>
 <Fragment slot="actions"><WorkspaceButton href={`/${locale}/gallery/manage/`} tone="primary">{copy.upload}</WorkspaceButton></Fragment>
 <div class="gallery-overview" data-gallery-overview>
  <section class="gallery-role-section" aria-labelledby="gallery-roles-title"><div class="gallery-section-heading"><div><span>01 / INDEX</span><h2 id="gallery-roles-title">{copy.roles}</h2><p>{copy.rolesHint}</p></div></div><div class="gallery-role-list" data-gallery-roles></div></section>
  <section class="gallery-set-section" aria-labelledby="gallery-sets-title"><div class="gallery-section-heading"><div><span>02 / ARCHIVE</span><h2 id="gallery-sets-title" data-gallery-section-title>{copy.latest}</h2></div><output data-gallery-count></output></div>
   <form class="gallery-toolbar" data-gallery-search role="search"><label><span>{copy.search}</span><input type="search" name="q" placeholder={copy.search} autocomplete="off"/></label><button type="button" data-gallery-clear>{copy.clear}</button></form>
   <nav class="gallery-form-list" data-gallery-forms aria-label={copy.allForms}></nav>
   <p class="gallery-feedback" data-gallery-feedback role="status" aria-live="polite"></p><div class="gallery-set-grid" data-gallery-grid></div>
   <div class="gallery-bottom"><button type="button" data-gallery-more hidden>{copy.more}</button><button type="button" data-gallery-retry hidden>{copy.retry}</button></div>
  </section>
 </div>
 <section class="gallery-set-detail" data-gallery-detail hidden aria-labelledby="gallery-detail-title"><button type="button" class="gallery-detail-back" data-gallery-back>← {copy.backToSets}</button><header class="gallery-detail-head"><div><p data-gallery-detail-path></p><h2 id="gallery-detail-title" data-gallery-detail-title></h2><p data-gallery-detail-meta></p></div><WorkspaceButton data-gallery-edit href={`/${locale}/gallery/manage/`}>{copy.edit} ↗</WorkspaceButton></header><div class="gallery-detail-layout"><div class="gallery-detail-images" data-gallery-images></div><aside class="gallery-detail-aside"><dl data-gallery-properties></dl><WorkspaceButton data-gallery-related hidden tone="quiet" href={`/${locale}/database/`}>{copy.related} ↗</WorkspaceButton></aside></div></section>
</WorkspaceLayout>
<script>import {initGallery} from '../../../lib/gallery';initGallery();</script>
