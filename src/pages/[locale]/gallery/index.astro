---
import {GALLERY_PUBLIC_ORIGIN} from '../../../lib/galleryConfig.mjs';
import {entityLabel} from '../../../lib/entityLabels.mjs';
import WorkspaceHeader from '../../../components/WorkspaceHeader.astro';
import FeatureNavigation from '../../../components/labs/FeatureNavigation.astro';
import '../../../styles/labsFeatures.css';
import {getCollection} from 'astro:content';import BaseLayout from '../../../layouts/BaseLayout.astro';import SiteNav from '../../../components/SiteNav.astro';import SiteFooter from '../../../components/SiteFooter.astro';import {getLocalizedSite} from '../../../lib/homeData.mjs';import {buildLocaleLinks,resolveLocaleCopy} from '../../../lib/i18n.mjs';import {getEntityRegistry,entityLocales} from '../../../lib/entityRegistry.mjs';import {loadFeatureData,featureText,galleryImageUrl,loadTaxonomy} from '../../../lib/featureData.mjs';import '../../../styles/encyclopedia.css';import '../../../styles/observatoryWorkspaces.css';
export function getStaticPaths(){return entityLocales.map(locale=>({params:{locale}}));}
const locale=Astro.params.locale!;const site=getLocalizedSite(await getCollection('site'),locale);const data=await loadFeatureData();const registry=await getEntityRegistry();const base=import.meta.env.PUBLIC_GALLERY_R2_URL||GALLERY_PUBLIC_ORIGIN;
const copy=resolveLocaleCopy({zh:{title:'设定资料图库',intro:'角色、衣装与世界观的视觉档案。每张素材保留来源、设计阶段和收录记录。',empty:'设定资料正在整理，首批素材收录后将在这里展示。',noMatch:'没有符合条件的素材。',all:'全部',character:'角色',form:'形态',tag:'设计标签',year:'时期',publisher:'来源机构',close:'关闭',zoom:'缩放',reset:'重置视图',original:'查看原图',uploader:'收录者（非原图作者）',source:'来源出处'},ja:{title:'設定資料ギャラリー',intro:'キャラクター・衣装・世界観の視覚資料。出典、制作時期、収録者を記録します。',empty:'設定資料を整理中です。収録後、ここに表示されます。',noMatch:'該当する資料はありません。',all:'すべて',character:'キャラクター',form:'形態',tag:'タグ',year:'時期',publisher:'出典元',close:'閉じる',zoom:'拡大',reset:'表示をリセット',original:'原寸画像',uploader:'収録者（原作者ではありません）',source:'出典'},en:{title:'Reference gallery',intro:'A visual archive of characters, costumes and worlds, with provenance and collection records.',empty:'Reference material is being organized. Images will appear here once catalogued.',noMatch:'No matching images.',all:'All',character:'Character',form:'Form',tag:'Design tag',year:'Period',publisher:'Publisher',close:'Close',zoom:'Zoom',reset:'Reset view',original:'Original image',uploader:'Collected by (not the artist)',source:'Source'}},locale);
const viewCopy=resolveLocaleCopy({zh:{previous:'上一张',next:'下一张',loading:'正在加载原图…',error:'原图暂时无法加载，可使用原图链接重试。'},ja:{previous:'前の画像',next:'次の画像',loading:'画像を読み込み中…',error:'画像を読み込めません。原寸画像のリンクから再試行できます。'},en:{previous:'Previous image',next:'Next image',loading:'Loading original…',error:'Image unavailable. Try the original image link.'}},locale);
const items=data.gallery.map(i=>({...i,src:galleryImageUrl(i.image.src,base),thumbnail:galleryImageUrl(i.image.thumbnail||i.image.src,base),formLabel:entityLabel(i.form,locale),tagLabels:i.tags.map(tag=>entityLabel(tag,locale)),notes:i.notes?featureText(i.notes,locale):'',entities:[...new Set([i.subject,...(i.characters||[])])].map(id=>registry.resolveEntity(id,locale)).filter((e): e is NonNullable<typeof e>=>Boolean(e))}));
const characters=[...new Set(items.flatMap(i=>i.characters||[]))].map(id=>registry.resolveEntity(id,locale)).filter((e): e is NonNullable<typeof e>=>Boolean(e));const forms=(await loadTaxonomy('forms')).values;const tags=(await loadTaxonomy('gallery-tags')).values;
const filters=[{name:'character',label:copy.character,options:characters.map(e=>({value:e.data.id,label:e.data.name||e.data.title}))},{name:'form',label:copy.form,options:forms.map(x=>({value:x,label:entityLabel(x,locale)}))},{name:'tag',label:copy.tag,options:tags.map(x=>({value:x,label:entityLabel(x,locale)}))},{name:'year',label:copy.year,options:[...new Set(items.map(i=>i.date?.slice(0,4)).filter((e): e is NonNullable<typeof e>=>Boolean(e)))].map(x=>({value:x,label:entityLabel(x,locale)}))},{name:'publisher',label:copy.publisher,options:[...new Set(items.map(i=>i.source.publisher).filter((e): e is NonNullable<typeof e>=>Boolean(e)))].map(x=>({value:x,label:entityLabel(x,locale)}))}];
---
<BaseLayout title={`${copy.title} · Kamitsubaki Studio Fan Wiki`} lang={locale}><SiteNav navItems={site.navItems} localeLinks={buildLocaleLinks(site,locale,'/gallery/')} brandLines={site.hero.brandLines} homeHref={`/${locale}/`}/><main data-api={import.meta.env.PUBLIC_GALLERY_API_URL||import.meta.env.PUBLIC_AI_OBSERVER_API_BASE||'https://api.kamitsubaki.wiki'} data-locale={locale} class="wiki-v3 feature-workspace" data-gallery><WorkspaceHeader title={copy.title} intro={copy.intro} eyebrow="LABs / GALLERY"><a href={`/${locale}/labs/explore/`}>← LABs</a><a href={`/${locale}/gallery/manage/`}>{locale==='en'?'Upload / edit':locale==='ja'?'投稿・編集':'上传与完善'}</a></WorkspaceHeader><FeatureNavigation locale={locale} current="gallery"/>
<form class="toolbar feature-filters">{filters.map(control=><label><span>{control.label}</span><select disabled={!items.length} name={control.name} aria-label={control.label}><option value="">{control.label}: {copy.all}</option>{control.options.map(x=><option value={x.value}>{x.label}</option>)}</select></label>)}<button type="reset" class="filter-reset">{locale==='en'?'Clear filters':locale==='ja'?'条件をクリア':'清除筛选'}</button></form>
<p data-gallery-load-status role="status"></p><button type="button" data-gallery-retry hidden>重新加载</button><p class="feature-count" data-count aria-live="polite">{items.length}</p><div class="gallery-grid">{items.map(item=><button type="button" class="gallery-card" data-item={item.id} data-character={(item.characters||[]).join(' ')} data-form={item.form||''} data-tag={item.tags.join(' ')} data-year={item.date?.slice(0,4)||''} data-publisher={item.source.publisher||''}><img src={item.thumbnail} alt={item.entities.map(e=>e.data.name).join(' / ')||item.source.title||item.id} loading="lazy" width={item.image.dimensions?.width} height={item.image.dimensions?.height}/><span>{item.entities.map(e=>e.data.name).join(' / ')||item.id}</span><small>{entityLabel(item.form,locale)} · {item.date}</small></button>)}</div><p class="empty gallery-empty" data-empty hidden={items.length>0}><span class="archive-empty-mark" aria-hidden="true">＋</span><span class="archive-empty-caption" aria-hidden="true">VISUAL ARCHIVE / 001</span>{items.length?copy.noMatch:copy.empty}</p>
<dialog data-inspector aria-label={copy.title}><button class="close" data-close aria-label={copy.close}>×</button><div class="inspector-layout"><div class="image-panel"><div class="image-stage" data-stage><img data-full-image alt="" draggable="false"/><p class="gallery-image-status" data-image-status role="status"></p></div><div class="zoom-controls"><label>{copy.zoom} <input type="range" min="1" max="5" step=".1" value="1" data-zoom/></label><output data-zoom-value>100%</output><button data-reset>{copy.reset}</button><button data-previous aria-label={viewCopy.previous}>←</button><button data-next aria-label={viewCopy.next}>→</button></div></div><aside><h2 data-image-title></h2><div data-entity-links class="toolbar"></div><p data-image-meta></p><p data-image-notes></p><h3>{copy.source}</h3><p data-source></p><p data-uploader></p><a data-edit-image>完善资料 →</a><a data-original target="_blank" rel="noopener noreferrer">{copy.original} ↗</a></aside></div></dialog>
<script type="application/json" data-gallery-json set:html={JSON.stringify({items,uploaderLabel:copy.uploader,viewCopy}).replaceAll('<','\\u003c')}/></main><SiteFooter footer={site.footer}/></BaseLayout>
<style is:global>.gallery-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:20px}.gallery-card{text-align:left;cursor:zoom-in}.gallery-card img{width:100%;height:260px;object-fit:contain}.gallery-card span,.gallery-card small{display:block;margin-top:10px}.gallery-card small{opacity:.5}[data-gallery] dialog{width:min(1300px,95vw);max-height:94dvh;border:1px solid #8885;border-radius:8px;background:var(--theme-bg,#111);color:var(--theme-fg,#eee);padding:24px}[data-gallery] dialog::backdrop{background:#000b;backdrop-filter:blur(8px)}[data-gallery] .close{position:absolute;top:8px;right:8px;z-index:2}.inspector-layout{display:grid;grid-template-columns:minmax(0,2fr) minmax(250px,1fr);gap:28px}.image-stage{height:70dvh;overflow:hidden;touch-action:none;display:grid;place-items:center;background:#08090b;cursor:grab}.image-stage img{max-width:100%;max-height:100%;object-fit:contain;transform-origin:center;user-select:none}.zoom-controls{display:flex;gap:12px;align-items:center;margin-top:12px}@media(max-width:760px){.inspector-layout{grid-template-columns:1fr}.image-stage{height:48dvh}.gallery-card img{height:200px}}</style>
<script>import {initGallery} from '../../../lib/gallery';initGallery();</script>

<style is:global>
html body [data-gallery] .workspace-heading h1{font-size:34px}html body [data-gallery] .workspace-header{padding-bottom:26px;margin-bottom:18px}
[data-gallery] .feature-filters select:disabled{opacity:.4;cursor:default}
[data-gallery] .gallery-card{overflow:hidden;background:none;border:0;border-bottom:1px solid rgb(var(--theme-fg-rgb)/.15);border-radius:0;padding:16px 0 22px}
[data-gallery] .gallery-card img{transition:transform .5s,opacity .3s;opacity:.85}[data-gallery] .gallery-card:hover img{transform:scale(1.025);opacity:1}
[data-gallery] dialog{border-radius:3px;padding:32px}[data-gallery] .image-stage{position:relative;background:rgb(var(--theme-fg-rgb)/.025)}[data-gallery] .image-stage[data-loading=true] img{opacity:0}[data-gallery] .gallery-image-status{position:absolute;inset:45% 24px auto;text-align:center;font-size:12px;color:rgb(var(--theme-fg-rgb)/.6);pointer-events:none}
[data-gallery] .zoom-controls{flex-wrap:wrap;font:10px var(--font-mono);gap:12px;border-top:1px solid rgb(var(--theme-fg-rgb)/.15);padding-top:14px}[data-gallery] .zoom-controls label{display:flex;align-items:center;gap:10px}[data-gallery] .zoom-controls input{width:100px;accent-color:var(--theme-accent-color)}[data-gallery] .zoom-controls button{background:none;border:0;padding:8px;font-size:11px;cursor:pointer}[data-gallery] .zoom-controls button:disabled{opacity:.3;cursor:default}
[data-gallery] dialog aside{padding:20px 0;min-width:0}[data-gallery] dialog h2{font:400 25px/1.8 var(--font-serif);margin:0 0 20px}[data-gallery] dialog h3{font-size:10px;opacity:.5;margin-top:28px}[data-gallery] dialog p{font-size:12px;line-height:2;overflow-wrap:anywhere}[data-gallery] dialog a{font-size:11px;text-underline-offset:4px;overflow-wrap:anywhere}[data-gallery] [data-uploader]{opacity:.45;border-top:1px solid rgb(var(--theme-fg-rgb)/.12);margin-top:28px;padding-top:18px}
@media(max-width:760px){[data-gallery] dialog{padding:24px 16px}[data-gallery] .zoom-controls{gap:8px}[data-gallery] dialog aside{padding-top:0}[data-gallery] .image-stage{height:45dvh}}
@media(prefers-reduced-motion:reduce){[data-gallery] .gallery-card img{transition:none;transform:none!important}}
</style>
