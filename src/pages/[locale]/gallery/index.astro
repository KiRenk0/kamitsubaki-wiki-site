---
import WorkspaceLayout from '../../../layouts/WorkspaceLayout.astro';
import WorkspaceButton from '../../../components/WorkspaceButton.astro';
import {supportedLocales,resolveLocaleCopy} from '../../../lib/i18n.mjs';
import '../../../styles/galleryArchive.css';
export function getStaticPaths(){return supportedLocales.map(locale=>({params:{locale}}));}
const locale=Astro.params.locale!;
const api=import.meta.env.PUBLIC_GALLERY_API_URL||import.meta.env.PUBLIC_AI_OBSERVER_API_BASE||'https://api.kamitsubaki.wiki';
const copy=resolveLocaleCopy({
 zh:{title:'神椿图片档案',intro:'浏览所有已公开图片。可以按人物、团体、图片类型和标签查找，也可以为未分类照片提出整理建议。',back:'返回探索',upload:'投稿图片',roles:'人物与团体',rolesHint:'选择对象，浏览与其关联的全部公开照片。',latest:'最新设定组',latestPhotos:'最新照片',photo:'照片',photos:'全部照片',viewSets:'设定组',roleSets:'设定组',photosInSet:'只看本组照片',clearSet:'清除设定组筛选',allForms:'全部形态',unclassified:'未分类',filters:'筛选图片',search:'搜索照片或设定',clear:'清除条件',more:'加载更多',retry:'重新加载',loading:'正在载入图库…',error:'图库暂时无法加载，请重试。',empty:'公开图片需要核对来源与使用依据；通过审核后会出现在这里。你也可以投稿图片。',noMatch:'没有符合条件的内容。',images:'张图片',sets:'套设定',allRoles:'全部对象',backToSets:'返回设定组',backToRecord:'返回投稿记录',source:'资料来源',original:'查看原图',date:'资料日期',publisher:'发布机构',notes:'设定备注',edit:'完善这套设定',related:'词条档案',allTypes:'全部类型',unclassifiedType:'待分类',tags:'全部标签',choose:'多选照片',cancelChoose:'结束多选',classify:'提出分类建议',typeSetting:'设定图',typePortrait:'肖像',typeCover:'作品封面',typePromo:'宣传视觉',typeEvent:'演出／活动',classifyPhoto:'完善这张照片',unknownPhoto:'尚未命名的照片',siteEntry:'查看本站词条',existingSiteNote:'本站既有图片；原图作者、出处与使用依据待补充'},
 ja:{title:'神椿ビジュアルアーカイブ',intro:'公開画像を閲覧できます。人物・グループ・種類・タグで探し、未分類画像の整理を提案できます。',back:'探索に戻る',upload:'画像を投稿',roles:'人物とグループ',rolesHint:'関連する公開画像を見る',latest:'新着の設定',latestPhotos:'新着の画像',photo:'画像',photos:'すべての画像',viewSets:'設定一覧',roleSets:'設定一覧',photosInSet:'この設定の画像を見る',clearSet:'設定の絞り込みを解除',allForms:'すべての形態',unclassified:'未分類',filters:'絞り込み',search:'画像・設定を検索',clear:'条件をクリア',more:'さらに読み込む',retry:'再読み込み',loading:'読み込み中…',error:'読み込めません。再試行してください。',empty:'画像は出典と利用根拠を確認し、審査を通過するとここに表示されます。画像の投稿もできます。',noMatch:'該当する資料はありません。',images:'枚の画像',sets:'件の設定',allRoles:'すべて',backToSets:'設定一覧へ',backToRecord:'投稿記録へ戻る',source:'出典',original:'原画像を見る',date:'資料の日付',publisher:'公開元',notes:'補足',edit:'設定を編集',related:'関連項目',allTypes:'すべての種類',unclassifiedType:'未分類',tags:'すべてのタグ',choose:'画像を複数選択',cancelChoose:'選択を終了',classify:'分類を提案',typeSetting:'設定画',typePortrait:'ポートレート',typeCover:'作品カバー',typePromo:'プロモーション画像',typeEvent:'ライブ／イベント',classifyPhoto:'この画像を分類',unknownPhoto:'無題の画像',siteEntry:'サイト内の記事を見る',existingSiteNote:'既存のサイト画像。原画像の作者・出典・利用根拠は追記待ち'},
 en:{title:'KAMITSUBAKI image archive',intro:'Explore all published images. Find them by person, group, type or tag, and suggest classification for unclassified photos.',back:'Back to Explore',upload:'Contribute images',roles:'People and groups',rolesHint:'Browse all public photos linked to a person or group.',latest:'Latest design sets',latestPhotos:'Latest photos',photo:'Photo',photos:'All photos',viewSets:'Design sets',roleSets:'Design sets',photosInSet:'View photos in this set',clearSet:'Clear set filter',allForms:'All forms',unclassified:'Unclassified',filters:'Filter photos',search:'Search photos or sets',clear:'Clear filters',more:'Load more',retry:'Retry',loading:'Loading gallery…',error:'Gallery unavailable. Please try again.',empty:'Images appear here after their sources and usage basis are reviewed. You can contribute photos, too.',noMatch:'No matching material.',images:'images',sets:'sets',allRoles:'All subjects',backToSets:'Back to sets',backToRecord:'Back to submission',source:'Source',original:'View original',date:'Date',publisher:'Publisher',notes:'Notes',edit:'Improve this set',related:'Related entry',allTypes:'All types',unclassifiedType:'Needs classification',tags:'All tags',choose:'Select photos',cancelChoose:'Done selecting',classify:'Suggest classification',typeSetting:'Setting art',typePortrait:'Portrait',typeCover:'Cover art',typePromo:'Promotional image',typeEvent:'Live / event',classifyPhoto:'Classify this photo',unknownPhoto:'Untitled photo',siteEntry:'View wiki entry',existingSiteNote:'Existing site image; original creator, source and usage basis need verification'}
},locale);
Object.assign(copy,resolveLocaleCopy({
 zh:{roleSearch:'查找人物或团体',showAllRoles:'展开全部人物与团体',collapseRoles:'收起人物与团体',moreLoading:'正在加载下一页…',loaded:'已显示',noSets:'暂无已公开设定组',noSetsHint:'现有图片作为独立照片收录；经过投稿与审核组成资料后，会显示在这里。',browsePhotos:'浏览全部照片',createSet:'创建设定组',suggestedPhotos:'先看看这些公开照片',download:'下载照片',imageType:'图片类型',subject:'关联对象',author:'图片作者',attribution:'来源核对',setName:'所属设定组'},
 ja:{roleSearch:'人物・グループを探す',showAllRoles:'人物とグループをすべて表示',collapseRoles:'人物とグループを閉じる',moreLoading:'次の画像を読み込み中…',loaded:'表示中',noSets:'公開済みの設定一覧はまだありません',noSetsHint:'既存の画像は個別の写真として公開中です。投稿・審査を経て資料にまとめられると、ここに表示されます。',browsePhotos:'すべての画像を見る',createSet:'設定資料を作る',suggestedPhotos:'公開画像から探す',download:'画像を保存',imageType:'画像の種類',subject:'関連する人物',author:'画像の作者',attribution:'出典の確認',setName:'所属する設定'},
 en:{roleSearch:'Find a person or group',showAllRoles:'Show all people and groups',collapseRoles:'Show fewer',moreLoading:'Loading next page…',loaded:'Showing',noSets:'No published design sets yet',noSetsHint:'Existing images are available as individual photos. Curated sets will appear here after contribution and review.',browsePhotos:'Browse all photos',createSet:'Create a design set',suggestedPhotos:'Explore these public photos',download:'Download photo',imageType:'Image type',subject:'Related subjects',author:'Image creator',attribution:'Source check',setName:'Design set'}
},locale));
---
<WorkspaceLayout locale={locale} title={copy.title} intro={copy.intro} path="/gallery/" eyebrow="EXPLORE / VISUAL ARCHIVE" backHref={`/${locale}/explore/`} backLabel={copy.back} width="wide" mainAttributes={{class:'gallery-archive','data-gallery':'','data-mobile-filters':'closed','data-api':api,'data-locale':locale,'data-copy':JSON.stringify(copy)}}>
 <Fragment slot="actions"><WorkspaceButton href={`/${locale}/gallery/manage/`} tone="primary">{copy.upload}</WorkspaceButton></Fragment>
 <div class="gallery-overview" data-gallery-overview>
  <section class="gallery-role-section" id="gallery-role-filters" aria-labelledby="gallery-roles-title"><div class="gallery-role-head"><div><span>PEOPLE / GROUPS</span><h2 id="gallery-roles-title">{copy.roles}</h2><p>{copy.rolesHint}</p></div><button type="button" data-gallery-roles-toggle aria-expanded="false">{copy.showAllRoles} ↓</button></div><label class="gallery-role-search" hidden data-gallery-role-search-label><span>{copy.roleSearch}</span><input type="search" data-gallery-role-search placeholder={copy.roleSearch} autocomplete="off"/></label><div class="gallery-role-list" data-gallery-roles></div></section>
  <section class="gallery-set-section" aria-labelledby="gallery-sets-title"><div class="gallery-section-heading"><div><span>VISUAL ARCHIVE</span><h2 id="gallery-sets-title" data-gallery-section-title>{copy.latestPhotos}</h2></div><output data-gallery-count></output></div>
   <div class="gallery-browse-bar"><div class="gallery-view-switch" role="group" aria-label={copy.title}><button type="button" data-gallery-view="photos" aria-pressed="true">{copy.photos}</button><button type="button" data-gallery-view="sets" aria-pressed="false">{copy.viewSets}</button></div>
    <form class="gallery-toolbar" id="gallery-search-filters" data-gallery-search role="search"><label><span>{copy.search}</span><input type="search" name="q" placeholder={copy.search} autocomplete="off"/></label><button type="button" data-gallery-clear>{copy.clear}</button></form></div>
   <nav class="gallery-type-list" data-gallery-types aria-label={copy.allTypes}></nav>
   <button class="gallery-filter-toggle" type="button" data-gallery-filter-toggle aria-expanded="false" aria-controls="gallery-role-filters gallery-search-filters gallery-form-filters"><span data-gallery-filter-label>{copy.filters}</span><span aria-hidden="true">＋</span></button>
   <div class="gallery-extra-tools"><label>{copy.tags}<select data-gallery-tag><option value="">{copy.tags}</option></select></label><button type="button" data-gallery-select>{copy.choose}</button><a data-gallery-classify hidden href={`/${locale}/gallery/classify/`}>{copy.classify}</a></div>
   <nav class="gallery-form-list" id="gallery-form-filters" data-gallery-forms aria-label={copy.allForms}></nav>
   <div class="gallery-set-filter" data-gallery-set-filter hidden><span data-gallery-set-filter-name></span><button type="button" data-gallery-set-filter-clear>{copy.clearSet} ×</button></div>
   <p class="gallery-feedback" data-gallery-feedback role="status" aria-live="polite"></p><div class="gallery-set-grid" data-gallery-grid></div>
   <div class="gallery-bottom"><button type="button" data-gallery-more hidden>{copy.more}</button><button type="button" data-gallery-retry hidden>{copy.retry}</button></div>
  </section>
 </div>
 <section class="gallery-set-detail" data-gallery-detail hidden aria-labelledby="gallery-detail-title"><button type="button" class="gallery-detail-back" data-gallery-back>← {copy.backToSets}</button><header class="gallery-detail-head"><div><p data-gallery-detail-path></p><h1 id="gallery-detail-title" data-gallery-detail-title></h1><p data-gallery-detail-meta></p></div><div class="gallery-detail-actions"><button type="button" data-gallery-photos-in-set>{copy.photosInSet} →</button><WorkspaceButton data-gallery-edit href={`/${locale}/gallery/manage/`}>{copy.edit} ↗</WorkspaceButton></div></header><div class="gallery-detail-layout"><div class="gallery-detail-images" data-gallery-images></div><aside class="gallery-detail-aside"><dl data-gallery-properties></dl><WorkspaceButton data-gallery-related hidden tone="quiet" href={`/${locale}/database/`}>{copy.related} ↗</WorkspaceButton></aside></div></section>
</WorkspaceLayout>
<script>
 import {initGallery} from '../../../lib/gallery';
 initGallery();
</script>
