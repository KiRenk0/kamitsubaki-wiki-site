---
import WorkspaceLayout from '../../../../layouts/WorkspaceLayout.astro';
import {supportedLocales,resolveLocaleCopy} from '../../../../lib/i18n.mjs';
import '../../../../styles/galleryClassification.css';
export function getStaticPaths(){return supportedLocales.map(locale=>({params:{locale}}));}
const locale=Astro.params.locale!;
const api=import.meta.env.PUBLIC_GALLERY_API_URL||import.meta.env.PUBLIC_AI_OBSERVER_API_BASE||'https://api.kamitsubaki.wiki';
const copy=resolveLocaleCopy({
 zh:{title:'完善照片分类',intro:'为已公开照片补充人物、类型和标签。建议审核通过后才会改变公开资料。',back:'返回图库',selected:'选中的照片',type:'图片类型',keep:'保留现有类型',unclassified:'暂不分类',entities:'关联人物或团体',search:'搜索人物或团体',tags:'补充标签',tagsHint:'多个标签用逗号分隔。批量操作会追加标签和关联，不覆盖每张图原有资料。',set:'加入设定组（可选）',setSearch:'搜索已公开设定组',noSet:'不改变设定组',submit:'提交分类建议',login:'登录后建议分类',pending:'正在读取照片…',empty:'未指定照片，请从图库选择图片。',review:'建议已提交审核。原公开资料会保持不变，直到审核通过。',receipt:'查看创作者中心记录',source:'资料来源',unknownPhoto:'尚未命名的照片'},
 ja:{title:'画像の分類を提案',intro:'公開画像に人物・種類・タグを追加できます。審査後に反映されます。',back:'ギャラリーへ',selected:'選択した画像',type:'画像の種類',keep:'現在の種類を維持',unclassified:'未分類',entities:'人物・グループ',search:'人物・グループを検索',tags:'タグを追加',tagsHint:'複数のタグはカンマで区切ります。一括操作は既存の情報を保持して追加します。',set:'設定セットに追加（任意）',setSearch:'公開セットを検索',noSet:'セットは変更しない',submit:'分類を審査に提出',login:'ログインして提案',pending:'画像を読み込み中…',empty:'ギャラリーから画像を選択してください。',review:'分類案を審査に提出しました。承認までは公開情報は変わりません。',receipt:'クリエイターセンターで確認',source:'出典',unknownPhoto:'無題の画像'},
 en:{title:'Suggest photo classification',intro:'Add people, types and tags to public photos. Changes appear after review.',back:'Back to gallery',selected:'Selected photos',type:'Image type',keep:'Keep the current type',unclassified:'Unclassified',entities:'People or groups',search:'Find people or groups',tags:'Add tags',tagsHint:'Separate tags with commas. Bulk changes add to each photo’s existing tags and links.',set:'Add to a design set (optional)',setSearch:'Find a public design set',noSet:'Keep current set',submit:'Submit classification',login:'Sign in to classify',pending:'Loading photos…',empty:'Select photos in the gallery first.',review:'Submitted for review. Public details stay unchanged until approval.',receipt:'Track this proposal in Creator Center',source:'Source',unknownPhoto:'Untitled photo'}
},locale);
---
<WorkspaceLayout locale={locale} title={copy.title} intro={copy.intro} path="/gallery/classify/" eyebrow="GALLERY / CLASSIFY" backHref={`/${locale}/gallery/`} backLabel={copy.back} noindex width="wide" mainAttributes={{class:'gallery-classify','data-gallery-classify':'','data-api':api,'data-locale':locale,'data-copy':JSON.stringify(copy)}}>
 <div class="gallery-classify-layout"><section class="gallery-classify-photos"><h2>{copy.selected}</h2><div data-classify-photos><p>{copy.pending}</p></div></section><form class="gallery-classify-form" data-classify-form><h2>{copy.title}</h2><label>{copy.type}<select data-classify-type><option value="__keep__">{copy.keep}</option><option value="">{copy.unclassified}</option></select></label><fieldset><legend>{copy.entities}</legend><input type="search" data-classify-entity-search placeholder={copy.search}/><div data-classify-entities></div></fieldset><label>{copy.tags}<input data-classify-tags maxlength="1000"/><small>{copy.tagsHint}</small></label><label>{copy.set}<input type="search" data-classify-set placeholder={copy.setSearch} list="classify-set-list" autocomplete="off"/><datalist id="classify-set-list" data-classify-set-list></datalist><small>{copy.noSet}</small></label><button type="submit">{copy.submit}</button><p data-classify-status role="status" aria-live="polite"></p><a class="gallery-classify-next-link" data-classify-receipt hidden href={`/${locale}/account/creator/`}>{copy.receipt} →</a><a class="gallery-classify-next-link" data-classify-login hidden href={`/${locale}/account/`}>{copy.login} →</a></form></div>
</WorkspaceLayout>
<script>import '../../../../scripts/galleryClassification.js';</script>
