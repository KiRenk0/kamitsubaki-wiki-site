---
import {getCollection} from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SiteNav from '../../../../components/SiteNav.astro';
import SiteFooter from '../../../../components/SiteFooter.astro';
import ContentSkeleton from '../../../../components/ContentSkeleton.astro';
import {getLocalizedSite} from '../../../../lib/homeData.mjs';
import {buildLocaleLinks,supportedLocales} from '../../../../lib/i18n.mjs';
import {activityCopy} from '../../../../lib/activityCopy.mjs';
import '../../../../styles/community.css';
import '../../../../styles/activityCenter.css';
import '../../../../styles/entityInfoBox.css';
import '../../../../styles/entitySectionNav.css';
export function getStaticPaths(){return supportedLocales.map(locale=>({params:{locale}}));}
const locale=Astro.params.locale||'zh',c=activityCopy(locale),api=import.meta.env.PUBLIC_COMMUNITY_API_URL||import.meta.env.PUBLIC_GALLERY_API_URL||'https://api.kamitsubaki.wiki';
const site=getLocalizedSite(await getCollection('site'),locale),path='/community/activities/read/';
---
<BaseLayout lang={locale} reading title={c.board} metadata={{title:c.board,description:'',canonicalPath:`/${locale}${path}`,noindex:true}} alternates={supportedLocales.map(code=>({locale:code,href:`/${code}${path}`}))}>
 <SiteNav navItems={site.navItems} localeLinks={buildLocaleLinks(site,locale,path)} brandLines={site.hero.brandLines} homeHref={`/${locale}/`}/>
 <main class="community-page entity-reader activity-detail-page" data-community-document="activity" data-locale={locale} data-api={api} data-copy={JSON.stringify(c)}>
  <section data-community-content><div class="reader-frame reader-heading-frame mx-auto px-4 sm:px-6"><h1 class="sr-only">{c.board}</h1><ContentSkeleton kind="lines" count={3}/></div></section>
  <footer class="reader-frame mx-auto px-4 sm:px-6"><div class="activity-detail-footer"><a data-community-export hidden>{c.calendarShort}</a><a data-community-correct href={`/${locale}/community/activities/apply/`}>{c.correction}</a></div></footer>
 </main>
 <SiteFooter footer={site.footer}/>
</BaseLayout>
<script>
 import {initCommunityDocument} from '../../../../scripts/communityDocument.js';
 import {enhanceActivityDocument} from '../../../../scripts/activityDocument.js';
 const root=document.querySelector('[data-community-document]');
 void (async()=>{await initCommunityDocument(root);await enhanceActivityDocument(root);})();
</script>
