---
import WorkspaceLayout from '../../../../layouts/WorkspaceLayout.astro';
import {supportedLocales} from '../../../../lib/i18n.mjs';
import {communityCopy} from '../../../../lib/communityCopy.mjs';
import '../../../../styles/community.css';
export function getStaticPaths(){return supportedLocales.map(locale=>({params:{locale}}));}
const locale=Astro.params.locale||'zh',c=communityCopy(locale),api=import.meta.env.PUBLIC_COMMUNITY_API_URL||import.meta.env.PUBLIC_GALLERY_API_URL||'https://api.kamitsubaki.wiki';
---
<WorkspaceLayout locale={locale} title={c.board} intro={c.intro} path="/community/activities/" eyebrow="COMMUNITY / OBSERVER PROJECTS" width="wide" mainAttributes={{class:'community-page','data-community-calendar':'','data-locale':locale,'data-api':api,'data-copy':JSON.stringify(c)}}>
 <div class="community-actions" slot="actions"><a href={`/${locale}/community/activities/apply/`}>{c.apply}</a><a href={`/${locale}/events/`}>{c.officialCalendar}</a></div>
 <form class="community-calendar-filters" data-calendar-filters>
  <label>{c.calendar}<input name="month" type="month" aria-label={c.calendar}/></label>
  <details class="community-filter-details" data-calendar-filter-details open><summary data-calendar-filter-summary>{c.filterActivities}</summary><div class="community-toolbar">
  <label>{c.country}<select name="country"><option value="">{c.all}</option></select></label>
  <label>{c.city}<select name="city"><option value="">{c.all}</option></select></label>
  <label>{c.mode}<select name="mode"><option value="">{c.all}</option>{['online','offline','hybrid'].map(mode=><option value={mode}>{c[mode]}</option>)}</select></label>
  <label>{c.category}<select name="category"><option value="">{c.all}</option>{['new-year','support','meetup','convention','other'].map(category=><option value={category}>{c[category]}</option>)}</select></label>
  <label>{c.search}<input name="q" type="search" placeholder={c.search}/></label>
  </div></details>
 </form>
 <div class="community-toolbar"><button type="button" data-calendar-previous aria-label={c.previous}>←</button><button type="button" data-calendar-today>{c.today}</button><button type="button" data-calendar-next aria-label={c.next}>→</button><div class="community-view-tabs"><button type="button" data-calendar-view="calendar" aria-pressed="false">{c.calendar}</button><button type="button" data-calendar-view="agenda" aria-pressed="false">{c.agenda}</button></div><label><input type="checkbox" data-deadline-toggle checked/>{c.pointToggle}</label></div>
 <p>{c.dateBasis}</p><p data-calendar-status role="status">{c.loading}</p><button type="button" data-calendar-retry hidden>{c.retry}</button>
 <section data-calendar-month-panel><div class="community-weekdays" data-calendar-weekdays aria-hidden="true"></div><div class="community-month-grid" data-calendar-grid></div></section>
 <section class="community-agenda" data-calendar-agenda aria-live="polite"></section>
 <section class="community-undated" data-calendar-undated-section hidden><h2>{c.undated}</h2><div data-calendar-undated></div></section>
 <section data-community-featured-section hidden><h2>{c.featured}</h2><div class="community-card-grid" data-community-featured></div></section>
 <footer class="community-actions"><a data-community-subscribe href="#">{c.subscribe}</a><button type="button" data-community-copy-subscription>{c.copySubscription}</button><a href={`/${locale}/community/activities/apply/`}>{c.apply}</a></footer>
</WorkspaceLayout>
<script>import {initCommunityCalendar} from '../../../../scripts/communityCalendar.js';initCommunityCalendar(document.querySelector('[data-community-calendar]'));</script>
