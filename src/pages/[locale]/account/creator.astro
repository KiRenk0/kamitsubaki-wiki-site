---
import WorkspaceLayout from '../../../layouts/WorkspaceLayout.astro';
import AccountSections from '../../../components/AccountSections.astro';
import {supportedLocales} from '../../../lib/i18n.mjs';
import {editorApiBase} from '../../../lib/editorConfig.mjs';
import {creatorCenterCopy} from '../../../lib/creatorCenterCopy.mjs';
import '../../../styles/account.css';
import '../../../styles/creatorWorkspace.css';
export function getStaticPaths(){return supportedLocales.map(locale=>({params:{locale}}));}
const locale=Astro.params.locale||'zh',c=creatorCenterCopy(locale);
const api=import.meta.env.PUBLIC_ARTICLE_API_URL||import.meta.env.PUBLIC_AI_OBSERVER_API_BASE||'https://api.kamitsubaki.wiki';
const create=[['entry',c.newEntry,`/${locale}/contribute/editor/`],['article',c.newArticle,`/${locale}/articles/submit/`],['gallery',c.newGallery,`/${locale}/gallery/manage/`]];
---
<WorkspaceLayout locale={locale} title={c.title} intro={c.intro} path="/account/creator/" eyebrow="CREATOR SPACE" backHref={`/${locale}/account/`} backLabel={c.back} width="wide" noindex mainAttributes={{'class':'account-shell creator-page','data-creator-center':'','data-locale':locale,'data-api':api,'data-editor-api':editorApiBase,'data-copy':JSON.stringify(c)}}>
  <Fragment slot="actions"><details class="creator-new"><summary>{c.create}</summary><div>{create.map(([type,label,href])=><a href={href} data-type={type}>{label}</a>)}</div></details></Fragment>
  <div class="account-workspace"><AccountSections locale={locale} active="creator"/><div class="account-panels creator-content"><div class="creator-main">
    <p data-creator-status role="status" class="creator-status">{c.loading}</p>
    <section class="creator-guest" data-creator-guest hidden><p class="creation-caption">01 / START CREATING</p><h2>{c.loginHint}</h2><div>{create.map(([type,label,href],index)=><a href={href}><span>0{index+1}</span><strong>{label}</strong><small>{type==='entry'?c.entry:type==='article'?c.article:c.gallery}</small><b aria-hidden="true">↗</b></a>)}</div><a class="creator-login" data-creator-login href={`/${locale}/account/?returnTo=${encodeURIComponent(`/${locale}/account/creator/`)}`}>{c.signIn} →</a></section>
    <section class="creator-section creator-todo" aria-labelledby="creator-todo-title" hidden><div class="creator-heading"><h2 id="creator-todo-title">{c.todo}</h2><span data-todo-count></span></div><div data-creator-todo><p>{c.loading}</p></div></section>
    <section class="creator-section" aria-labelledby="creator-dashboard-title" hidden><div class="creator-heading"><h2 id="creator-dashboard-title">{c.dashboard}</h2></div><div class="creator-metrics">{(['attention','review','published','draft'] as const).map(key=><button type="button" data-metric={key}><span>{c[key]}</span><strong data-metric-count={key}>—</strong></button>)}</div></section>
    <section class="creator-section creator-local" aria-labelledby="creator-local-title" hidden><div class="creator-heading"><h2 id="creator-local-title">{c.local}</h2><span>{c.localNote}</span></div><div data-creator-drafts></div></section>
    <section class="creator-section creator-notifications" aria-labelledby="creator-notifications-title" hidden><div class="creator-heading"><h2 id="creator-notifications-title">{c.notifications}</h2><span data-notification-count></span></div><div data-creator-notifications><p>{c.loading}</p></div></section>
    <section class="creator-section creator-records-section" aria-labelledby="creator-records-title" hidden><div class="creator-heading"><h2 id="creator-records-title">{c.records}</h2><button type="button" data-creator-refresh>{c.retry}</button></div>
      <form data-creator-filters class="creator-filters" role="search"><label>{c.search}<input name="q" type="search" autocomplete="off"/></label><label>{c.type}<select name="type"><option value="">{c.all}</option>{(['entry','article','gallery'] as const).map(key=><option value={key}>{c[key]}</option>)}</select></label><label>{c.state}<select name="state"><option value="">{c.all}</option>{(['attention','review','published','draft'] as const).map(key=><option value={key}>{c[key]}</option>)}</select></label></form>
      <div class="creator-table-wrap"><table class="creator-table"><thead><tr><th>{c.records}</th><th>{c.type}</th><th>{c.state}</th><th>{c.updated}</th><th>{c.action}</th></tr></thead><tbody data-creator-rows></tbody></table></div>
      <div class="creator-pagination"><span data-records-status role="status"></span><div><button type="button" data-page-previous>{c.previous}</button><button type="button" data-page-next>{c.next}</button></div></div>
    </section>
  </div><aside class="creator-detail" data-creator-detail hidden role="dialog" aria-labelledby="creator-detail-title"><div class="creator-detail-head"><span>{c.records}</span><button type="button" data-detail-close>{c.close}</button></div><div data-detail-content></div></aside></div></div>
  <div class="creator-detail-backdrop" data-detail-backdrop hidden></div>
</WorkspaceLayout>
<script>import '../../../scripts/creatorCenter.js';</script>
