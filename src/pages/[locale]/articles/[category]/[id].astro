---
import legacyArticles from '../../../../data/article-legacy.json';
import {entityLocales} from '../../../../lib/entityRegistry.mjs';
export function getStaticPaths(){return entityLocales.flatMap(locale=>legacyArticles.filter(e=>e.locale==='zh').map(e=>({params:{locale,category:e.articleCategory,id:e.id},props:{entityId:e.id}})));}
return Astro.redirect(`/${Astro.params.locale}/articles/read/?id=${encodeURIComponent(Astro.props.entityId)}`,301);
---
