import {getEntityRegistry,entityLocales} from '../../../../lib/entityRegistry.mjs';
export async function getStaticPaths(){const r=await getEntityRegistry();return entityLocales.flatMap(locale=>r.list(locale).filter(e=>e.data.entityType==='editorial-article').map(e=>({params:{locale,category:e.data.articleCategory,id:e.data.id},props:{entityId:e.data.id}})));}
return Astro.redirect(`/${Astro.params.locale}/articles/read/?id=${encodeURIComponent(Astro.props.entityId)}`,301);
