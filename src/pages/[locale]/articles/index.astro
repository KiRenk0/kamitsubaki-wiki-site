---
import {articleCopy} from '../../../lib/articleCopy.mjs';
import WorkspaceLayout from '../../../layouts/WorkspaceLayout.astro';
import WorkspaceFilters from '../../../components/WorkspaceFilters.astro';
import WorkspaceButton from '../../../components/WorkspaceButton.astro';
import {entityLocales} from '../../../lib/entityRegistry.mjs';
import '../../../styles/articleWorkspace.css';
export function getStaticPaths(){return entityLocales.map(locale=>({params:{locale}}));}
const locale=Astro.params.locale!;const copy=articleCopy(locale);const api=import.meta.env.PUBLIC_ARTICLE_API_URL||import.meta.env.PUBLIC_GALLERY_API_URL||'https://api.kamitsubaki.wiki';
---
<WorkspaceLayout locale={locale} title={copy.title} intro={copy.intro} path="/articles/" eyebrow="ARTICLES" width="wide" backHref={`/${locale}/`} backLabel={locale==='en'?'Home':locale==='ja'?'ホーム':'首页'} mainAttributes={{'data-article-api':api,'data-locale':locale,'data-article-page':'list'}}>
 <WorkspaceButton slot="actions" href={`/${locale}/articles/submit/`} tone="primary">{copy.submit}</WorkspaceButton>
 <WorkspaceFilters role="search"><label><span>{copy.searchLabel}</span><input name="q" type="search"/></label><label><span>{copy.category}</span><select name="category"><option value="">{copy.all}</option>{Object.entries(copy.categories).map(([value,label])=><option value={value}>{label}</option>)}</select></label><label><span>{locale==='en'?'Order':locale==='ja'?'順序':'排序'}</span><select name="sort"><option value="newest">{locale==='en'?'Newest first':locale==='ja'?'新しい順':'最新更新'}</option><option value="oldest">{locale==='en'?'Oldest first':locale==='ja'?'古い順':'最早更新'}</option></select></label><WorkspaceButton type="submit">{copy.search}</WorkspaceButton><WorkspaceButton type="reset" tone="quiet">{copy.clear}</WorkspaceButton></WorkspaceFilters>
 <p role="status" data-article-status>{copy.loading}</p><div class="article-list-grid" data-article-grid></div><div class="article-pagination"><WorkspaceButton data-article-previous hidden>{locale==='en'?'Previous page':locale==='ja'?'前のページ':'上一页'}</WorkspaceButton><WorkspaceButton data-article-more hidden>{locale==='en'?'Next page':locale==='ja'?'次のページ':'下一页'}</WorkspaceButton></div>
</WorkspaceLayout>
<script>import {initArticleBrowser} from '../../../lib/articleClient';initArticleBrowser(document.querySelector<HTMLElement>('[data-article-page]')!);</script>
