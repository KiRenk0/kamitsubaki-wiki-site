---
import {articleCopy} from '../../../lib/articleCopy.mjs';
import 'katex/dist/katex.min.css';
import BaseLayout from '../../../layouts/BaseLayout.astro';import SiteNav from '../../../components/SiteNav.astro';import SiteFooter from '../../../components/SiteFooter.astro';import Reader from '../../../components/Reader.astro';import SharePopover from '../../../components/SharePopover.astro';
import {getCollection} from 'astro:content';import {getLocalizedSite} from '../../../lib/homeData.mjs';import {buildLocaleLinks} from '../../../lib/i18n.mjs';import {entityLocales} from '../../../lib/entityRegistry.mjs';import '../../../styles/articleWorkspace.css';
export function getStaticPaths(){return entityLocales.map(locale=>({params:{locale}}));}
const locale=Astro.params.locale!,site=getLocalizedSite(await getCollection('site'),locale),api=import.meta.env.PUBLIC_ARTICLE_API_URL||import.meta.env.PUBLIC_GALLERY_API_URL||'https://api.kamitsubaki.wiki';
const copy=articleCopy(locale);
---
<BaseLayout title={`${copy.title} · Kamitsubaki Wiki`} lang={locale} reading>
<SiteNav navItems={site.navItems} localeLinks={buildLocaleLinks(site,locale,'/articles/')} brandLines={site.hero.brandLines} homeHref={`/${locale}/`}/>
<main class="article-reader" data-article-page="read" data-article-api={api} data-locale={locale}>
 <header class="article-reader-header reader-frame"><a href={`/${locale}/articles/`}>← {copy.title}</a><div class="article-reader-title-row"><h1 data-article-title>{copy.loading}</h1><div class="article-reader-actions"><SharePopover locale={locale} deferred /><a data-article-edit hidden>{copy.edit}</a><a data-article-contribute href={`/${locale}/articles/submit/`}>{locale==='en'?'Write an article':locale==='ja'?'記事を投稿':'投稿文章'} ↗</a></div></div><p data-article-meta></p><p data-article-summary></p><section data-article-related-panel hidden><h2>{copy.related}</h2><div data-article-related class="article-related-links"></div></section><p role="status" data-article-status></p></header>
 <Reader headings={[]} contentsTitle={copy.toc} variant="entry"><article class="wiki-reader wiki-prose prose max-w-none" data-article-body></article><Fragment slot="sidebar"><details class="article-toc" data-article-toc-panel hidden><summary>{copy.toc}</summary><nav aria-label={copy.toc} data-article-toc></nav></details></Fragment></Reader>
</main><SiteFooter footer={site.footer}/></BaseLayout>
<script>import {initArticleBrowser} from '../../../lib/articleClient';initArticleBrowser(document.querySelector<HTMLElement>('[data-article-page]')!);</script>
