---
import WorkspaceShell from '../../components/WorkspaceShell.astro';
import WorkspaceHeader from '../../components/WorkspaceHeader.astro';
import {accountWorkspaceCopy} from '../../lib/accountWorkspaceCopy.mjs';
import AppearanceControls from '../../components/AppearanceControls.astro';
import AccountSections from '../../components/AccountSections.astro';
import {getBuildCollection as getCollection} from '../../lib/contentAuditContext';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import LibraryPanel from '../../components/labs/LibraryPanel.astro';
import {getLocalizedSite} from '../../lib/homeData.mjs';
import {buildLocaleLinks,supportedLocales} from '../../lib/i18n.mjs';
import {editorEnabled} from '../../lib/editorConfig.mjs';
import {accountCopy} from '../../lib/accountCopy.mjs';
import {labsCopy} from '../../lib/labsCopy.mjs';
import '../../styles/account.css';
import '../../styles/labs.css';
export function getStaticPaths(){return supportedLocales.map(locale=>({params:{locale}}));}
const locale=Astro.params.locale||'zh', c=accountCopy(locale), site=getLocalizedSite(await getCollection('site'),locale);
const ui=accountWorkspaceCopy(locale);
const libraryCopy={...labsCopy(locale),savedLocal:c.library,storageNote:c.privacy};
---
<BaseLayout lang={locale} title={`${c.title} · KAMITSUBAKI Wiki`} metadata={{noindex:true}}>
  <SiteNav navItems={site.navItems} localeLinks={buildLocaleLinks(site,locale,'/account/')} brandLines={site.hero.brandLines} homeHref={`/${locale}/`}/>
  <WorkspaceShell width="wide" class="account-shell" data-account-page data-summary-error={ui.summaryError}>
    <WorkspaceHeader title={c.title} intro={ui.intro} eyebrow="MY OBSERVATORY" backHref={`/${locale}/`} backLabel={locale==='en'?'Home':locale==='ja'?'ホーム':'首页'}><button class="account-button" data-account-logout hidden>{c.logout}</button><Fragment slot="status"><p data-account-action-status role="status"></p><button class="account-button" data-account-reload hidden>{c.reloadAccount}</button></Fragment></WorkspaceHeader>
    <noscript>{c.javascript}</noscript>
    <div class="account-workspace"><AccountSections locale={locale}/><div class="account-panels">
    <section data-account-panel="overview" class="account-section account-overview">
      <header class="account-home-header"><div><p class="account-kicker">YOUR DESK / 01</p><h2>{ui.welcome}</h2><p class="account-overview-identity" data-account-identity></p><p class="account-note">{ui.welcomeNote}</p></div><div class="account-home-header-actions"><a class="account-overview-primary" href={`/${locale}/contribute/`}>{ui.newSubmission}<span aria-hidden="true">↗</span></a><a class="account-overview-secondary" href={`/${locale}/account/creator/`}>{ui.openCreator}<span aria-hidden="true">→</span></a></div></header>
      <section class="account-overview-guest" data-account-overview-guest data-checking-title={ui.checkingTitle} data-checking-note={ui.checkingNote} data-unavailable-title={ui.unavailableTitle} data-unavailable-note={ui.unavailableNote} data-guest-eyebrow={ui.guestEyebrow} data-guest-title={ui.guestTitle} data-guest-note={ui.guestNote}><div><span class="account-kicker" data-guest-eyebrow>{ui.guestEyebrow}</span><h3 data-guest-title>{ui.guestTitle}</h3><p data-guest-note>{ui.guestNote}</p></div><div class="account-guest-actions"><button type="button" class="account-button account-primary" data-account-login>{ui.guestAction} →</button><button type="button" class="account-button" data-account-retry hidden>{ui.retry}</button></div></section>
      <div class="account-home-grid">
        <section class="account-home-work"><span class="account-kicker">01 / {ui.workArea}</span><h3>{ui.creator}</h3><p>{ui.writeNote}</p>
          <div class="account-overview-progress" data-account-overview-progress hidden>
            <a href={`/${locale}/account/creator/?state=attention`}><span>{ui.attention}</span><strong data-account-summary="attention">—</strong></a>
            <a href={`/${locale}/account/creator/?state=draft`}><span>{ui.draft}</span><strong data-account-summary="draft">—</strong></a>
            <a href={`/${locale}/account/creator/?state=review`}><span>{ui.review}</span><strong data-account-summary="review">—</strong></a>
          </div>
          <p class="account-overview-summary-status" data-account-overview-summary-status role="status"></p>
          <div class="account-home-actions"><a href={`/${locale}/account/creator/`}>{ui.openCreator}<span aria-hidden="true">→</span></a></div>
        </section>
        <section class="account-home-library"><span class="account-kicker">02 / {ui.saved}</span><h3>{c.library}</h3><p>{ui.savedNote}</p><div data-account-recent data-empty-label={ui.empty}><p>{ui.empty}</p></div><a class="account-home-library-link" href="#library">{ui.open}<span aria-hidden="true">→</span></a></section>
      </div>
      <section class="account-home-settings"><div><span class="account-kicker">03 / ACCOUNT</span><h3>{ui.settingsArea}</h3><p>{ui.settingsNote}</p></div><nav aria-label={ui.settingsArea}><a href="#profile">{c.profile}<span aria-hidden="true">→</span></a><a href="#security">{ui.security}<span aria-hidden="true">→</span></a><a href="#appearance">{ui.appearance}<span aria-hidden="true">→</span></a></nav></section>
    </section>
    <section data-account-panel="appearance" class="account-section account-surface" hidden><header class="account-panel-heading"><span class="account-kicker">04 / APPEARANCE</span><h2>{ui.appearance}</h2><p>{ui.settingsNote}</p></header><AppearanceControls locale={locale}/></section>
    <section class="account-gate account-surface" data-account-gate hidden><header class="account-panel-heading"><span class="account-kicker">ACCOUNT / ACCESS</span><h2 data-account-gate-title>{c.loginTitle}</h2><p>{c.loginNote}</p></header><button class="account-button account-primary" data-account-login>{c.login}</button></section>
    <section data-account-panel="library" class="account-section account-surface account-library-panel" hidden><header class="account-panel-heading"><span class="account-kicker">02 / LIBRARY</span><h2>{c.library}</h2><p>{ui.savedNote}</p></header><p class="account-note">{c.privacy}</p><div data-account-library data-copy={JSON.stringify(libraryCopy)}><LibraryPanel copy={libraryCopy} locale={locale}/></div></section>
    <section class="account-section" data-account-panel="library" data-account-member hidden><details><summary>{c.importTitle}</summary><p>{c.importNote}</p><button class="account-button" data-guest-preview>{c.preview}</button><div data-guest-preview-result hidden><p data-guest-count></p><ul class="account-import-items" data-guest-items></ul><div class="account-actions"><button class="account-button" data-guest-merge>{c.merge}</button><button class="account-button" data-guest-cancel>{c.importCancel}</button></div></div></details></section>
    <section data-account-panel="profile" class="account-section account-surface" data-account-member hidden><header class="account-panel-heading"><span class="account-kicker">03 / PROFILE</span><h2>{c.profile}</h2><p>{ui.profileNote}</p></header><form data-profile-form class="account-form"><label>{c.name}<input name="displayName" maxlength="60" required autocomplete="nickname"/></label><label>{c.language}<select name="locale">{supportedLocales.map(l=><option value={l}>{({'zh':'简体中文','zh-tw':'繁體中文（台灣）','zh-hk':'繁體中文（香港）','ja':'日本語','en':'English'})[l]}</option>)}</select></label><label>{c.avatar}<select name="avatar"><option value="upload">{c.uploadAvatar}</option><option value="keep">{c.keepAvatar}</option><option value="initial">{c.initialAvatar}</option>{[1,2,3,4,5].map(n=><option value={`preset-${n}`}>{c.preset} {n}</option>)}</select></label><label class="account-upload">{c.uploadAvatar}<input data-avatar-file type="file" accept="image/jpeg,image/png,image/webp"/><small>{c.uploadNote}</small></label><div class="account-avatar-preview" data-avatar-preview aria-hidden="true"></div><button class="account-button account-primary" type="submit">{c.save}</button><p data-profile-status role="status"></p></form></section><section data-account-panel="security" class="account-section account-surface" data-account-member hidden><header class="account-panel-heading"><span class="account-kicker">04 / SECURITY</span><h2>{c.linked}</h2></header><p>{c.identityIntro}</p><p class="account-note">{c.identityBoundary}</p><div data-account-identities class="account-identities"></div><p data-identities-status role="status"></p></section>
    <section data-account-panel="security" class="account-section account-surface" data-account-member hidden><header class="account-panel-heading"><span class="account-kicker">05 / SESSIONS</span><h2>{c.devices}</h2></header><button class="account-button" data-sessions-load>{c.retry}</button><ul data-account-sessions class="account-session-list"></ul><button class="account-button" data-sessions-revoke-others>{c.revokeOthers}</button><p data-sessions-status role="status"></p></section>
    <section data-account-panel="security" class="account-section account-surface" data-account-member hidden><header class="account-panel-heading"><span class="account-kicker">06 / DATA</span><h2>{c.data}</h2></header><p>{c.exportNote}</p><div class="account-actions"><button class="account-button" data-account-export>{c.export}</button><button class="account-button" data-ai-export>{c.exportAI}</button></div><details class="account-delete"><summary>{c.requestDelete}</summary><p>{c.deleteNote}</p><form data-deletion-form><label>{c.deleteConfirm}<input name="confirmation" required pattern="DELETE" autocomplete="off"/></label><button class="account-button" type="submit">{c.requestDelete}</button></form></details><p data-deletion-status role="status"></p><button class="account-button" data-deletion-cancel hidden>{c.cancelDelete}</button><p data-data-status role="status"></p></section>
    </div></div>
  </WorkspaceShell>
  <SiteFooter footer={site.footer}/>
</BaseLayout>
<script>
import '../../scripts/accountNavigation.js';
import '../../scripts/accountContributionBadge.js';
import '../../scripts/accountOverview.js';
import {initializeAccountPage} from '../../scripts/accountPage.js';
const start=()=>{try{initializeAccountPage();window.dispatchEvent(new Event('kamitsubaki-account-state'));}catch(error){console.error('Account workspace initialization failed',error);const status=document.querySelector('[data-account-action-status]');if(status)status.textContent='账号工作台未能载入，请刷新重试。';}};
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start,{once:true});else start();
</script>
