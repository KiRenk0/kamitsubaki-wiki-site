---
import WorkspaceShell from '../../components/WorkspaceShell.astro';
import WorkspaceHeader from '../../components/WorkspaceHeader.astro';
import {accountWorkspaceCopy} from '../../lib/accountWorkspaceCopy.mjs';
import AppearanceControls from '../../components/AppearanceControls.astro';
import {getCollection} from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import LibraryPanel from '../../components/labs/LibraryPanel.astro';
import {getLocalizedSite} from '../../lib/homeData.mjs';
import {buildLocaleLinks,supportedLocales} from '../../lib/i18n.mjs';
import {editorEnabled} from '../../lib/editorConfig.mjs';
import {accountCopy} from '../../lib/accountCopy.mjs';
import {labsCopy} from '../../lib/labsCopy.mjs';
import '../../styles/account.css';
import '../../styles/labs.css';
export function getStaticPaths(){return supportedLocales.map(locale=>({params:{locale}}));}
const locale=Astro.params.locale||'zh', c=accountCopy(locale), site=getLocalizedSite(await getCollection('site'),locale);
const ui=accountWorkspaceCopy(locale);
const libraryCopy={...labsCopy(locale),savedLocal:c.library,storageNote:c.privacy};
---
<BaseLayout lang={locale} title={`${c.title} · KAMITSUBAKI Wiki`} metadata={{noindex:true}}>
  <SiteNav navItems={site.navItems} localeLinks={buildLocaleLinks(site,locale,'/account/')} brandLines={site.hero.brandLines} homeHref={`/${locale}/`}/>
  <WorkspaceShell width="standard" class="account-shell" data-account-page>
    <WorkspaceHeader title={c.title} intro={ui.intro} eyebrow="MY OBSERVATORY" backHref={`/${locale}/`} backLabel={locale==='en'?'Home':locale==='ja'?'ホーム':'首页'}><button class="account-button" data-account-logout hidden>{c.logout}</button><Fragment slot="status"><p data-account-action-status role="status"></p><button class="account-button" data-account-reload hidden>{c.reloadAccount}</button></Fragment></WorkspaceHeader>
    <noscript>{c.javascript}</noscript>
    <div class="account-workspace"><nav class="account-sections" aria-label={c.title}>
      <a href="#overview" data-account-label={ui.overview} aria-current="location"><span aria-hidden="true">01</span>{ui.overview}</a>
      <a href={`/${locale}/account/creator/`}><span aria-hidden="true">02</span>{ui.creator}<small aria-hidden="true">↗</small></a>
      <a href="#library" data-account-label={c.library}><span aria-hidden="true">03</span>{c.library}</a>
      <a href="#profile" data-account-label={c.profile}><span aria-hidden="true">04</span>{c.profile}</a>
      <a href="#security" data-account-label={ui.security}><span aria-hidden="true">05</span>{ui.security}</a>
      <a href="#appearance" data-account-label={ui.appearance}><span aria-hidden="true">06</span>{ui.appearance}</a>
    </nav><div class="account-panels">
    <section id="overview" data-account-panel="overview" class="account-section account-overview">
      <p class="account-kicker">YOUR WORKSPACE</p><h2>{ui.welcome}</h2><p class="account-note">{ui.welcomeNote}</p>
      <a class="account-continue" href={`/${locale}/account/creator/`}><span><strong>{ui.write}</strong><small>{ui.writeNote}</small></span><span aria-hidden="true">↗</span></a>
      <div class="account-overview-heading"><h3>{ui.saved}</h3><a href="#library">{ui.open} →</a></div>
      <div data-account-recent data-empty-label={ui.empty}><p>{ui.empty}</p></div>
    </section>
    <section id="appearance" data-account-panel="appearance" class="account-section" hidden><h2>{ui.appearance}</h2><AppearanceControls locale={locale}/></section>
    <section class="account-gate" data-account-gate hidden><h2 data-account-gate-title>{c.loginTitle}</h2><p>{c.loginNote}</p><button class="account-button account-primary" data-account-login>{c.login}</button></section>
    <section id="library" data-account-panel="library" class="account-section" hidden><h2>{c.library}</h2><p class="account-note">{c.privacy}</p><div data-account-library data-copy={JSON.stringify(libraryCopy)}><LibraryPanel copy={libraryCopy} locale={locale}/></div></section>
    <section class="account-section" data-account-panel="library" data-account-member hidden><details><summary>{c.importTitle}</summary><p>{c.importNote}</p><button class="account-button" data-guest-preview>{c.preview}</button><div data-guest-preview-result hidden><p data-guest-count></p><ul class="account-import-items" data-guest-items></ul><div class="account-actions"><button class="account-button" data-guest-merge>{c.merge}</button><button class="account-button" data-guest-cancel>{c.importCancel}</button></div></div></details></section>
    <section id="profile" data-account-panel="profile" class="account-section" data-account-member hidden><h2>{c.profile}</h2><form data-profile-form class="account-form"><label>{c.name}<input name="displayName" maxlength="60" required autocomplete="nickname"/></label><label>{c.language}<select name="locale">{supportedLocales.map(l=><option value={l}>{({'zh':'简体中文','zh-tw':'繁體中文（台灣）','zh-hk':'繁體中文（香港）','ja':'日本語','en':'English'})[l]}</option>)}</select></label><label>{c.avatar}<select name="avatar"><option value="upload">{c.uploadAvatar}</option><option value="keep">{c.keepAvatar}</option><option value="initial">{c.initialAvatar}</option>{[1,2,3,4,5].map(n=><option value={`preset-${n}`}>{c.preset} {n}</option>)}</select></label><label class="account-upload">{c.uploadAvatar}<input data-avatar-file type="file" accept="image/jpeg,image/png,image/webp"/><small>{c.uploadNote}</small></label><div class="account-avatar-preview" data-avatar-preview aria-hidden="true"></div><button class="account-button account-primary" type="submit">{c.save}</button><p data-profile-status role="status"></p></form></section><section id="security" data-account-panel="security" class="account-section" data-account-member hidden><h2>{c.linked}</h2><p>{c.identityIntro}</p><p class="account-note">{c.identityBoundary}</p><div data-account-identities class="account-identities"></div><p data-identities-status role="status"></p></section>
    <section id="devices" data-account-panel="security" class="account-section" data-account-member hidden><h2>{c.devices}</h2><button class="account-button" data-sessions-load>{c.retry}</button><ul data-account-sessions class="account-session-list"></ul><button class="account-button" data-sessions-revoke-others>{c.revokeOthers}</button><p data-sessions-status role="status"></p></section>
    <section id="data" data-account-panel="security" class="account-section" data-account-member hidden><h2>{c.data}</h2><p>{c.exportNote}</p><div class="account-actions"><button class="account-button" data-account-export>{c.export}</button><button class="account-button" data-ai-export>{c.exportAI}</button></div><details class="account-delete"><summary>{c.requestDelete}</summary><p>{c.deleteNote}</p><form data-deletion-form><label>{c.deleteConfirm}<input name="confirmation" required pattern="DELETE" autocomplete="off"/></label><button class="account-button" type="submit">{c.requestDelete}</button></form></details><p data-deletion-status role="status"></p><button class="account-button" data-deletion-cancel hidden>{c.cancelDelete}</button><p data-data-status role="status"></p></section>
    </div></div>
  </WorkspaceShell>
  <SiteFooter footer={site.footer}/>
</BaseLayout>
<script>
import '../../scripts/accountNavigation.js';
const start=()=>{void import('../../scripts/accountPage.js').then(module=>{module.initializeAccountPage();window.dispatchEvent(new Event('kamitsubaki-account-state'));}).catch(error=>{console.error('Account workspace initialization failed',error);const status=document.querySelector('[data-account-action-status]');if(status)status.textContent='账号工作台未能载入，请刷新重试。';});};
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start,{once:true});else start();
</script>
