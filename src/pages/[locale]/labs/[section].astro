---
import {supportedLocales} from '../../../lib/i18n.mjs';
export function getStaticPaths(){return supportedLocales.flatMap(locale=>['explore','timeline','relations','world'].map(section=>({params:{locale,section}})));}
const {locale,section}=Astro.params;
const destination=section==='explore'?'explore/':section==='timeline'?'chronicle/?view=list':`explore/${section}/`;
return Astro.redirect(`/${locale}/${destination}`,301);
---
