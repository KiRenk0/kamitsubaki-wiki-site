---
import WorkspaceLayout from '../../../layouts/WorkspaceLayout.astro';
import WorkspaceLinkCard from '../../../components/WorkspaceLinkCard.astro';
import WorkspaceButton from '../../../components/WorkspaceButton.astro';
import {supportedLocales,resolveLocaleCopy} from '../../../lib/i18n.mjs';
export function getStaticPaths(){return supportedLocales.map(locale=>({params:{locale}}));}
const {locale='zh'}=Astro.params;
const copy=resolveLocaleCopy({zh:{title:'参与共建',intro:'从一处补充开始。选择任务，保存草稿，提交审核。',home:'首页',docs:'贡献指南',tasks:['编辑词条','投稿文章','上传设定图'],notes:['补充资料、修正信息，保留来源。','记录观点与研究，可关联多个词条。','选择角色与图片，其他资料可以稍后完善。'],progress:'我的投稿',load:'查看投稿进度',loading:'正在载入…',empty:'暂无投稿记录',error:'暂时无法载入，请重试。',login:'登录后查看',open:'查看与继续',states:{draft:'草稿',pending:'待审核',approved:'已通过',rejected:'已退回',merged:'已合并',open:'审核中',closed:'已关闭',failed:'提交失败'}},en:{title:'Contribute',intro:'Start with one improvement. Choose a task, save a draft, submit for review.',home:'Home',docs:'Contribution guide',tasks:['Edit an entry','Write an article','Upload reference art'],notes:['Improve information and preserve sources.','Share research and link relevant entries.','Choose a character and image; add details later.'],progress:'My submissions',load:'View submission progress',loading:'Loading…',empty:'No submissions yet',error:'Unable to load. Please retry.',login:'Sign in to view',open:'View and continue',states:{draft:'Draft',pending:'Pending',approved:'Approved',rejected:'Returned',merged:'Merged',open:'In review',closed:'Closed',failed:'Failed'}},ja:{title:'貢献する',intro:'一つの改善から。作業を選び、下書きを保存して審査へ。',home:'ホーム',docs:'投稿ガイド',tasks:['項目を編集','記事を投稿','設定画を投稿'],notes:['情報を補い、出典を残す。','考察を共有し、関連項目を選ぶ。','キャラクターと画像を選択。補足は後から。'],progress:'自分の投稿',load:'投稿状況を確認',loading:'読み込み中…',empty:'投稿はまだありません',error:'読み込めません。再試行してください。',login:'ログインして確認',open:'確認・編集',states:{draft:'下書き',pending:'審査待ち',approved:'承認済み',rejected:'差し戻し',merged:'反映済み',open:'審査中',closed:'終了',failed:'失敗'}}},locale);
const paths=['contribute/editor/','articles/submit/','gallery/manage/'];
const api=import.meta.env.PUBLIC_ARTICLE_API_URL||import.meta.env.PUBLIC_GALLERY_API_URL||'https://api.kamitsubaki.wiki';
---
<WorkspaceLayout locale={locale} title={copy.title} intro={copy.intro} path="/contribute/" eyebrow="CONTRIBUTE" backHref={`/${locale}/`} backLabel={copy.home} mainAttributes={{'data-contribution-dashboard':'','data-api':api,'data-gallery-api':import.meta.env.PUBLIC_GALLERY_API_URL||api,'data-editor-api':import.meta.env.PUBLIC_EDITOR_API_BASE||api,'data-locale':locale,'data-copy':JSON.stringify(copy)}}>
 <WorkspaceButton slot="actions" href={`/${locale}/docs/contributing/`}>{copy.docs}</WorkspaceButton>
 <section>{paths.map((path,i)=><WorkspaceLinkCard href={`/${locale}/${path}`} title={copy.tasks[i]} description={copy.notes[i]} index={String(i+1).padStart(2,'0')}/>)}</section>
 <section class="contribution-progress"><h2>{copy.progress}</h2><WorkspaceButton data-progress-load>{copy.load}</WorkspaceButton><div data-progress-results aria-live="polite"></div></section>
</WorkspaceLayout>
<script>import '../../../scripts/contributionDashboard.js';</script>
<style>.contribution-progress{margin-top:40px;border-top:1px solid rgb(var(--theme-fg-rgb)/.15);padding-top:24px}.contribution-progress h2{font:22px var(--font-serif);margin-bottom:18px}.contribution-progress :global(article){padding:18px 0;border-bottom:1px solid rgb(var(--theme-fg-rgb)/.12)}.contribution-progress :global(p){font-size:13px;line-height:1.8;opacity:.7}.contribution-progress :global(a){font-size:12px;text-decoration:underline;text-underline-offset:4px}</style>
