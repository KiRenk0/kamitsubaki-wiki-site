---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteNav from '../../../components/SiteNav.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import WorkspaceShell from '../../../components/WorkspaceShell.astro';
import WorkspaceHeader from '../../../components/WorkspaceHeader.astro';
import {buildLocaleLinks,supportedLocales} from '../../../lib/i18n.mjs';
import {getLocalizedSite} from '../../../lib/homeData.mjs';
import {getCollection} from 'astro:content';
import {docsCenterCopy} from '../../../lib/docsCenter.mjs';
export function getStaticPaths(){return supportedLocales.map(locale=>({params:{locale}}));}
const {locale='zh'}=Astro.params;
const site=getLocalizedSite(await getCollection('site'),locale);
const copy=docsCenterCopy(locale);
---
<BaseLayout lang={locale} title={copy.title} metadata={{title:copy.title,description:copy.intro,canonicalPath:`/${locale}/docs/`,noindex:true}} alternates={supportedLocales.map(code=>({locale:code,href:`/${code}/docs/`}))}>
 <SiteNav navItems={site.navItems} localeLinks={buildLocaleLinks(site,locale,'/docs/')} brandLines={site.hero.brandLines} homeHref={`/${locale}/`}/>
 <WorkspaceShell width="wide" class="docs-center">
  <WorkspaceHeader title={copy.title} intro={copy.intro} eyebrow={copy.eyebrow} backHref={`/${locale}/`} backLabel={copy.home}/>
  <section class="docs-pause" aria-labelledby="docs-pause-title">
   <span aria-hidden="true">00 / DOCS</span>
   <h2 id="docs-pause-title">{copy.notice}</h2>
   <p>{copy.detail}</p>
   <a href={`/${locale}/contribute/`}>{copy.contribute} <span aria-hidden="true">↗</span></a>
  </section>
 </WorkspaceShell>
 <SiteFooter footer={site.footer}/>
</BaseLayout>
<style>
.docs-pause{min-height:220px;margin-top:32px;border-top:1px solid var(--ui-line);padding:26px 0 52px}
.docs-pause>span{font:11px var(--font-mono);letter-spacing:.14em;color:var(--workspace-muted)}
.docs-pause h2{margin:20px 0 8px;font:400 clamp(22px,3vw,30px)/1.35 var(--font-serif)}
.docs-pause p{margin:0;color:var(--workspace-muted);font:13px/1.8 var(--font-sans)}
.docs-pause a{display:inline-flex;align-items:center;gap:8px;margin-top:24px;border-bottom:1px solid currentColor;padding-bottom:4px;font:12px var(--font-sans);text-decoration:none}
.docs-pause a:focus-visible{outline:2px solid var(--theme-fg);outline-offset:4px}
</style>
