---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteNav from '../../../components/SiteNav.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import WorkspaceShell from '../../../components/WorkspaceShell.astro';
import WorkspaceHeader from '../../../components/WorkspaceHeader.astro';
import WorkspaceNavigation from '../../../components/WorkspaceNavigation.astro';
import {buildLocaleLinks,supportedLocales} from '../../../lib/i18n.mjs';
import {getLocalizedSite} from '../../../lib/homeData.mjs';
import {getCollection} from 'astro:content';
import {docsCatalog,docsCategories,docsCenterCopy,localizeDoc} from '../../../lib/docsCenter.mjs';
import '../../../styles/docsCenter.css';
export function getStaticPaths(){return supportedLocales.map(locale=>({params:{locale}}));}
const {locale='zh'}=Astro.params;
const site=getLocalizedSite(await getCollection('site'),locale);
const copy=docsCenterCopy(locale);
---
<BaseLayout lang={locale} title={copy.title} metadata={{title:copy.title,description:copy.intro,canonicalPath:`/${locale}/docs/`}} alternates={supportedLocales.map(code=>({locale:code,href:`/${code}/docs/`}))}>
 <SiteNav navItems={site.navItems} localeLinks={buildLocaleLinks(site,locale,'/docs/')} brandLines={site.hero.brandLines} homeHref={`/${locale}/`}/>
 <WorkspaceShell width="wide" class="docs-center" data-docs-center>
  <WorkspaceHeader title={copy.title} intro={copy.intro} eyebrow={copy.eyebrow} backHref={`/${locale}/`} backLabel={copy.home}>
   <a href={`/${locale}/contribute/`}>{copy.contribute} <span aria-hidden="true">↗</span></a>
  </WorkspaceHeader>
  <div class="docs-tools">
   <label><span>{copy.search}</span><input type="search" placeholder={copy.searchHint} autocomplete="off" data-docs-search/></label>
   <p><strong>{String(docsCatalog.length).padStart(2,'0')}</strong> DOCUMENTS</p>
  </div>
  <WorkspaceNavigation label={copy.title} kind="hub">
   <a href="#all" aria-current="page" data-docs-filter="all">{copy.all}</a>
   {docsCategories.map(category=><a href={`#${category.id}`} data-docs-filter={category.id}>{localizeDoc(category.label,locale)}</a>)}
  </WorkspaceNavigation>
  <div class="docs-sections" data-docs-sections data-empty-label={copy.empty}>
   {docsCategories.map(category=><section class="workspace-section docs-section" id={category.id} data-docs-category={category.id}>
    <header class="workspace-section-heading"><h2><span>{category.number}.</span> {localizeDoc(category.label,locale)}</h2><p>{docsCatalog.filter(doc=>doc.category===category.id).length} DOCS</p></header>
    <div class="docs-grid">
     {docsCatalog.filter(doc=>doc.category===category.id).map((doc,index)=><a class="docs-card" href={`/${locale}/docs/${doc.slug}/`} data-docs-card data-search={`${localizeDoc(doc.title,locale)} ${localizeDoc(doc.summary,locale)} ${doc.keywords}`}>
      <span class="docs-card-index">{category.number}.{String(index+1).padStart(2,'0')}</span>
      <div><h3>{localizeDoc(doc.title,locale)}</h3><p>{localizeDoc(doc.summary,locale)}</p></div>
      <footer><span>{doc.status==='current'?copy.current:copy.guide}</span><span>{doc.language==='localized'?(locale.startsWith('zh')?'中文':locale.toUpperCase()):'中文'}</span><b aria-hidden="true">↗</b></footer>
     </a>)}
    </div>
   </section>)}
   <p class="docs-empty" hidden data-docs-empty>{copy.empty}</p>
  </div>
 </WorkspaceShell>
 <SiteFooter footer={site.footer}/>
 <script>
  // @ts-nocheck -- DOM nodes are constrained by this page's static template.
  const root=document.querySelector('[data-docs-center]');
  if(root){const input=root.querySelector('[data-docs-search]');const filters=[...root.querySelectorAll('[data-docs-filter]')];const cards=[...root.querySelectorAll('[data-docs-card]')];const sections=[...root.querySelectorAll('[data-docs-category]')];const empty=root.querySelector('[data-docs-empty]');let category='all';const update=()=>{const query=input.value.trim().toLocaleLowerCase();let visible=0;cards.forEach(card=>{const match=(category==='all'||card.closest('[data-docs-category]')?.dataset.docsCategory===category)&&(!query||card.dataset.search.toLocaleLowerCase().includes(query));card.hidden=!match;if(match)visible+=1});sections.forEach(section=>section.hidden=![...section.querySelectorAll('[data-docs-card]')].some(card=>!card.hidden));empty.hidden=visible!==0};filters.forEach(filter=>filter.addEventListener('click',event=>{event.preventDefault();category=filter.dataset.docsFilter;filters.forEach(item=>item.toggleAttribute('aria-current',item===filter));update()}));input.addEventListener('input',update)}
 </script>
</BaseLayout>
