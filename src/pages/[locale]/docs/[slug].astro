---
import {supportedLocales} from '../../../lib/i18n.mjs';
import {retiredDocSlugs,retiredDocTargets} from '../../../lib/docsCenter.mjs';
export function getStaticPaths(){return supportedLocales.flatMap(locale=>retiredDocSlugs.map(slug=>({params:{locale,slug}})));}
const {locale='zh',slug=''}=Astro.params;
return Astro.redirect(`/${locale}/docs/${retiredDocTargets[slug]}/`,301);
---
