---
import {supportedLocales} from '../../../lib/i18n.mjs';
import {retiredDocSlugs} from '../../../lib/docsCenter.mjs';
export function getStaticPaths(){return supportedLocales.flatMap(locale=>retiredDocSlugs.map(slug=>({params:{locale,slug}})));}
return Astro.redirect(`/${Astro.params.locale || 'zh'}/docs/`,302);
---
