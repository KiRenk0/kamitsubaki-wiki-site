---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkspaceButton from '../../components/WorkspaceButton.astro';
import WorkspaceControl from '../../components/WorkspaceControl.astro';
import {entityLocales} from '../../lib/entityRegistry.mjs';
import {resolveLocaleCopy} from '../../lib/i18n.mjs';
import '../../styles/uiKit.css';
export function getStaticPaths(){return import.meta.env.DEV?entityLocales.map(locale=>({params:{locale}})):[];}
const locale=Astro.params.locale!;
const c=resolveLocaleCopy({zh:{title:'组件对照',note:'展示控件的外观与状态，表单不会提交数据。',old:'现有控件',next:'daisyUI · 网站主题',primary:'主要操作',secondary:'辅助操作',disabled:'不可用',search:'搜索',placeholder:'搜索花譜、歌曲或企划',type:'类型',all:'全部',person:'人物',song:'歌曲',check:'显示更多信息',loading:'正在加载',error:'请填写搜索内容',reset:'重置',database:'打开 Database',light:'浅色',dark:'深色'},ja:{title:'コンポーネント比較',note:'見た目と状態の表示例です。データは送信されません。',old:'既存のコントロール',next:'daisyUI · サイトテーマ',primary:'主操作',secondary:'補助操作',disabled:'無効',search:'検索',placeholder:'花譜・楽曲・プロジェクトを検索',type:'種類',all:'すべて',person:'人物',song:'楽曲',check:'詳細情報を表示',loading:'読み込み中',error:'検索内容を入力してください',reset:'リセット',database:'Database を開く',light:'ライト',dark:'ダーク'},en:{title:'Component comparison',note:'Appearance and state examples. No data is submitted.',old:'Existing controls',next:'daisyUI · Site theme',primary:'Primary action',secondary:'Secondary action',disabled:'Disabled',search:'Search',placeholder:'Search artists, songs or projects',type:'Type',all:'All',person:'People',song:'Songs',check:'Show more information',loading:'Loading',error:'Enter a search term',reset:'Reset',database:'Open Database',light:'Light',dark:'Dark'}},locale);
---
<BaseLayout title={c.title} lang={locale} metadata={{noindex:true}}>
 <main class="ui-preview">
  <header><h1>{c.title}</h1><p>{c.note}</p><nav aria-label={c.title}>{entityLocales.map(lang=><a href={`/${lang}/ui-preview/`} lang={lang} aria-current={lang===locale?'page':undefined}>{lang}</a>)}</nav><div class="preview-actions" role="radiogroup" aria-label={c.title}><button role="radio" type="button" data-theme-toggle data-theme-value="light">{c.light}</button><button role="radio" type="button" data-theme-toggle data-theme-value="dark">{c.dark}</button></div><a href={`/${locale}/database/`}>{c.database} →</a></header>
  <div class="preview-columns">
   {[false,true].map(kit=><section data-ui-kit={kit?'':undefined} class:list={['preview-column',!kit&&'legacy-preview']}>
    <h2>{kit?c.next:c.old}</h2>
    <form data-preview-form>
     <div class="preview-actions">{kit?<><button type="button" class="dui-btn dui-btn-primary">{c.primary}</button><button type="button" class="dui-btn dui-btn-outline">{c.secondary}</button><button type="button" class="dui-btn" disabled>{c.disabled}</button></>:<><button type="button" class="workspace-button" data-tone="primary">{c.primary}</button><button type="button" class="workspace-button">{c.secondary}</button><button type="button" class="workspace-button" disabled>{c.disabled}</button></>}</div>
     <label>{c.search}<input class={kit?'dui-input':undefined} type="search" name="q" placeholder={c.placeholder}/></label>
     <label>{c.type}<select name="type" class={kit?'dui-select':undefined}><option value="">{c.all}</option><option value="person">{c.person}</option><option value="song">{c.song}</option></select></label>
     <label class="preview-check"><input type="checkbox" name="details" class={kit?'dui-checkbox':undefined}/>{c.check}</label>
     <label>{c.disabled}<input class={kit?'dui-input':undefined} disabled value={c.disabled}/></label>
     <label>{c.search}<input class={kit?'dui-input dui-input-error':undefined} aria-invalid="true" aria-describedby={kit?'kit-error':'legacy-error'}/><span class="preview-error" id={kit?'kit-error':'legacy-error'}>{c.error}</span></label>
     <p role="status"><span class={kit?'dui-loading dui-loading-spinner':undefined} aria-hidden="true"></span> {c.loading}</p>
     <button class={kit?'dui-btn dui-btn-ghost':undefined} type="reset">{c.reset}</button>
    </form>
   </section>)}
  </div>
  <section class="preview-column" data-shared-preview>
   <h2>WorkspaceButton / WorkspaceControl</h2>
   <form data-preview-form>
    <div class="preview-actions"><WorkspaceButton tone="primary">{c.primary}</WorkspaceButton><WorkspaceButton>{c.secondary}</WorkspaceButton><WorkspaceButton tone="quiet">{c.reset}</WorkspaceButton><WorkspaceButton disabled href={`/${locale}/database/`}>{c.disabled}</WorkspaceButton></div>
    <label>{c.search}<WorkspaceControl name="q" type="search" placeholder={c.placeholder}/></label>
    <label>{c.type}<WorkspaceControl as="select" name="type"><option value="">{c.all}</option><option value="song">{c.song}</option></WorkspaceControl></label>
    <label>{c.search}<WorkspaceControl as="textarea" name="summary" rows={3}>{c.placeholder}</WorkspaceControl></label>
    <label class="preview-check"><WorkspaceControl type="checkbox" name="details"/>{c.check}</label>
    <label>{c.disabled}<WorkspaceControl disabled value={c.disabled}/></label>
    <label>{c.search}<WorkspaceControl aria-invalid="true" aria-describedby="shared-error"/><span class="preview-error" id="shared-error">{c.error}</span></label>
    <WorkspaceButton type="reset">{c.reset}</WorkspaceButton>
   </form>
  </section>
 </main>
</BaseLayout>
<script>
document.querySelectorAll<HTMLFormElement>('[data-preview-form]').forEach(form=>form.addEventListener('submit',event=>event.preventDefault()));
</script>
<style>
.ui-preview{max-width:1120px;margin:auto;padding:120px 24px 60px;color:var(--theme-fg)}
h1{font:500 30px/1.5 var(--font-sans)}header>p{color:var(--wiki-muted-color)}nav,.preview-actions{display:flex;gap:12px;flex-wrap:wrap;align-items:center;margin:16px 0}nav a[aria-current]{text-decoration:underline}
header .preview-actions>button{min-height:44px;padding:8px 12px;border:1px solid rgb(var(--theme-fg-rgb)/.16);background:none;color:var(--theme-fg)}
.preview-columns{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:32px}.preview-column{min-width:0;border-top:1px solid rgb(var(--theme-fg-rgb)/.16);padding-top:20px}h2{font:500 18px/1.6 var(--font-sans)}
form>label{display:grid;gap:8px;margin:20px 0;font-size:14px}form>.preview-check{display:flex;align-items:center;min-height:44px;gap:12px}.preview-error{color:var(--ui-color-error);font-size:13px}
.legacy-preview input:not([type=checkbox]),.legacy-preview select{width:100%;min-width:0;height:44px;padding:8px 12px;background:var(--theme-bg);color:var(--theme-fg);border:1px solid rgb(var(--theme-fg-rgb)/.16);font:14px/1.5 var(--font-sans)}.legacy-preview input:disabled{opacity:.5}.legacy-preview [aria-invalid]{border-color:var(--ui-color-error)!important}
.legacy-preview .workspace-button{display:inline-flex;align-items:center;min-height:44px;padding:10px 12px;border:1px solid rgb(var(--theme-fg-rgb)/.16);background:none;color:var(--theme-fg)}.legacy-preview .workspace-button[data-tone=primary]{background:var(--theme-fg);color:var(--theme-bg)}.legacy-preview .workspace-button:disabled{opacity:.5}
@media(max-width:760px){.preview-columns{grid-template-columns:1fr}.ui-preview{padding-inline:16px}.legacy-preview input:not([type=checkbox]),.legacy-preview select{font-size:16px}}
</style>
