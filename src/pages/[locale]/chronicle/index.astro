---
import WorkspaceFilters from '../../../components/WorkspaceFilters.astro';
import WorkspaceShell from '../../../components/WorkspaceShell.astro';
import '../../../styles/chronicleTimeline.css';
import {entityLabel} from '../../../lib/entityLabels.mjs';
import WorkspaceHeader from '../../../components/WorkspaceHeader.astro';
import '../../../styles/labsFeatures.css';
import {getCollection} from 'astro:content';import BaseLayout from '../../../layouts/BaseLayout.astro';import SiteNav from '../../../components/SiteNav.astro';import SiteFooter from '../../../components/SiteFooter.astro';import {getLocalizedSite} from '../../../lib/homeData.mjs';import {buildLocaleLinks,resolveLocaleCopy} from '../../../lib/i18n.mjs';import {getEntityRegistry,entityLocales} from '../../../lib/entityRegistry.mjs';import {loadFeatureData,featureText,loadTaxonomy} from '../../../lib/featureData.mjs';import '../../../styles/encyclopedia.css';import '../../../styles/observatoryWorkspaces.css';
export function getStaticPaths(){return entityLocales.map(locale=>({params:{locale}}));}
const locale=Astro.params.locale!;const site=getLocalizedSite(await getCollection('site'),locale);const data=await loadFeatureData();const registry=await getEntityRegistry();const tracks=(await loadTaxonomy('tracks')).values;const types=(await loadTaxonomy('event-types')).values;
const copy=resolveLocaleCopy({zh:{title:'全景纪元时间轴',intro:'四条叙事轨道，记录音乐、企划、同位体与组织的交汇。纪元划分为 Wiki 编辑部分期，并非官方企划期数。',all:'全部',search:'检索事件',year:'年份',entity:'关联实体',type:'事件类型',era:'纪元',solo:'单独查看',empty:'没有符合条件的事件。',tracks:['音乐与现场','企划与世界观','同位体与合成','组织与商业'],eras:['创立期 · 黎明破晓','扩张期 · 武道馆与同位体','跨媒体期 · 虚实深化与决战','新纪元 · 宇宙交汇与基础设施']},ja:{title:'年代記',intro:'音楽・企画・同位体・組織を結ぶ四つの軌跡。時代区分は Wiki 編集部によるもので、公式の企画区分ではありません。',all:'すべて',search:'出来事を検索',year:'年',entity:'関連項目',type:'種類',era:'時代',solo:'この軌道のみ',empty:'該当する出来事はありません。',tracks:['音楽とライブ','企画と世界観','同位体と合成音声','組織と事業'],eras:['創立期','拡張期','クロスメディア期','新時代']},en:{title:'The chronicle',intro:'Four tracks connect music, projects, voice synthesis and organizations. Eras are an editorial periodization, not official project phases.',all:'All',search:'Search events',year:'Year',entity:'Related entity',type:'Event type',era:'Era',solo:'Solo',empty:'No matching events.',tracks:['Music & live','Projects & lore','Isotopes & synthesis','Organizations & business'],eras:['Founding','Expansion','Transmedia','New era']}},locale);
const people=[...new Set(data.events.flatMap(e=>e.related?.map(r=>r.entity)||[]))].map(id=>registry.resolveEntity(id,locale)).filter((e): e is NonNullable<typeof e>=>Boolean(e));
const ui=resolveLocaleCopy({zh:{more:'再显示 12 项事件',fit:'全景',zoom:'时间缩放',position:'移动时间窗口',hint:'横向滚动浏览 · 点击片段查看事件 · 密集事件放大后展开',events:'项事件',select:'选择时间片段，查看事件与来源',sources:'资料来源',previous:'上一事件',next:'下一事件',range:'当前时间窗口',filter:'筛选事件',reset:'清除筛选'},ja:{more:'次の12件を表示',fit:'全体',zoom:'時間の拡大率',position:'表示範囲を移動',hint:'横スクロールで移動・区間を選択して詳細を表示・拡大すると個別の出来事を表示',events:'件',select:'区間を選択して出来事と出典を表示',sources:'出典',previous:'前の出来事',next:'次の出来事',range:'表示期間',filter:'絞り込み',reset:'条件をクリア'},en:{more:'Show 12 more events',fit:'Overview',zoom:'Time scale',position:'Move time window',hint:'Scroll horizontally · Select a clip to inspect · Zoom in to separate dense events',events:'events',select:'Select a clip to inspect events and sources',sources:'Sources',previous:'Previous event',next:'Next event',range:'Visible range',filter:'Filter events',reset:'Clear filters'}},locale);
const events=data.events.map(event=>({...event,...featureText(event.text,locale),links:[...(event.related||[]).map(r=>r.entity),...(event.articles||[])].map(id=>registry.resolveEntity(id,locale)).filter((e): e is NonNullable<typeof e>=>Boolean(e)).map(e=>({label:e.data.name||e.data.title,url:e.url}))}));
---
<BaseLayout title={`${copy.title} · Kamitsubaki Studio Fan Wiki`} lang={locale}>
<SiteNav navItems={site.navItems} localeLinks={buildLocaleLinks(site,locale,'/chronicle/')} brandLines={site.hero.brandLines} homeHref={`/${locale}/`}/>
<WorkspaceShell width="wide" class="wiki-v3 feature-workspace chronicle-editor" data-timeline>
<WorkspaceHeader title={copy.title} intro={copy.intro} eyebrow="LABs / CHRONICLE" backHref={`/${locale}/labs/explore/`} backLabel="LABs"></WorkspaceHeader>

<div class="timeline-era-index" aria-label={copy.era}>{data.eras.map((era,i)=><button type="button" data-era={era.id}><span>0{i+1} / {era.start.slice(0,4)}{i<3?'—'+era.end.slice(0,4):'—'}</span><strong>{copy.eras[i]}</strong><small>{events.filter(e=>e.era===era.id).length} {ui.events}</small></button>)}</div>
<details class="timeline-filter-panel"><summary>{ui.filter} <span data-filter-count></span></summary>
<WorkspaceFilters class="toolbar feature-filters"><label><span>{copy.search}</span><input name="q" type="search" placeholder={copy.search}/></label><label><span>{copy.entity}</span><select name="entity"><option value="">{copy.all}</option>{people.map(e=><option value={e.data.id}>{e.data.name||e.data.title}</option>)}</select></label><label><span>{copy.type}</span><select name="type"><option value="">{copy.all}</option>{types.map(type=><option value={type}>{entityLabel(type,locale)}</option>)}</select></label><label><span>{copy.year}</span><select name="year"><option value="">{copy.all}</option>{[...new Set(events.map(e=>e.date.start.slice(0,4)))].map(year=><option>{year}</option>)}</select></label><button type="reset" class="filter-reset">{ui.reset}</button></WorkspaceFilters></details>
<section class="timeline-console" aria-label={copy.title}>
<div class="timeline-transport"><button type="button" data-fit>{ui.fit}</button><label>{ui.zoom}<input data-time-zoom type="range" min="1" max="40" step=".1" value="4"/><output data-scale>4×</output></label><output data-window aria-label={ui.range}></output></div>
<div class="timeline-editor-body"><div class="timeline-track-labels"><div class="timeline-ruler-label">CHRONICLE</div>{tracks.map((track,i)=><div class="timeline-track-label"><span>0{i+1}</span><label><input type="checkbox" checked data-track value={track}/>{copy.tracks[i]}</label><button type="button" data-solo={track}>{copy.solo}</button></div>)}</div><div class="timeline-scroll" data-time-scroll tabindex="0" aria-label={ui.position}><div class="timeline-canvas" data-time-canvas><div class="timeline-ruler" data-ruler></div>{tracks.map((track,i)=><div class="timeline-track" data-lane={track} style={`--track-index:${i}`} aria-label={copy.tracks[i]}></div>)}<div class="timeline-playhead" data-playhead hidden></div></div></div></div>
<div class="timeline-overview"><div data-overview-eras class="timeline-overview-eras"></div><div class="timeline-window" data-window-marker></div><input type="range" data-pan min="0" max="1000" value="0" aria-label={ui.position}/></div>
<p class="timeline-hint">{ui.hint}<span data-count aria-live="polite"></span></p>
</section>
<p class="timeline-no-results" data-empty hidden>{copy.empty}</p>
<section class="timeline-inspector" aria-label={ui.select}><div class="timeline-inspector-list"><span class="timeline-kicker" data-group-title>{ui.select}</span><div data-event-list></div></div><article class="timeline-detail" data-detail><p>{ui.select}</p></article></section>
<noscript><p>{locale==='en'?'Enable JavaScript to explore the interactive timeline.':locale==='ja'?'時間軸の操作には JavaScript が必要です。':'交互时间轴需要启用 JavaScript。'}</p></noscript>
<script type="application/json" data-timeline-data set:html={JSON.stringify({events,eras:data.eras,tracks,trackLabels:copy.tracks,eraLabels:copy.eras,ui,locale}).replaceAll('<','\\u003c')}/>
</WorkspaceShell><SiteFooter footer={site.footer}/></BaseLayout>
<script>import {initTimeline} from '../../../lib/chronicleTimeline.ts';initTimeline();</script>
