---
import WorkspaceButton from '../../components/WorkspaceButton.astro';
import '../../styles/global.css';
import '../../styles/uiKit.css';
const apiBase=import.meta.env.PUBLIC_SUPPORT_API_BASE || import.meta.env.PUBLIC_AI_OBSERVER_API_BASE || 'https://api.kamitsubaki.wiki';
---
<!doctype html>
<html lang="zh-Hans">
<head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><meta name="referrer" content="no-referrer"/><title>完善发电展示资料 · KAMITSUBAKI Wiki</title></head>
<body>
<main class="supporter-profile" data-supporter-profile data-api-base={apiBase}>
 <header><a class="profile-brand" href="/zh/support/">KAMITSUBAKI WIKI</a><p class="profile-eyebrow">THANK YOU FOR YOUR SUPPORT</p><h1>让我们好好感谢你。</h1><p>填写权益接收邮箱，以及你希望在感谢名单展示的昵称和头像。展示资料由管理员审核后更新。</p></header>
 <p class="profile-status" data-profile-status role="status" aria-live="polite">正在读取专属链接…</p>
 <WorkspaceButton data-email-confirm tone="primary" hidden>确认验证邮箱</WorkspaceButton>
 <form data-profile-form hidden>
  <div class="profile-avatar"><img data-avatar-preview hidden alt="头像预览" width="88" height="88"/><span data-avatar-placeholder aria-hidden="true">✦</span><label>展示头像 <span>选填</span><input type="file" data-avatar-input accept="image/png,image/jpeg,image/webp"/><small>PNG / JPEG / WebP，最大 2 MiB。建议正方形。</small></label></div>
  <label for="supporter-email">权益接收邮箱 <span class="required">必填</span></label><input id="supporter-email" name="email" type="email" required maxlength="254" autocomplete="email" class="dui-input"/><small>用于权益通知与联系，不会展示在网站上。验证后会自动认领同邮箱的 Wiki 账号。</small><a data-email-preview hidden target="_blank" rel="noopener noreferrer">打开本地验证邮件预览</a>
  <label for="supporter-name">展示昵称 <span class="required">必填</span></label><input id="supporter-name" name="name" type="text" required maxlength="60" autocomplete="nickname" class="dui-input"/><small>请勿填入邮箱、手机号等私人信息。</small>
  <fieldset class="profile-wiki"><legend>Wiki 贡献归属 <span>自动认领</span></legend><p data-wiki-account-status>正在读取登录状态…</p><label data-wiki-account-choice hidden><input type="checkbox" data-wiki-account-bind/> 将这份贡献关联到 <strong data-wiki-account-name></strong></label><small>以后可在账号内汇总贡献与赞助记录。双方邮箱验证通过后自动认领。也可绑定当前登录账号；已有绑定不会被替换，金额保持私密。</small><div class="profile-actions"><WorkspaceButton href="/auth/sign-in" target="_blank" rel="noopener noreferrer" data-wiki-login>在新标签页登录 Wiki</WorkspaceButton><WorkspaceButton data-wiki-refresh>刷新账号</WorkspaceButton></div></fieldset>
  <div class="profile-actions"><WorkspaceButton type="submit" tone="primary" data-profile-submit>提交审核</WorkspaceButton><WorkspaceButton data-profile-retry>重新读取</WorkspaceButton></div>
  <p class="profile-note">公开名单仅显示昵称、头像和爱发电主页，不显示邮箱、订单或金额。专属链接有效期 7 天，请勿转发。</p>
 </form>
 <WorkspaceButton data-profile-retry data-profile-outside-retry hidden>重新读取</WorkspaceButton>
 <footer><a href="/zh/support/">返回项目支持页面</a><span>非官方粉丝项目 · 感谢你的每一份支持</span></footer>
</main>
<script>import '../../scripts/supporterProfile.ts';</script>
</body>
</html>
<style>
 :global(:root){--theme-fg:#202735;--theme-bg:#f6f7f9;--theme-fg-rgb:32 39 53;--theme-bg-rgb:246 247 249;}
 :global(body){margin:0;background:#f6f7f9;color:#202735;font-family:system-ui,sans-serif;}
 .supporter-profile{max-width:600px;margin:64px auto;padding:0 24px 40px;line-height:1.8;}
 .profile-brand{font-size:12px;font-weight:750;letter-spacing:.12em;color:inherit;text-decoration:none;}
 .profile-eyebrow{font-size:10px;letter-spacing:.18em;color:#737989;margin-top:42px;}
 h1{font-size:30px;line-height:1.3;margin:12px 0 18px;font-weight:650;}header>p:last-child{color:#626b79;font-size:15px;}
 form{background:white;border:1px solid #e2e5eb;border-radius:18px;padding:28px;margin-top:24px;box-shadow:0 8px 28px #26375406;}
 label{display:block;margin:24px 0 8px;font-size:14px;font-weight:600;}input.dui-input{display:block;width:100%;box-sizing:border-box;background:white;color:#202735;border:1px solid #cdd3dc;min-height:44px;border-radius:8px;padding:10px 12px;font-size:16px;}
 small{display:block;color:#747d89;font-size:12px;margin-top:6px;}.required,label span{font-weight:400;font-size:12px;color:#737989;margin-left:8px;}
 .profile-avatar{display:flex;gap:20px;align-items:center;margin-bottom:12px;}.profile-avatar img,.profile-avatar>span{width:88px;height:88px;object-fit:cover;border-radius:50%;flex-shrink:0;background:#edf0f5;}.profile-avatar>span{text-align:center;line-height:88px;font-size:32px;color:#848fa2;}.profile-avatar label{margin:0;min-width:0;}input[type=file]{display:block;margin-top:8px;max-width:100%;font-weight:400;font-size:12px;}
 .profile-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px;}.profile-note{font-size:12px;color:#747d89;margin:20px 0 0;}.profile-status{font-size:14px;padding:14px 16px;border-radius:10px;background:#e9eef7;color:#364969;}.profile-status[data-error=true]{background:#fff0ee;color:#a13026;}
 .profile-wiki{margin:24px 0 0;padding:16px;border:1px solid #e2e5eb;border-radius:10px;}.profile-wiki legend{padding:0 6px;font-size:14px;font-weight:600;}.profile-wiki legend span{font-size:12px;color:#737989;font-weight:400;}.profile-wiki label{font-size:13px;margin-top:10px;}.profile-wiki input{margin-right:8px;}.profile-wiki p{font-size:13px;color:#626b79;margin:0;}.profile-wiki .profile-actions{margin-top:12px;}
 footer{display:flex;gap:12px;justify-content:space-between;flex-wrap:wrap;margin-top:24px;font-size:12px;color:#707887;}footer a{color:inherit;text-decoration:underline;}
 @media(max-width:500px){.supporter-profile{margin-top:28px;padding-inline:16px;}form{padding:20px;}h1{font-size:26px;}.profile-avatar{gap:12px;}}
</style>
