---
interface Props {href:string;title:string;description?:string;index?:string;class?:string;}
const {href,title,description,index,class:className}=Astro.props;
---
<a href={href} class:list={['workspace-link-card',className]}>{index&&<span class="workspace-link-card-index" aria-hidden="true">{index}</span>}<span class="workspace-link-card-copy"><strong>{title}</strong>{description&&<small>{description}</small>}</span><span class="workspace-link-card-arrow" aria-hidden="true">↗</span></a>
<style>
.workspace-link-card{display:flex;align-items:center;gap:20px;min-width:0;min-height:92px;padding:18px 0;border:0;border-bottom:1px solid rgb(var(--theme-fg-rgb)/.15);background:none;color:var(--theme-fg);text-decoration:none;position:relative;isolation:isolate;transition:border-color 220ms,color 220ms}
.workspace-link-card::before{content:'';position:absolute;inset:4px -12px;z-index:-1;border-radius:8px;background:linear-gradient(110deg,color-mix(in srgb,var(--theme-accent-color) 7%,transparent),transparent);opacity:0;transform:translateX(-4px);transition:opacity 220ms,transform 220ms}
.workspace-link-card:hover::before,.workspace-link-card:focus-visible::before{opacity:1;transform:none}
.workspace-link-card:last-child{border-bottom-color:transparent}
.workspace-link-card-copy{flex:1;min-width:0}.workspace-link-card strong{display:block;font:400 20px/1.6 var(--font-serif);letter-spacing:.025em}.workspace-link-card small{display:block;margin-top:6px;font:12px/1.85 var(--font-sans);color:rgb(var(--theme-fg-rgb)/.62)}
.workspace-link-card-index{font:10px var(--font-mono);color:rgb(var(--theme-fg-rgb)/.4)}.workspace-link-card-arrow{font-size:17px;transition:transform 220ms;color:rgb(var(--theme-fg-rgb)/.5)}
.workspace-link-card:hover{color:var(--theme-accent-color);border-color:var(--theme-accent-color)}.workspace-link-card:hover .workspace-link-card-arrow{transform:translate(3px,-3px);color:var(--theme-accent-color)}.workspace-link-card:focus-visible{outline:2px solid var(--theme-accent-color);outline-offset:5px}
@media(max-width:760px){.workspace-link-card{padding-block:20px;gap:16px}.workspace-link-card strong{font-size:20px}}
@media(prefers-reduced-motion:reduce){.workspace-link-card,.workspace-link-card-arrow,.workspace-link-card::before{transition:none}.workspace-link-card:hover .workspace-link-card-arrow{transform:none}}
</style>
