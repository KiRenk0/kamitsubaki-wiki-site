---
import Icon from './Icon.astro';
import {supportCatalog} from '../lib/supportCatalog.mjs';
import {supportExperienceCopy} from '../lib/supportExperienceCopy.mjs';
import {resolveLocaleCopy} from '../lib/i18n.mjs';
const {locale='zh'}=Astro.props,c=supportExperienceCopy(locale),tiers=supportCatalog.tiers;
const text=resolveLocaleCopy({
 zh:{title:'选择你的支持档位',intro:'每一份支持，都用于观测站的运行、资料整理与持续维护。',groups:'观测者组别',open:'查看档位',terms:'档位与具体权益以爱发电页面为准。Wiki 的正常资料始终向所有人开放。'},
 ja:{title:'あなたらしい支援プラン',intro:'サイトの運営、資料整理、継続的な保守を支えます。',groups:'観測者グループ',open:'プランを見る',terms:'プランと特典の詳細は愛発電をご確認ください。Wiki の通常の資料はすべての方に公開されます。'},
 en:{title:'Choose your level of support',intro:'Every contribution supports hosting, archive work and ongoing maintenance.',groups:'Observer groups',open:'View plans',terms:'Afdian lists the current plans and benefits. Normal Wiki content stays open to everyone.'}
},locale);
const plans=[{tier:tiers[0],description:c.base[0]},{tier:tiers[1],name:text.groups,groups:tiers.filter(t=>t.monthlyAmount===10),description:c.group[0]},{tier:tiers.find(t=>t.id==='joint')!,description:c.joint[0]},{tier:tiers.find(t=>t.id==='long-term')!,description:c.long[0]}];
---
<div class="support-tier-heading"><div><h2>{text.title}</h2><p>{text.intro}</p></div><a href={supportCatalog.planUrl} target="_blank" rel="noopener noreferrer">{text.open}<Icon name="arrow-up-right"/></a></div>
<div class="support-tiers">{plans.map((plan,index)=><a class="support-tier" href={supportCatalog.planUrl} target="_blank" rel="noopener noreferrer">
 <span class="support-tier__number" aria-hidden="true">0{index+1}</span>
 <div class="support-tier__detail"><h3>{plan.name||plan.tier.name}</h3><p>{plan.description}</p>{plan.groups&&<ul aria-label={text.groups}>{plan.groups.map(group=><li>{group.name}</li>)}</ul>}</div>
 <span class="support-tier__price"><strong>¥{plan.tier.monthlyAmount}</strong><span>{c.month}</span></span><Icon name="arrow-up-right"/>
</a>)}</div>
<p class="support-tier-terms">{text.terms}</p>
