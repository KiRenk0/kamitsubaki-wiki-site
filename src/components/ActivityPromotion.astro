---
import {activityCopy} from '../lib/activityCopy.mjs';
import '../styles/activityCenter.css';
const {locale='zh'}=Astro.props,c=activityCopy(locale),api=import.meta.env.PUBLIC_COMMUNITY_API_URL||import.meta.env.PUBLIC_GALLERY_API_URL||'https://api.kamitsubaki.wiki';
---
<section class="activity-promotion" data-activity-promotion data-api={api} data-locale={locale} data-copy={JSON.stringify(c)} hidden>
 <div class="activity-section-title"><h2>{c.featuredTitle}</h2><a href={`/${locale}/events/`}>{c.viewAll}</a></div>
 <div class="activity-promotion-columns">{['official','community'].map(source=><section data-promotion-column={source} hidden><div class="activity-section-title"><h3>{source==='official'?c.officialTab:c.communityTab}</h3><a href={source==='official'?`/${locale}/events/`:`/${locale}/community/activities/`}>{c.viewAll}</a></div><div class="activity-card-grid" data-promotion-cards={source}></div></section>)}</div>
</section>
<script>
 import {getActivities,activityCard,observeActivities} from '../lib/activityClient.js';
 document.querySelectorAll<HTMLElement>('[data-activity-promotion]').forEach(root=>{
  const copy=JSON.parse(root.dataset.copy!),base=root.dataset.api!,locale=root.dataset.locale!;
  for(const source of ['official','community'])void getActivities(base,{source,recommend:'1',placement:'home',locale}).then(data=>{const cards=root.querySelector(`[data-promotion-cards="${source}"]`)!;for(const item of data.items)cards.append(activityCard(item,{locale,copy,base,placement:'home'}));if(data.items.length){root.hidden=false;(root.querySelector(`[data-promotion-column="${source}"]`) as HTMLElement).hidden=false;observeActivities(cards,base,'home');}}).catch(()=>{});
 });
</script>
