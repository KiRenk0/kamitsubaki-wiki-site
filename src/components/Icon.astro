---
import { iconBody } from '../lib/icons.mjs';
interface Props { name:string; class?:string; size?:number; [key:string]:unknown; }
const {name,class:className='',size=18,...attributes}=Astro.props;
---
<svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" {...attributes} class:list={['site-icon',className]} data-icon={name} set:html={iconBody(name)}/>
