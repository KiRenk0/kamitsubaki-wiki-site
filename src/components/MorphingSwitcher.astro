---
import ResponsiveImage from './ResponsiveImage.astro';
import {resolveLocaleCopy} from '../lib/i18n.mjs';
import type {ResolvedEntity} from '../lib/entityRegistry.mjs';
const {entries,current,locale}=Astro.props as {entries:ResolvedEntity[];current:string;locale:string};
const copy=resolveLocaleCopy({zh:{title:'当前观测形态',intro:'同一关联谱系，各自独立的档案。',roles:{'virtual-artist':'虚拟艺人','real-artist':'创作歌手','isotope':'音乐同位体','fictional-resident':'世界观住民'}},ja:{title:'観測形態',intro:'つながる存在、それぞれの記録。',roles:{'virtual-artist':'バーチャル歌手','real-artist':'シンガーソングライター','isotope':'音楽的同位体','fictional-resident':'世界観の住民'}},en:{title:'Observation form',intro:'Connected identities, individual records.',roles:{'virtual-artist':'Virtual artist','real-artist':'Singer-songwriter','isotope':'Musical isotope','fictional-resident':'Fictional resident'}}},locale);
---
<section class="morph-switcher" aria-label={copy.title}>
 <div class="morph-context"><strong>{copy.title}</strong><span>{copy.intro}</span></div>
 <nav class="morph-rail" aria-label={copy.title} data-morph-rail>{entries.map((entry,i)=><a href={entry.url} aria-current={entry.data.id===current?'page':undefined}><span class="morph-index">0{i+1}</span>{entry.data.presentation?.image&&<ResponsiveImage src={entry.data.presentation.image} alt="" widths={[96]} sizes="36px"/>}<span class="morph-copy"><small>{copy.roles[entry.data.presentation?.morphing?.slot]||''}</small><strong>{entry.data.name||entry.data.title}</strong></span><span class="morph-state" aria-hidden="true">{entry.data.id===current?'●':'↗'}</span></a>)}</nav>
</section>
<style>
.morph-switcher{margin-top:20px;padding:0 0 8px}.morph-context{display:flex;gap:16px;align-items:center;margin-bottom:12px;font-size:10px;color:var(--reader-muted)}.morph-context strong{font-weight:500;color:var(--reader-text)}.morph-context span{font-size:10px}.morph-rail{position:relative;isolation:isolate;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:4px;padding:5px;border:1px solid var(--reader-line);border-radius:var(--ui-radius-panel);background:rgb(var(--theme-fg-rgb)/.015)}.morph-rail a{position:relative;display:flex;align-items:center;gap:12px;padding:12px;min-width:0;text-decoration:none;color:var(--reader-muted);border:1px solid transparent;border-radius:var(--ui-radius-control);transition:background var(--motion-fast),border-color var(--motion-fast)}.morph-rail a[aria-current]{color:var(--reader-text);border-color:color-mix(in srgb,var(--theme-accent-color) 25%,transparent);background:color-mix(in srgb,var(--theme-accent-color) 7%,transparent)}.morph-rail a:hover{background:rgb(var(--theme-fg-rgb)/.045)}.morph-index{font:9px var(--font-mono);opacity:.5}.morph-rail :global(img){width:36px;height:44px;object-fit:cover;object-position:top;border-radius:2px}.morph-copy{min-width:0}.morph-copy small{display:block;font-size:9px;margin-bottom:5px;color:var(--reader-muted)}.morph-copy strong{font:500 14px/1.6 var(--font-serif)}.morph-state{margin-left:auto;font-size:9px;opacity:.5}.morph-rail a[aria-current] .morph-state{color:var(--theme-accent-color);opacity:1}@media(max-width:760px){.morph-rail{grid-template-columns:repeat(2,minmax(0,1fr))}.morph-context span{display:none}.morph-rail a{gap:9px;padding:9px}.morph-copy strong{font-size:13px}}@media(prefers-reduced-motion:reduce){.morph-rail a{transition:none}}
</style>
