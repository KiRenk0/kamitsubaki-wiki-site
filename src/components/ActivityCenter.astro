---
import WorkspaceButton from './WorkspaceButton.astro';
import WorkspaceControl from './WorkspaceControl.astro';
import Icon from './Icon.astro';
import ContentSkeleton from './ContentSkeleton.astro';
import {activityCopy} from '../lib/activityCopy.mjs';
import '../styles/community.css';
import '../styles/activityCenter.css';
const {locale='zh',source='community'}=Astro.props,c=activityCopy(locale);
const api=import.meta.env.PUBLIC_COMMUNITY_API_URL||import.meta.env.PUBLIC_GALLERY_API_URL||'https://api.kamitsubaki.wiki';
---
<section class="activity-center" data-ui-kit data-activity-center data-source={source} data-locale={locale} data-api={api} data-copy={JSON.stringify(c)}>
 <nav class="activity-tabs dui-tabs dui-tabs-box" aria-label={c.title}>
  <a class="dui-tab" href={`/${locale}/community/activities/`} aria-current={source==='community'?'page':undefined} data-activity-tab="community">{c.communityTab}</a>
   <a class="dui-tab" href={`/${locale}/events/?source=official`} aria-current={source==='official'?'page':undefined} data-activity-tab="official">{c.officialTab}</a>
 </nav>
 <form data-activity-filters class="activity-filters">
  <div class="activity-command"><label><span class="sr-only">{c.month}</span><WorkspaceControl name="month" type="month" aria-label={c.month}/></label><WorkspaceButton data-activity-today>{c.today}</WorkspaceButton><WorkspaceButton data-activity-range="next">{c.nearby}</WorkspaceButton><WorkspaceButton data-activity-range="deadline" data-community-only>{c.deadlineView}</WorkspaceButton><div class="activity-view"><WorkspaceButton data-activity-view="calendar" aria-pressed="false"><Icon name="calendar-days"/>{c.calendar}</WorkspaceButton><WorkspaceButton data-activity-view="agenda" aria-pressed="false"><Icon name="list"/>{c.agenda}</WorkspaceButton></div></div>
  <div class="activity-search"><label><span class="sr-only">{c.keyword}</span><WorkspaceControl type="search" name="q" placeholder={c.keyword}/></label><label data-official-only><span class="sr-only">{c.allArtists}</span><WorkspaceControl as="select" name="artist"><option value="">{c.allArtists}</option></WorkspaceControl></label><details data-community-only data-activity-filter-details><summary class="workspace-button dui-btn dui-btn-ghost" data-ui-kit>{c.filterActivities}</summary><div class="community-toolbar activity-filter-surface" data-location-root data-filter-surface>
   <label><span>{c.country}</span><WorkspaceControl as="select" name="country"><option value="">{c.all}</option></WorkspaceControl></label>
   <label><span>{c.subdivisionCode}</span><WorkspaceControl as="select" name="subdivisionCode"><option value="">{c.all}</option></WorkspaceControl></label>
   <label><span>{c.city}</span><WorkspaceControl as="select" name="cityId"><option value="">{c.all}</option></WorkspaceControl></label><input name="city" type="hidden"/>
   <label><span>{c.mode}</span><WorkspaceControl as="select" name="mode"><option value="">{c.all}</option>{['online','offline','hybrid'].map(key=><option value={key}>{c[key]}</option>)}</WorkspaceControl></label>
   <label><span>{c.category}</span><WorkspaceControl as="select" name="category"><option value="">{c.all}</option>{['new-year','support','meetup','convention','other'].map(key=><option value={key}>{c[key]}</option>)}</WorkspaceControl></label><p data-location-status role="status"></p><WorkspaceButton data-location-retry hidden>{c.retry}</WorkspaceButton>
  </div></details><WorkspaceButton data-activity-clear tone="quiet">{c.clear}</WorkspaceButton></div>
 </form>
 <div class="activity-basis"><p>{c.basis}</p><label data-community-only><WorkspaceControl type="checkbox" name="deadlines" data-activity-deadlines checked/>{c.pointToggle}</label></div>
 <p data-activity-status role="status" aria-live="polite"></p><WorkspaceButton data-activity-retry hidden>{c.retry}</WorkspaceButton>
 <div class="activity-calendar-surface"><ContentSkeleton kind="calendar" count={5} data-activity-loading/><div class="activity-native" data-activity-native></div></div>
 <section data-activity-day hidden><div class="activity-section-title"><h2 data-activity-day-title></h2><WorkspaceButton data-activity-day-close tone="quiet">{c.close}</WorkspaceButton></div><div data-activity-day-list aria-live="polite" class="activity-card-grid"></div></section>
 <section data-activity-undated hidden><h2>{c.undated}</h2><div class="activity-card-grid" data-activity-undated-list></div></section>
 <section data-activity-featured-section hidden><h2>{c.featuredTitle}</h2><div data-activity-featured class="activity-card-grid"></div></section>
 <footer class="community-subscription"><p>{c.subscriptionHint}</p><div class="community-actions"><WorkspaceButton data-activity-subscribe href="#"><Icon name="calendar-days"/>{c.subscribe}</WorkspaceButton><WorkspaceButton data-activity-copy-subscription tone="quiet">{c.copySubscription}</WorkspaceButton></div></footer>
</section>
<script>import {initActivityCenter} from '../scripts/activityCenter.js';document.querySelectorAll('[data-activity-center]').forEach(initActivityCenter);</script>
