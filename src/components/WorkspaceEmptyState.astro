---
interface Props {title:string;description?:string;}
const {title,description}=Astro.props;
---
<div class="workspace-empty-state"><span aria-hidden="true">＋</span><h2>{title}</h2>{description&&<p>{description}</p>}<slot/></div>
<style>
.workspace-empty-state{display:grid;justify-items:center;text-align:center;gap:14px;min-height:216px;align-content:center;padding:36px 24px;border:1px solid rgb(var(--theme-fg-rgb)/.13);border-radius:var(--workspace-radius,12px);background:var(--workspace-surface);box-shadow:inset 0 1px 0 rgb(var(--theme-bg-rgb)/.7)}
.workspace-empty-state>span{display:grid;place-items:center;width:40px;height:40px;border:1px solid color-mix(in srgb,var(--theme-accent-color) 22%,transparent);border-radius:10px;background:color-mix(in srgb,var(--theme-accent-color) 5%,transparent);font:22px var(--font-mono);color:var(--theme-accent-color)}
.workspace-empty-state h2{font:400 18px/1.8 var(--font-serif);max-width:48ch;margin:0}
.workspace-empty-state p{font:13px/1.9 var(--font-sans);max-width:48ch;margin:0;color:rgb(var(--theme-fg-rgb)/.62)}
</style>
