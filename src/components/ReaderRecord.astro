---
interface Props {record:{title:string;href?:string;detail?:string};index:number;overflow?:boolean}
const {record,index,overflow=false}=Astro.props;
const Tag=record.href?'a':'div';
---
<Tag href={record.href} class:list={['reader-record',overflow&&'artist-row-collapsed']} hidden={overflow}>
 <span class="reader-record-index">{String(index+1).padStart(2,'0')}</span>
 <span class="reader-record-text"><strong>{record.title}</strong>{record.detail&&<small>{record.detail}</small>}</span>
 {record.href&&<span class="reader-record-arrow" aria-hidden="true">↗</span>}
</Tag>
