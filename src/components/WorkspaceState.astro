---
import Icon from './Icon.astro';
import type {HTMLAttributes} from 'astro/types';
interface Props extends HTMLAttributes<'section'> {state?:'loading'|'empty'|'error'|'ready';}
const {state='empty',class:className,...attributes}=Astro.props;
---
<section {...attributes} class:list={['workspace-state',className]} data-state={state}>
 <Icon name="file-text" class="workspace-state__symbol" />
 <slot/>
 <div class="workspace-state__actions"><slot name="actions"/></div>
</section>
