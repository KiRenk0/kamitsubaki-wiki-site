---
import Icon from './Icon.astro';
import {communityCopy} from '../lib/communityCopy.mjs';
const {locale='zh'}=Astro.props,c=communityCopy(locale),api=import.meta.env.PUBLIC_COMMUNITY_API_URL||import.meta.env.PUBLIC_GALLERY_API_URL||'https://api.kamitsubaki.wiki';
---
<aside class="community-float" data-community-float data-api={api} data-locale={locale} data-copy={JSON.stringify(c)}>
 <button class="community-float__toggle" type="button" data-community-toggle aria-label={c.board} title={c.board} aria-expanded="false" aria-controls="community-float-panel"><Icon name="calendar-days"/></button>
 <div class="community-float__backdrop" data-community-backdrop hidden></div>
 <section class="community-float__panel" id="community-float-panel" data-community-panel role="dialog" aria-label={c.board} aria-modal="false" hidden inert tabindex="-1">
  <header><div><span>COMMUNITY / PROJECTS</span><h2>{c.board}</h2></div><button type="button" data-community-close aria-label={c.close}><Icon name="x"/></button></header>
  <p data-community-float-status role="status">{c.loading}</p><button type="button" data-community-float-retry hidden>{c.retry}</button>
  <div class="community-card-grid" data-community-float-cards></div>
  <footer><a href={`/${locale}/community/activities/`}>{c.calendar} <Icon name="arrow-right"/></a><a href={`/${locale}/community/activities/apply/`}>{c.apply}</a></footer>
 </section>
</aside>
<style is:global>
 .community-float{position:fixed;right:calc(var(--floating-action-edge) + 2 * (var(--floating-action-size) + 10px));bottom:max(var(--floating-action-edge),env(safe-area-inset-bottom));z-index:42;color:var(--theme-fg)}
 .community-float__toggle{display:grid;place-items:center;width:var(--floating-action-size);height:var(--floating-action-size);border:1px solid rgb(var(--theme-fg-rgb)/.2);border-radius:var(--ui-radius-control);background:var(--theme-panel-solid);color:var(--theme-accent-color);box-shadow:0 4px 16px rgb(0 0 0/.1);cursor:pointer}.community-float__toggle svg{width:21px;height:21px}
 .community-float__panel{position:fixed;right:var(--floating-action-edge);bottom:calc(var(--floating-action-edge) + var(--floating-action-size) + 12px);width:min(640px,calc(100vw - 2 * var(--floating-action-edge)));max-height:min(72dvh,720px);overflow:auto;padding:24px;border:1px solid rgb(var(--theme-fg-rgb)/.18);border-radius:var(--ui-radius-panel);background:var(--theme-panel-solid);box-shadow:0 14px 48px rgb(0 0 0/.16);z-index:44}
 .community-float__panel header{display:flex;align-items:flex-start;justify-content:space-between;gap:16px}.community-float__panel header span{font:10px var(--font-mono);letter-spacing:.1em;opacity:.5}.community-float__panel h2{font:500 23px/1.5 var(--font-serif);margin:10px 0}.community-float__panel button{min-height:44px;padding:8px;border:1px solid rgb(var(--theme-fg-rgb)/.15);border-radius:var(--ui-radius-control);background:none;color:inherit;cursor:pointer}.community-float__panel [data-community-close]{display:grid;place-items:center;width:44px}.community-float__panel [data-community-close] svg{width:18px;height:18px}.community-float__panel p{font:13px/1.8 var(--font-sans)}
 .community-float .community-card-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin:16px 0}.community-float .community-card{overflow:hidden;border:1px solid rgb(var(--theme-fg-rgb)/.15);border-radius:var(--ui-radius-item);color:inherit;text-decoration:none}.community-float .community-card img{display:block;width:100%;height:170px;object-fit:contain;background:rgb(var(--theme-fg-rgb)/.025)}.community-float .community-card__copy{padding:12px}.community-float .community-card h3{font:500 16px/1.6 var(--font-serif);margin:6px 0}.community-float .community-card p{font-size:12px;opacity:.7}.community-float .community-badge{font-size:10px;margin-right:8px;color:var(--theme-accent-color)}.community-float footer{display:flex;justify-content:space-between;gap:12px;padding-top:18px;border-top:1px solid rgb(var(--theme-fg-rgb)/.15);font-size:13px}.community-float footer a{color:inherit;text-decoration:none;min-height:44px;display:flex;align-items:center;gap:8px}.community-float footer svg{width:16px;height:16px}
 .community-float [hidden]{display:none!important}.community-float :is(a,button):focus-visible{outline:2px solid var(--theme-accent-color);outline-offset:3px}
 @media(max-width:540px){.community-float__panel{inset:auto 0 0;width:100%;max-height:80dvh;padding:22px 18px calc(18px + env(safe-area-inset-bottom));border-radius:var(--ui-radius-panel) var(--ui-radius-panel) 0 0}.community-float .community-card-grid{grid-template-columns:1fr}.community-float__backdrop{position:fixed;inset:0;z-index:43;background:rgb(0 0 0/.28)}.community-float .community-card img{height:190px}}
 :global(body:has(.ve-workbench)) .community-float,:global(body:has(.pswp--open)) .community-float{display:none}
</style>
<script>import {initCommunityFloat} from '../scripts/communityFloat.js';initCommunityFloat(document.querySelector('[data-community-float]'));</script>
