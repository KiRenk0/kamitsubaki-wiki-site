---
import { labsCopy } from '../../lib/labsCopy.mjs';
import '../../styles/labs.css';
import '../../styles/personalTools.css';
const { locale = 'zh', title = '' } = Astro.props;
const copy = labsCopy(locale);
const path = Astro.url.pathname.replace(/\/$/,'') + '/';
---
<div class="labs-bookmark" data-bookmark data-path={path} data-title={title} data-save-label={copy.save} data-saved-label={copy.saved} data-error-label={copy.storageError}>
  <button type="button" aria-pressed="false" data-bookmark-toggle>{copy.save}</button><a href={`/${locale}/labs/library/`}>{copy.library}</a><span role="status"></span>
</div>
<script>
  import { readLibrary, writeLibrary, toggleItem } from '../../lib/personalLibrary.mjs';
  document.querySelectorAll<HTMLElement>('[data-bookmark]').forEach(root => {
    const button = root.querySelector<HTMLButtonElement>('[data-bookmark-toggle]')!;
    function update() { try { const saved = readLibrary(localStorage).items.some(item => item.path === root.dataset.path); button.textContent = saved ? root.dataset.savedLabel! : root.dataset.saveLabel!; button.setAttribute('aria-pressed',String(saved)); root.querySelector('[role=status]')!.textContent = '';  } catch { root.querySelector('[role=status]')!.textContent = root.dataset.errorLabel!; } }
    button.addEventListener('click',()=> { try { writeLibrary(localStorage,toggleItem(readLibrary(localStorage),{path:root.dataset.path!, title:root.dataset.title!})); update(); } catch { root.querySelector('[role=status]')!.textContent = root.dataset.errorLabel!; } });
    window.addEventListener('storage',update);window.addEventListener('kamitsubaki-library-change',update);update();
  });
</script>
