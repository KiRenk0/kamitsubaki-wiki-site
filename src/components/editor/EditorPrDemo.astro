---
import {submissionCopy} from '../../lib/editorSubmissionCopy.mjs';
const copy=submissionCopy(Astro.props.locale||'zh');const t=(text: string)=>copy[text]||text;
import {localEditor} from '../../lib/editorConfig.mjs';
---
<dialog class="ve-pr-dialog" data-pr-dialog data-pr-copy={JSON.stringify(copy)} aria-labelledby="ve-pr-title">
  <header class="ve-pr-heading"><div><small>{localEditor?t('站内编辑器 / 投稿 · 本地联调'):t('站内编辑器 / 投稿审核')}</small><h2 id="ve-pr-title">{t('提交与审核')}</h2></div><button data-pr-close aria-label={t('关闭投稿面板')}>×</button></header>
  <p class="ve-pr-notice">{localEditor?t('本地调试：草稿与投稿保存在本机服务中，审核和发布使用模拟服务。'):t('提交后将创建公开的 GitHub PR，由维护者审核后发布。请勿填写密码或私人信息。')}</p>
  <p><span data-pr-account-name>{t('未连接')}</span> <button data-pr-switch-account hidden={!localEditor}>{t('切换本地测试账号')}</button></p>
  <button data-pr-login data-account-login hidden>{t('登录站内账号')}</button>
  <nav class="ve-pr-tabs" aria-label={t('投稿面板')}><button data-pr-tab="submit" aria-pressed="true">{t('提交修改')}</button><button data-pr-tab="discussion" aria-pressed="false">{t('审核讨论')}</button><button data-pr-tab="history" aria-pressed="false">{t('我的投稿')}</button><button hidden={!localEditor} data-pr-tab="simulate" aria-pressed="false">{t('模拟 GitHub')}</button></nav>
  <div class="ve-pr-context"><strong data-pr-entry></strong><span data-pr-state></span></div>
  <section data-pr-panel="submit">
    <p class="ve-pr-muted" data-pr-path></p>
    <details open><summary>{t('本次修改')}<span data-pr-diff-count></span></summary><div class="ve-pr-diff" data-pr-diff></div></details>
    <p class="ve-pr-muted">{t('服务器草稿保留 90 天；本机草稿可随时导出。')}</p><div class="ve-pr-actions"><button data-pr-save-draft>{t('保存服务端草稿')}</button><button data-pr-load-draft>{t('读取服务端草稿')}</button></div>
    <label>{t('修改说明')}<input data-pr-summary maxlength="200" placeholder={t('说明改动的内容与原因')}/></label>
    <label>{t('资料来源（可选）')}<input data-pr-source type="url" placeholder="https://…"/></label>
    <p hidden={!localEditor} class="ve-pr-muted">{t('正式接入后，投稿内容和审核讨论将成为公开的 GitHub PR。')}</p>
    <div class="ve-pr-actions"><button data-pr-return>{t('返回编辑')}</button><button class="ve-primary" data-pr-submit>{t('提交审核')}</button></div>
  </section>
  <section data-pr-panel="recover" hidden><h3>{t('恢复草稿')}</h3><div class="ve-pr-conflict-grid"><label>{t('当前编辑内容')}<textarea data-pr-recovery-current readonly rows="12"></textarea></label><label>{t('服务端草稿')}<textarea data-pr-recovery-saved readonly rows="12"></textarea></label></div><p data-pr-recovery-diff></p><button data-pr-recovery-apply>{t('恢复这份草稿')}</button></section>
  <section data-pr-panel="resolve" hidden>
    <h3>{t('核对并解决冲突')}</h3><p>{t('对照原稿、最新原文和你的修改，在下方填写最终内容。提交时会再次检查版本；不会强推或自动覆盖其他文件。')}</p>
    <div class="ve-pr-conflict-grid"><label>{t('开始编辑时的原文')}<textarea data-pr-original readonly rows="10"></textarea></label><label>{t('现在的原文')}<textarea data-pr-current readonly rows="10"></textarea></label><label>{t('你的修改')}<textarea data-pr-yours readonly rows="10"></textarea></label></div>
    <details><summary>{t('PR 分支上的最新内容')}</summary><textarea data-pr-branch readonly rows="10"></textarea></details>
    <label>{t('核对后的最终 Markdown')}<textarea data-pr-resolution rows="14"></textarea></label><label>{t('本次解决说明')}<input data-pr-resolution-summary maxlength="200" /></label>
    <label><input type="checkbox" data-pr-resolution-confirm />{t('我已核对最新原文和分支内容')}</label>
    <button data-pr-resolve-submit>{t('提交核对后的内容')}</button>
  </section>
  <section data-pr-panel="discussion" hidden><p data-pr-checks></p><div data-pr-comments></div><button data-pr-more-comments hidden>{t('查看更多评论')}</button><button data-pr-return>{t('返回编辑器继续修改')}</button></section>
  <section data-pr-panel="history" hidden><div data-pr-list></div><button data-pr-more-submissions hidden>{t('更多投稿')}</button><button data-pr-reset hidden>{t('清除模拟投稿记录')}</button><p hidden={!localEditor} class="ve-pr-muted">{t('投稿保存在本地后端数据库，刷新或重启服务后仍然保留。')}</p></section>
  <section data-pr-panel="simulate" hidden>
    <p class="ve-pr-muted">{t('扮演审核者操作。正式接入后，这些事件来自你在 GitHub 上的操作。')}</p>
    <label>{t('审核评论')}<textarea data-pr-comment rows="3" placeholder={t('请补充这一段的来源。')}></textarea></label>
    <label>{t('评论类型')}<select data-pr-comment-kind><option value="general">{t('PR 普通评论')}</option><option value="inline">{t('行内评论')}</option></select></label>
    <label>{t('关联已提交版本的行号')}<input data-pr-line type="number" min="1" value="1"/></label>
    <div class="ve-pr-sim-actions"><button data-pr-event="comment">{t('发表评论')}</button><button data-pr-event="changes">{t('要求修改')}</button><button data-pr-event="pass">{t('检查通过')}</button><button data-pr-event="fail">{t('检查失败')}</button><button data-pr-event="approve">{t('批准')}</button><button data-pr-event="merge">{t('合并 PR')}</button><button data-pr-event="publish">{t('部署成功')}</button><button data-pr-event="deploy-fail">{t('部署失败')}</button><button data-pr-event="close">{t('关闭 PR')}</button></div>
  </section>
  <button data-pr-withdraw hidden>{t('撤回投稿')}</button><button data-pr-resolve hidden>{t('核对原文冲突')}</button>
  <p data-pr-sync-error role="status" hidden></p><button data-pr-retry hidden>{t('立即重试')}</button>
  <p class="ve-pr-feedback" data-pr-feedback role="status" aria-live="polite"></p>
</dialog>
