---
import { editorCopy } from '../../lib/visualEditorCopy.mjs';
const { locale = 'zh' } = Astro.props;
const copy = editorCopy(locale);
---
<aside class="editor-entry">
  <div><strong>{copy.title}</strong><p>{copy.entryIntro}</p></div>
  <a href={`/${locale}/contribute/editor/`} data-visual-editor-entry>{copy.open}<span aria-hidden="true"> →</span></a>
</aside>
<style>
  .editor-entry { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:16px; margin:20px 0 28px; padding:20px 22px; border:1px solid var(--ui-line); border-radius:var(--ui-radius-panel); background:rgb(var(--theme-fg-rgb)/.025); }
  .editor-entry strong { font:500 18px var(--font-serif); color:var(--theme-fg); }
  .editor-entry p { margin:8px 0 0; font:13px/1.8 var(--font-sans); color:rgb(var(--theme-fg-rgb)/.6); }
  .editor-entry a { flex-shrink:0; display:inline-flex; align-items:center; min-height:44px; padding:8px 14px; border:1px solid var(--ui-line); border-radius:var(--ui-radius-control); font-size:13px; color:var(--theme-accent-color); }
  .editor-entry a:hover { background:var(--ui-hover); }
</style>
<script>
  const target = new URLSearchParams(location.search).get('target');
  if (target) document.querySelectorAll<HTMLAnchorElement>('[data-visual-editor-entry]').forEach(link => { const url = new URL(link.href); url.searchParams.set('target', target); link.href = url.href; });
</script>
