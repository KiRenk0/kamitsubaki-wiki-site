---
import WorkspaceControl from '../WorkspaceControl.astro';
import WorkspaceButton from '../WorkspaceButton.astro';
import IconLabel from '../IconLabel.astro';
import Icon from '../Icon.astro';
import ContributionFlow from '../ContributionFlow.astro';
import ImageLibrary from '../ImageLibrary.astro';
import {articleCreationCopy} from '../../lib/articleCreationCopy.mjs';
import {imageLibraryCopy} from '../../lib/imageLibraryCopy.mjs';
import AppearanceControls from '../AppearanceControls.astro';
import {creationCopy,creationDictionary} from '../../lib/editorCreationCopy.mjs';
import {submissionCopy} from '../../lib/editorSubmissionCopy.mjs';
import {editorEnabled,localEditor,editorApiBase} from '../../lib/editorConfig.mjs';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { supportedLocales, getEditableLocale, resolveLocaleCopy } from '../../lib/i18n.mjs';
import { editorCopy } from '../../lib/visualEditorCopy.mjs';
import { editorStarterCopy } from '../../lib/editorStarter.mjs';
import { editorArticleImageCopy } from '../../lib/editorArticleImage.mjs';
import { entryTypes, blockTypes } from '../../lib/visualEditor.mjs';
import '../../styles/visualEditor.css';
import '../../styles/editorWorkbench.css';
import EditorPrDemo from '../../components/editor/EditorPrDemo.astro';
import SubmissionReceipt from '../../components/SubmissionReceipt.astro';
import '../../styles/editorPrDemo.css';
interface Props {locale:string;articleMode?:boolean;articleApi?:string;articleAdmin?:boolean}
const {locale='zh',articleMode=false,articleApi='',articleAdmin=false}=Astro.props;
const tc = creationCopy(locale);
const modeCopy=resolveLocaleCopy({zh:{articles:'文章',save:'保存草稿',submit:'提交审核',mine:'我的提案',new:'新文章',previous:'上一页',next:'下一页',close:'关闭'},en:{articles:'Articles',save:'Save draft',submit:'Submit for review',mine:'My proposals',new:'New article',previous:'Previous',next:'Next',close:'Close'},ja:{articles:'記事',save:'下書きを保存',submit:'審査に提出',mine:'自分の提案',new:'新規記事',previous:'前へ',next:'次へ',close:'閉じる'}},locale);
const articleLabels=resolveLocaleCopy({zh:{workbench:'文章编辑器',entryProperties:'文章属性',emptyTitle:'文章标题'},ja:{workbench:'文章エディター',entryProperties:'文章の設定',emptyTitle:'文章タイトル'},en:{workbench:'Article editor',entryProperties:'Article properties',emptyTitle:'Article title'}},locale);
const copy = {...editorCopy(locale),...(articleMode?articleLabels:{})};const submissionLabels=submissionCopy(locale);const st=(text: string)=>submissionLabels[text]||text;
const starter=editorStarterCopy(locale);
const articleImage=editorArticleImageCopy(locale),articleCreation=articleCreationCopy(locale);
const docsGuideHref=`/${locale}/docs/contribute/${articleMode?'article':'entry'}/`;
const locales: Record<string,string> = {'zh':'简体中文','zh-tw':'繁體中文（臺灣）','zh-hk':'繁體中文（香港）','ja':'日本語','en':'English'};
const icons = {outline:'list-tree',files:'file-text',properties:'sliders-horizontal',insert:'plus'};
---
<BaseLayout lang={locale} reading title={copy.workbench} metadata={{noindex:true}}>
  {!articleMode&&<script is:inline>
 const articleQuery=new URLSearchParams(location.search);const articleTarget=articleQuery.get('target')||'';
 if(articleQuery.get('new')==='articles'||articleTarget.startsWith('src/content/articles/')){
  const parts=articleTarget.split('/');const id=parts.length>2?parts[parts.length-2]:'';
  location.replace('/'+location.pathname.split('/')[1]+'/articles/submit/'+(id?'?id='+encodeURIComponent(id):''));
 }
 </script>}
 <main class="visual-editor ve-workbench" data-visual-editor data-editor-enabled={String(editorEnabled)} data-editor-local={String(localEditor)} data-editor-api={editorApiBase} data-article-mode={articleMode?'true':undefined} data-article-admin={articleAdmin?'true':undefined} data-article-api={articleMode?articleApi:undefined} data-creation-copy={JSON.stringify(creationDictionary(locale))} data-locale={locale} data-content-locale={getEditableLocale(locale)} data-sidebar-hidden data-layout="split" data-mode="visual" data-side="outline">
    <header class="ve-topbar">
      <a class="ve-home" href={articleMode?`/${locale}/articles/`:`/${locale}/`}><Icon name="arrow-left" /> {articleMode?modeCopy.articles:'Wiki'}</a><h1 data-document-name>{copy.emptyTitle}</h1><span class="ve-top-save" data-save-status role="status"></span>{articleMode&&<span class="ve-top-save" data-article-cloud-status role="status">{articleCreation.local}</span>}
      <WorkspaceButton type="submit" class="ve-command-trigger" data-command-open aria-label={copy.commands}><Icon name="search" /><span>{copy.commands}</span><kbd>⌘ K</kbd></WorkspaceButton>
      <div class="ve-top-actions">{articleMode&&<><WorkspaceButton type="submit" data-article-save>{modeCopy.save}</WorkspaceButton><WorkspaceButton type="submit" tone="primary" data-article-submit class="ve-primary">{articleAdmin?(locale==='en'?'Publish article':locale==='ja'?'記事を公開':'发布文章'):modeCopy.submit}</WorkspaceButton></>}<details class="ve-tools-menu"><summary>{locale==='en'?'File':locale==='ja'?'ファイル':'文件'}</summary><div>{articleMode&&<><WorkspaceButton type="submit" data-article-new>{modeCopy.new}</WorkspaceButton><WorkspaceButton type="submit" data-article-mine>{modeCopy.mine}</WorkspaceButton><WorkspaceButton type="submit" data-article-image-open>{articleCreation.images}</WorkspaceButton></>}<WorkspaceButton type="submit" data-new-open hidden={articleMode}>{copy.newEntry}</WorkspaceButton><WorkspaceButton type="submit" data-attachments-open hidden={articleMode}>{copy.attachments}</WorkspaceButton><WorkspaceButton type="submit" class="ve-properties-entry" data-side-button="properties" aria-controls="ve-entry-properties" aria-pressed="false" aria-expanded="false">{copy.entryProperties}</WorkspaceButton><WorkspaceButton type="submit" data-existing-open hidden={articleMode}>{copy.editExisting}</WorkspaceButton><WorkspaceButton type="submit" data-import-open>{copy.import}</WorkspaceButton></div></details>
        <WorkspaceButton type="submit" tone="primary" data-pr-open class="ve-primary" hidden>{locale==='en'?'Submit via GitHub PR':locale==='ja'?'GitHub PR で投稿':'提交 GitHub PR'}</WorkspaceButton>
        {!articleMode&&!editorEnabled&&<a class="ve-pr-unavailable" href={docsGuideHref}>{locale==='en'?'Submission unavailable':locale==='ja'?'投稿は一時停止中':'投稿暂未开放'}</a>}
        <details class="ve-export-menu"><summary>{copy.exportMenu}</summary><div><WorkspaceButton type="submit" data-copy>{copy.copy}</WorkspaceButton><WorkspaceButton type="submit" data-download>{copy.download}</WorkspaceButton><p>{copy.exportHint}</p><a data-github target="_blank" rel="noopener noreferrer" hidden>{copy.github} <Icon name="arrow-up-right" /></a></div></details>
      </div>
    </header>
    {articleMode&&<p class="ve-pr-banner" role="status" data-article-status></p>}
    <div class="ve-pr-banner" data-pr-banner hidden><strong>{localEditor?st('投稿 · 本地联调'):st('投稿审核')}</strong><span>{localEditor?st('编辑、保存和审核均在本地运行。'):st('修改会提交给维护者审核，通过后发布。')}</span><WorkspaceButton type="submit" data-pr-history>{st('投稿与评论')} <span data-pr-count>0</span></WorkspaceButton></div>
<p class="ve-pr-banner" data-pr-draft-notice hidden><span data-pr-draft-description></span><WorkspaceButton type="submit" data-pr-recover>{st('查看服务端草稿')}</WorkspaceButton></p>
    <ContributionFlow locale={locale} kind={articleMode?'article':'entry'}/>
    <SubmissionReceipt locale={locale}/>
    <div class="ve-workspace">
      <div class="ve-mobile-layout" role="tablist" aria-label={copy.content}><WorkspaceButton type="button" data-mobile-pane="write" role="tab" aria-selected="true">{copy.visual}</WorkspaceButton><WorkspaceButton type="button" data-mobile-pane="preview" role="tab" aria-selected="false">{copy.preview}</WorkspaceButton></div>
      <nav class="ve-activity" aria-label={copy.workbench}>
        {(['outline','files','properties'] as const).map(side => <WorkspaceButton type="submit" data-side-button={side} hidden={articleMode&&side==='files'} aria-label={copy[side]} title={copy[side]} aria-controls={side==='outline'?'ve-outline-panel':side==='files'?'ve-files-panel':'ve-entry-properties'} aria-pressed="false" aria-expanded="false"><Icon name={icons[side]} /><span>{copy[side]}</span></WorkspaceButton>)}
        <WorkspaceButton type="submit" aria-controls="ve-insert-popover" aria-expanded="false" data-insert-open aria-label={copy.insert} title={copy.insert}><Icon name="plus" /><span>{copy.insert}</span></WorkspaceButton>
        <WorkspaceButton type="submit" data-find-open aria-label={copy.searchText} title={copy.searchText}><Icon name="search" /><span>{copy.searchText}</span></WorkspaceButton>
        <WorkspaceButton type="submit" class="ve-rail-bottom" data-sidebar-toggle aria-label={copy.toggleSidebar} title={`${copy.toggleSidebar} · ⌘ B`} aria-controls="ve-sidebar" aria-expanded="false"><Icon name="panel-left" /></WorkspaceButton>
      </nav>
      <aside id="ve-sidebar" class="ve-sidebar">
        <section id="ve-outline-panel" data-side-panel="outline"><div class="ve-panel-heading"><h2>{copy.outline}</h2><WorkspaceButton type="submit" data-new-entry hidden={articleMode} title={copy.newEntry}><Icon name="plus" /></WorkspaceButton></div><p class="ve-document-name">{copy.emptyTitle}</p><nav data-outline aria-label={copy.outline}></nav></section>
        <section id="ve-files-panel" data-side-panel="files" hidden><div class="ve-panel-heading"><h2>{copy.files}</h2><WorkspaceButton type="submit" data-sidebar-close aria-label={copy.cancel}><Icon name="x" /></WorkspaceButton></div><div data-existing-picker><label>{copy.findEntry}<WorkspaceControl type="search" data-entry-search placeholder={copy.findEntry}/></label><label>{copy.kind}<WorkspaceControl as="select" data-entry-kind><option value="">{copy.allKinds}</option>{entryTypes.filter(kind=>articleMode?kind==='articles':kind!=='articles').map(kind=><option value={kind}>{copy.kinds[kind as keyof typeof copy.kinds] || kind}</option>)}</WorkspaceControl></label><p class="ve-entry-count" data-entry-count role="status"></p><div data-entry-results></div><WorkspaceButton type="submit" data-entry-retry hidden>{copy.retry}</WorkspaceButton></div><p data-load-status role="status"></p></section>
        <section id="ve-entry-properties" class="ve-settings" data-side-panel="properties" hidden>
          <div class="ve-panel-heading"><h2>{copy.entryProperties}</h2><WorkspaceButton type="submit" data-sidebar-close aria-label={copy.cancel}><Icon name="x" /></WorkspaceButton></div>
          <label hidden={articleMode}>{copy.kind}<WorkspaceControl as="select" data-kind>{entryTypes.filter(kind=>articleMode?kind==='articles':kind!=='articles').map(k => <option value={k}>{copy.kinds[k as keyof typeof copy.kinds] || k}</option>)}</WorkspaceControl></label>
          <label>{copy.locale}<WorkspaceControl as="select" data-locale-select><option value="zh">简体中文</option><option value="ja">日本語</option><option value="en">English</option></WorkspaceControl></label>
          <div data-fields></div>
          <details class="ve-path" hidden={articleMode}><summary>{copy.path}</summary><label>{copy.path}<WorkspaceControl data-path placeholder="src/content/…/zh.md" /></label><p>{copy.pathHint}</p></details>
          <details class="ve-advanced" hidden={articleMode}><summary>{copy.advanced}</summary><div data-advanced-fields></div><WorkspaceControl as="select" data-advanced-type aria-label={copy.addProperty}></WorkspaceControl><WorkspaceButton type="submit" data-add-property>{copy.addProperty}</WorkspaceButton></details>
        </section>
      </aside>
      <section class="ve-compose" aria-label={copy.content}>
        <div class="ve-editor-tabs" role="tablist" aria-label={copy.content}><WorkspaceButton type="submit" data-mode="visual" role="tab" aria-selected="true" aria-controls="ve-canvas">{copy.visual}</WorkspaceButton><WorkspaceButton type="submit" data-mode="source" role="tab" aria-selected="false" aria-controls="ve-source" tabindex="-1">{copy.codeView}</WorkspaceButton><span class="ve-file-label" data-file-label>zh.md</span><WorkspaceButton type="submit" data-layout="write" title={copy.writeOnly} aria-label={copy.writeOnly}><Icon name="move-horizontal" /></WorkspaceButton></div>
        <div class="ve-toolbar" role="toolbar" aria-label={copy.specialFormat}>
          <WorkspaceButton type="submit" class="ve-toolbar-arrow" data-toolbar-scroll="-1" aria-label={copy.toolbarLeft} title={copy.toolbarLeft}><Icon name="chevron-left" /></WorkspaceButton><div class="ve-toolbar-scroll"><WorkspaceButton type="submit" data-undo aria-label={copy.undo} title={`${copy.undo} · ⌘ Z`}><Icon name="undo-2" /></WorkspaceButton><WorkspaceButton type="submit" data-redo aria-label={copy.redo} title={`${copy.redo} · ⌘ ⇧ Z`}><Icon name="redo-2" /></WorkspaceButton><span class="ve-toolbar-separator"></span>
          <WorkspaceButton type="submit" data-format="insertUnorderedList" aria-label={copy.bulletList} title={copy.bulletList}><Icon name="list" /></WorkspaceButton><WorkspaceButton type="submit" data-format="insertOrderedList" aria-label={copy.numberList} title={copy.numberList}><Icon name="list-ordered" /></WorkspaceButton><WorkspaceButton type="submit" data-format="outdent" aria-label={copy.outdent} title={copy.outdent}><Icon name="indent-decrease" /></WorkspaceButton><WorkspaceButton type="submit" data-format="indent" aria-label={copy.indent} title={copy.indent}><Icon name="indent-increase" /></WorkspaceButton><span class="ve-toolbar-separator"></span><WorkspaceButton type="submit" data-format="bold" aria-label={copy.bold} title={`${copy.bold} · ⌘ B`}><Icon name="bold"/></WorkspaceButton><WorkspaceButton type="submit" data-format="italic" aria-label={copy.italic} title={`${copy.italic} · ⌘ I`}><Icon name="italic"/></WorkspaceButton><WorkspaceButton type="submit" data-format="strikeThrough" aria-label={copy.strike} title={copy.strike}><Icon name="strikethrough"/></WorkspaceButton><WorkspaceButton type="submit" data-format="link" title={copy.link}>{copy.link}</WorkspaceButton><WorkspaceButton type="submit" data-inline-preset="mark" class="ve-highlight-tool" title={copy.inline.mark}>{copy.inline.mark}</WorkspaceButton><WorkspaceButton type="submit" data-inline-preset="ruby" title={copy.inline.ruby}><ruby>字<rt>あ</rt></ruby><span>{copy.inline.ruby}</span></WorkspaceButton><WorkspaceButton type="submit" data-inline-preset="spoiler" title={copy.inline.spoiler}>{copy.inline.spoiler}</WorkspaceButton></div><WorkspaceButton type="submit" class="ve-toolbar-arrow" data-toolbar-scroll="1" aria-label={copy.toolbarRight} title={copy.toolbarRight}><Icon name="chevron-right" /></WorkspaceButton><details class="ve-format-more"><summary title={copy.specialFormat} aria-label={copy.specialFormat}><Icon name="ellipsis" /></summary><div>{(['abbr','kbd','time','small','sub','sup','zh-variant'] as const).map(kind=><WorkspaceButton type="submit" data-inline-preset={kind}>{copy.inline[kind]}</WorkspaceButton>)}</div></details><WorkspaceButton type="submit" aria-controls="ve-insert-popover" aria-expanded="false" data-insert-open class="ve-insert-button"><Icon name="plus" /> {copy.insert}</WorkspaceButton>
        </div>
        <div id="ve-canvas" class="ve-canvas" role="tabpanel"><WorkspaceControl data-document-title class="ve-title-input" placeholder={copy.emptyTitle} aria-label={copy.emptyTitle}/>
          <section class="ve-starter" data-editor-starter hidden aria-label={articleMode?starter.articleTitle:starter.title}>
            <div class="ve-starter-heading"><span class="ve-starter-mark" aria-hidden="true"><Icon name="sparkles" /></span><div><h2>{articleMode?starter.articleTitle:starter.title}</h2><p>{articleMode?starter.articleDescription:starter.description}</p></div></div>
            {!articleMode&&<div class="ve-starter-entries" aria-label={starter.title}>
              <WorkspaceButton type="button" data-start-entry-kind="songs">{starter.song}<span aria-hidden="true"><Icon name="arrow-up-right" /></span></WorkspaceButton>
              <WorkspaceButton type="button" data-start-entry-kind="releases">{starter.album}<span aria-hidden="true"><Icon name="arrow-up-right" /></span></WorkspaceButton>
              <WorkspaceButton type="button" data-start-entry-kind="isotopes">{starter.isotope}<span aria-hidden="true"><Icon name="arrow-up-right" /></span></WorkspaceButton>
              <WorkspaceButton type="button" data-start-entry-kind="people">{starter.person}<span aria-hidden="true"><Icon name="arrow-up-right" /></span></WorkspaceButton>
              <WorkspaceButton type="button" class="ve-starter-existing" data-start-existing>{starter.existing}<span aria-hidden="true"><Icon name="arrow-right" /></span></WorkspaceButton>
            </div>}
            <div class="ve-starter-tools"><strong>{starter.tools}</strong><div>
              <WorkspaceButton type="button" data-start-block="lyrics">{starter.lyrics}</WorkspaceButton>
              <WorkspaceButton type="button" data-start-block="media-switcher">{starter.media}</WorkspaceButton>
              <WorkspaceButton type="button" data-start-block="ruby">{starter.ruby}</WorkspaceButton>
              <WorkspaceButton type="button" data-start-block="details">{starter.details}</WorkspaceButton>
              {articleMode?<WorkspaceButton type="button" data-article-image-open>{articleCreation.images}</WorkspaceButton>:<WorkspaceButton type="button" data-start-attachments>{copy.attachments}</WorkspaceButton>}
            </div></div><p class="ve-starter-tip">{starter.tip}</p>
          </section>
          <WorkspaceButton type="submit" class="ve-document-properties" data-side-button="properties" aria-controls="ve-entry-properties" aria-pressed="false" aria-expanded="false"><span class="ve-document-properties-title">{copy.entryProperties}<span aria-hidden="true"> <Icon name="arrow-up-right" /></span></span></WorkspaceButton>
          <div class="ve-domain-strip" data-editor-domain-strip hidden role="group" aria-label={starter.tools}><span>{starter.tools}</span><div>
            <WorkspaceButton type="button" data-start-block="lyrics">{starter.lyrics}</WorkspaceButton><WorkspaceButton type="button" data-start-block="media-switcher">{starter.media}</WorkspaceButton><WorkspaceButton type="button" data-start-block="ruby">{starter.ruby}</WorkspaceButton><WorkspaceButton type="button" data-start-block="details">{starter.details}</WorkspaceButton>
            {articleMode?<WorkspaceButton type="button" data-article-image-open>{articleCreation.images}</WorkspaceButton>:<WorkspaceButton type="button" data-start-attachments>{copy.attachments}</WorkspaceButton>}
          </div></div><div data-blocks class="ve-blocks"></div><WorkspaceButton type="submit" class="ve-add-line" data-insert-open><Icon name="plus" /> {copy.insert}<kbd>/</kbd></WorkspaceButton></div>
        <div id="ve-source" class="ve-source-editor" role="tabpanel" hidden><div class="ve-source-lines" data-source-lines aria-hidden="true">1</div><WorkspaceControl as="textarea" data-source aria-label={copy.codeView} spellcheck="false" wrap="off"></WorkspaceControl></div>
        <p data-source-error role="alert" class="ve-source-error" hidden></p>
        <div class="ve-add" hidden><WorkspaceControl as="select" data-block-type aria-label={copy.add}>{blockTypes.map(t => <option value={t}>{copy.blocks[t as keyof typeof copy.blocks]}</option>)}</WorkspaceControl><WorkspaceButton type="submit" data-add><Icon name="plus" /> {copy.add}</WorkspaceButton></div>
      </section>
      <aside class="ve-output">
        <div class="ve-tabs" role="tablist" aria-label={copy.preview}><WorkspaceButton type="submit" id="ve-preview-tab" data-view="preview" role="tab" aria-selected="true" aria-controls="ve-preview">{copy.preview}</WorkspaceButton><WorkspaceButton type="submit" id="ve-properties-tab" data-view="properties" role="tab" aria-selected="false" aria-controls="ve-properties" tabindex="-1">{copy.blockProperties}</WorkspaceButton><WorkspaceButton type="submit" data-layout="split" title={copy.split} aria-label={copy.split}><Icon name="columns-2" /></WorkspaceButton></div>
        <div id="ve-preview" data-preview role="tabpanel" aria-labelledby="ve-preview-tab" class="ve-paper wiki-reader wiki-prose prose max-w-none"></div>
        <div id="ve-properties" data-inspector role="tabpanel" aria-labelledby="ve-properties-tab" hidden></div>
      </aside>
    </div>
    <section class="ve-problems" data-problems hidden><div class="ve-panel-heading"><h2>{copy.review}</h2><WorkspaceButton type="submit" data-problems-close aria-label={copy.cancel}><Icon name="x" /></WorkspaceButton></div><p>{copy.exportHint}</p><div data-validation role="status"></div><p class="ve-hint">{copy.note}</p></section>
    <footer class="ve-statusbar"><WorkspaceButton type="submit" data-problems-toggle><span data-problem-count>0</span> · {copy.review}</WorkspaceButton><span data-block-count></span><span data-action-status role="status"></span><div class="ve-status-right"><WorkspaceControl as="select" data-ui-locale aria-label={copy.locale}>{supportedLocales.map(l=><option value={l} selected={l===locale}>{locales[l]}</option>)}</WorkspaceControl><details class="ve-theme-menu"><summary>{copy.theme}</summary><div><AppearanceControls locale={locale} compact/></div></details><WorkspaceButton type="submit" data-layout="preview" title={copy.previewOnly}>{copy.preview}</WorkspaceButton></div></footer>
    <div class="ve-selection-toolbar" data-selection-toolbar role="toolbar" aria-label={copy.specialFormat} hidden><WorkspaceButton type="submit" data-format="bold" aria-label={copy.bold}><Icon name="bold"/></WorkspaceButton><WorkspaceButton type="submit" data-format="italic" aria-label={copy.italic}><Icon name="italic"/></WorkspaceButton><WorkspaceButton type="submit" data-format="strikeThrough" aria-label={copy.strike}><Icon name="strikethrough"/></WorkspaceButton><WorkspaceButton type="submit" data-format="link">{copy.link}</WorkspaceButton><WorkspaceButton type="submit" data-inline-preset="mark" class="ve-highlight-tool">{copy.inline.mark}</WorkspaceButton><WorkspaceButton type="submit" data-inline-preset="ruby">{copy.inline.ruby}</WorkspaceButton><WorkspaceButton type="submit" data-inline-preset="zh-variant">{copy.inline['zh-variant']}</WorkspaceButton><WorkspaceButton type="submit" data-inline-preset="spoiler">{copy.inline.spoiler}</WorkspaceButton><WorkspaceButton type="submit" data-special>{copy.specialFormat}</WorkspaceButton><WorkspaceButton type="submit" data-edit-inline hidden>{copy.editFormatting}</WorkspaceButton><WorkspaceButton type="submit" data-clear-format>{copy.clearFormatting}</WorkspaceButton></div>
    <dialog class="ve-command-dialog" data-command-dialog aria-label={copy.commands}><div class="ve-command-input"><WorkspaceControl data-command-search type="search" placeholder={copy.commands} aria-label={copy.commands} autocomplete="off" role="combobox" aria-controls="ve-command-results" aria-expanded="true"/><kbd>Esc</kbd></div><div id="ve-command-results" data-command-results role="listbox"></div></dialog>
    <dialog id="ve-insert-popover" class="ve-insert-popover" data-insert-popover aria-label={copy.insert}><div class="ve-insert-search"><WorkspaceControl data-insert-search type="search" placeholder={copy.insert} aria-label={copy.insert} autocomplete="off" role="combobox" aria-controls="ve-insert-results" aria-expanded="true"/><kbd>Esc</kbd></div><div id="ve-insert-results" data-insert-results role="listbox"></div></dialog>
    <dialog data-find-dialog aria-labelledby="ve-find-title"><form method="dialog"><div class="ve-section-heading"><h2 id="ve-find-title">{copy.searchText}</h2><WorkspaceButton type="submit">{copy.cancel}</WorkspaceButton></div></form><WorkspaceControl type="search" data-find-text aria-label={copy.searchText}/><WorkspaceButton data-find-next type="submit">{copy.nextMatch}</WorkspaceButton><p data-find-status role="status"></p></dialog>
    <dialog data-link-dialog aria-labelledby="ve-link-title"><form method="dialog"><div class="ve-section-heading"><h2 id="ve-link-title">{copy.link}</h2><WorkspaceButton type="submit">{copy.cancel}</WorkspaceButton></div></form><label>{copy.text}<WorkspaceControl data-link-text/></label><label>{copy.url}<WorkspaceControl data-link-url placeholder="https://"/></label><p data-link-error role="alert"></p><div class="ve-row-tools"><WorkspaceButton data-link-remove hidden type="submit">{copy.unlink}</WorkspaceButton><WorkspaceButton data-link-apply class="ve-primary" type="submit" tone="primary">{copy.apply}</WorkspaceButton></div></dialog>
    <dialog data-import-dialog aria-labelledby="ve-import-title"><form method="dialog"><div class="ve-section-heading"><h2 id="ve-import-title">{copy.import}</h2><WorkspaceButton type="submit">{copy.cancel}</WorkspaceButton></div></form><p>{copy.importHint}</p><WorkspaceControl type="file" data-import-file accept=".md,text/markdown,text/plain" aria-label={copy.import}/><WorkspaceControl as="textarea" data-import-text aria-label={copy.original} rows={12} spellcheck="false"></WorkspaceControl><p data-import-error role="alert"></p><WorkspaceButton data-import-apply class="ve-primary" type="submit" tone="primary">{copy.applyImport}</WorkspaceButton></dialog>
    <dialog data-inline-dialog aria-labelledby="ve-inline-title"><form method="dialog"><div class="ve-section-heading"><h2 id="ve-inline-title">{copy.specialFormat}</h2><WorkspaceButton type="submit">{copy.cancel}</WorkspaceButton></div></form><label>{copy.specialFormat}<WorkspaceControl as="select" data-inline-kind>{Object.entries(copy.inline).map(([value,label])=><option value={value}>{label}</option>)}</WorkspaceControl></label><div data-inline-args></div><div data-inline-preview class="wiki-reader wiki-prose"></div><p data-inline-error role="alert"></p><div class="ve-row-tools"><WorkspaceButton data-inline-remove hidden type="submit">{copy.clearFormatting}</WorkspaceButton><WorkspaceButton data-inline-apply class="ve-primary" type="submit" tone="primary">{copy.apply}</WorkspaceButton></div></dialog>
    <script is:inline type="application/json" data-editor-copy set:html={JSON.stringify(copy).replace(/</g,'\\u003c')}/>
    <EditorPrDemo locale={locale} />
    <noscript>JavaScript is required to use the visual editor.</noscript>
    <dialog data-new-dialog class="ve-entry-dialog">
      <WorkspaceButton type="button" data-previous-draft>{tc('恢复上一份本地草稿')}</WorkspaceButton><form data-new-form><h2>{copy.newEntry}</h2>
        <label>{copy.kind}<WorkspaceControl as="select" name="kind">{entryTypes.filter(kind=>articleMode?kind==='articles':kind!=='articles').map(k=><option value={k}>{copy.kinds[k as keyof typeof copy.kinds] || k}</option>)}</WorkspaceControl></label>
        <label>{copy.locale}<WorkspaceControl as="select" name="locale"><option value="zh">简体中文</option><option value="ja">日本語</option><option value="en">English</option></WorkspaceControl></label>
        <label>{copy.emptyTitle}<WorkspaceControl name="title" required maxlength="200"/></label>
        <label>{tc('条目目录')}<WorkspaceControl name="folder" required placeholder="example-entity" pattern="[a-z0-9]+(-[a-z0-9]+)*"/></label>
        <p class="ve-hint">{tc('填写永久 ID，只使用小写英文、数字和连字符。提交时检查重名，繁体中文由简体生成。')}</p>
        <p data-new-feedback role="status"></p><div class="ve-row-tools"><WorkspaceButton type="button" data-dialog-close>{copy.cancel}</WorkspaceButton><WorkspaceButton type="submit">{copy.newEntry}</WorkspaceButton></div>
      </form>
    </dialog>
    <dialog data-shared-image-dialog class="ve-entry-dialog ve-image-library-dialog" aria-label={imageLibraryCopy(locale).title}>
      <header><h2>{imageLibraryCopy(locale).title}</h2><WorkspaceButton type="button" data-dialog-close>{imageLibraryCopy(locale).close}</WorkspaceButton></header>
      {articleMode&&<WorkspaceButton type="button" data-article-upload-open>{articleCreation.upload}</WorkspaceButton>}
      <ImageLibrary locale={locale} picker allowUpload={!articleMode}/>
      <WorkspaceButton type="button" data-library-legacy hidden>{imageLibraryCopy(locale).legacy}</WorkspaceButton>
    </dialog>
    <dialog data-attachments-dialog class="ve-entry-dialog">
      <h2>{copy.attachments}</h2>
      <WorkspaceButton type="button" data-legacy-library-open>{imageLibraryCopy(locale).title}</WorkspaceButton>
      <div hidden>
      <p class="ve-hint">{tc('站内投稿：每张最多 4 MiB、最多 8 张、合计 20 MiB。较大的图片可在本机制作 WebP 投稿副本，原图不会被改动；需要保留原图时走 GitHub 流程。')}</p>
      <ol class="ve-attachment-steps"><li>{tc('1. 选择图片并检查预览；填写图片说明、来源和使用依据。')}</li><li>{tc('2. 加入本机附件后，插入正文或设为封面。此时尚未上传。')}</li><li>{tc('3. 提交 GitHub PR 后，检查 PR 内同时有正文和图片。合并部署后才会公开。')}</li></ol>
      <label>{tc('选择图片')}<WorkspaceControl type="file" data-image-files accept="image/png,image/jpeg,image/webp" multiple/></label>
      <label class="ve-attachment-optimize"><WorkspaceControl type="checkbox" data-image-optimize checked/>{tc('超过上限时制作 WebP 投稿副本（保留原图不变）')}</label>
      <p data-image-selection role="status"></p>
      <div class="ve-attachment-previews" data-image-previews role="list" aria-label={tc('待加入的图片预览')}></div>
      <label>{tc('图片说明')}<WorkspaceControl data-image-alt maxlength="300"/></label>
      <label>{tc('来源或授权说明')}<WorkspaceControl data-image-source maxlength="2048" required placeholder={tc('官方页面链接，或原创 / 授权说明')}/></label>
      <WorkspaceButton data-image-add type="submit">{tc('加入附件')}</WorkspaceButton><p data-image-feedback role="status"></p>
      </div>
      <div data-image-list></div>
      <p class="ve-hint">{tc('超过站内限制？通过 GitHub 上传原图，并在同一 PR 中修改正文。')} <a href={`/${locale}/docs/contribute/entry/`} target="_blank" rel="noopener"><IconLabel text={tc('GitHub 原图上传与路径教程 ↗')}/></a></p>
      <WorkspaceButton data-dialog-close type="submit">{copy.cancel}</WorkspaceButton>
    </dialog>
    {articleMode&&<dialog data-article-asset-dialog class="ve-entry-dialog ve-article-image-dialog" aria-labelledby="ve-article-asset-title">
      <h2 id="ve-article-asset-title">{articleCreation.upload}</h2><p class="ve-hint" data-article-asset-hint>{articleCreation.private}</p>
      <form data-article-asset-form>
        <label>{articleCreation.file}<WorkspaceControl name="image" type="file" accept="image/png,image/jpeg,image/webp,image/gif"/></label>
        <img data-article-asset-preview alt="" hidden style="max-width:100%;max-height:220px;object-fit:contain"/>
        <label>{articleCreation.alt}<WorkspaceControl name="alt" required maxlength="300"/></label>
        <label>{articleCreation.caption}<WorkspaceControl as="textarea" name="caption" maxlength="2000" rows={2}/></label>
        <label>{articleCreation.author}<WorkspaceControl name="author" required maxlength="200"/></label>
        <label>{articleCreation.sourceTitle}<WorkspaceControl name="sourceTitle" required maxlength="300"/></label>
        <label>{articleCreation.sourceUrl}<WorkspaceControl name="sourceUrl" type="url" maxlength="2000"/></label>
        <label>{articleCreation.rightsBasis}<WorkspaceControl as="select" name="rightsBasis" required><option value="" disabled selected>{articleCreation.rightsBasis}</option><option value="official">{articleCreation.official}</option><option value="original">{articleCreation.original}</option><option value="authorized">{articleCreation.authorized}</option></WorkspaceControl></label>
        <label>{articleCreation.rightsEvidence}<WorkspaceControl as="textarea" name="rightsEvidence" maxlength="2000" rows={2}/></label>
        <p data-article-asset-status role="status"></p><div class="ve-row-tools"><WorkspaceButton type="button" name="retry" hidden>{articleCreation.retry}</WorkspaceButton><WorkspaceButton type="button" data-dialog-close>{copy.cancel}</WorkspaceButton><WorkspaceButton name="insert" type="submit" disabled>{articleCreation.insert}</WorkspaceButton></div>
      </form>
    </dialog>}
    {articleMode&&<dialog data-article-image-dialog class="ve-entry-dialog ve-article-image-dialog" aria-labelledby="ve-article-image-title">
      <h2 id="ve-article-image-title">{articleImage.title}</h2>
      <p class="ve-hint">{articleImage.description}</p>
      <label>{articleImage.url}<WorkspaceControl data-article-image-url type="url" inputmode="url" autocomplete="url" placeholder="https://images.kamitsubaki.wiki/…"/></label>
      <label>{articleImage.alt}<WorkspaceControl data-article-image-alt maxlength="300"/></label>
      <label>{articleImage.source}<WorkspaceControl data-article-image-source maxlength="2048"/></label>
      <div class="ve-article-image-preview"><img data-article-image-preview alt="" hidden/><p data-article-image-status role="status">{articleImage.invalid}</p></div>
      <p class="ve-hint"><a href={`/${locale}/gallery/manage/photos/`}><IconLabel text={articleImage.gallery}/></a></p>
      <div class="ve-row-tools"><WorkspaceButton type="button" data-article-image-cancel>{articleImage.cancel}</WorkspaceButton><WorkspaceButton type="button" class="ve-primary" data-article-image-insert disabled tone="primary">{articleImage.insert}</WorkspaceButton></div>
    </dialog>}
    <style is:global>
      .ve-attachment-steps{display:grid;gap:5px;list-style:none;margin:0 0 18px;padding:0;color:rgb(var(--theme-fg-rgb)/.7);font-size:12px;line-height:1.7}
      .ve-attachment-optimize{display:flex!important;align-items:center;gap:9px;line-height:1.5}
      .ve-attachment-optimize input{width:16px!important;min-height:16px!important;flex:0 0 16px}
      .ve-attachment-previews{display:grid;grid-template-columns:repeat(auto-fill,minmax(125px,1fr));gap:10px;margin:0 0 16px}
      .ve-attachment-previews:empty{display:none}
      .ve-attachment-preview{min-width:0;padding:8px;border:1px solid var(--ui-line);border-radius:8px;font-size:11px;line-height:1.45}
      .ve-attachment-preview img{display:block;width:100%;height:100px;object-fit:contain;background:rgb(var(--theme-fg-rgb)/.04);margin-bottom:7px}
      .ve-attachment-preview strong,.ve-attachment-preview small{display:block;overflow-wrap:anywhere}
      .ve-attachment-preview small{color:rgb(var(--theme-fg-rgb)/.6)}
      .ve-attachment-preview[data-error]{border-color:#ba4f4f}
      .ve-article-image-dialog{max-width:660px}
      .ve-article-image-preview{display:grid;place-items:center;min-height:130px;margin:12px 0;padding:12px;border:1px solid var(--ui-line);border-radius:8px;background:rgb(var(--theme-fg-rgb)/.025)}
      .ve-article-image-preview img{display:block;max-width:100%;max-height:260px;object-fit:contain}
      .ve-article-image-preview img[hidden]{display:none}
      .ve-article-image-preview p{margin:0;text-align:center;font-size:12px;color:rgb(var(--theme-fg-rgb)/.65)}
      .ve-article-image-dialog>.ve-row-tools{position:sticky;bottom:-16px;justify-content:flex-end;padding:12px 0;background:var(--theme-bg)}
    </style>
    {articleMode&&<dialog data-article-dialog class="ve-entry-dialog"><h2>{modeCopy.mine}</h2><div data-article-proposals></div><WorkspaceButton data-article-prev type="submit">{modeCopy.previous}</WorkspaceButton><WorkspaceButton data-article-next type="submit">{modeCopy.next}</WorkspaceButton><WorkspaceButton data-dialog-close type="submit">{modeCopy.close}</WorkspaceButton></dialog>}
  </main>
  <script>import '../../scripts/visualEditor.js';</script>
</BaseLayout>

<style is:global>


</style>
