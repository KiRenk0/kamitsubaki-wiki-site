---
import type {HTMLAttributes} from 'astro/types';
import '../styles/workspaceToolbar.css';
interface Props extends HTMLAttributes<'form'> {}
const {class:className,...attributes}=Astro.props;
---
<form {...attributes} class:list={['workspace-filters','workspace-toolbar',className]} data-workspace-filters data-workspace-toolbar><slot/></form>
<style is:global>.workspace-filters[hidden]{display:none!important}</style>
