---
interface Props { prefix:string; character?:string; title?:string; live?:boolean; locale?:string }
const {prefix,character='',title='',live=false,locale='zh'}=Astro.props;
const labels=locale==='en'?{author:'Image creator · required',basis:'Basis for use · required',evidence:'Authorization details',official:'Official public material',original:'My original work',authorized:'Authorized use'}:locale==='ja'?{author:'画像の作者・必須',basis:'利用根拠・必須',evidence:'許可の説明',official:'公式公開素材',original:'投稿者オリジナル',authorized:'許可済み'}:{author:'图片作者 · 必填',basis:'使用依据 · 必填',evidence:'授权说明',official:'官方公开素材',original:'投稿者原创',authorized:'已获授权'};
const fields=[['character','角色 · 必填',character],['title','设定名称',title],['form','形态 / 服装',''],['date','资料日期',''],['tags','标签',''],['publisher','发布机构',''],['sourceTitle','来源名称',''],['sourceUrl','来源链接',''],['author',labels.author,''],['rightsBasis',labels.basis,''],['rightsEvidence',labels.evidence,'']];
---
<div class="creation-fields">
 {fields.map(([name,label,value])=><label for={`${prefix}-${name}`}><span>{label}</span>{live&&name==='character'?<><input data-character-filter aria-label="搜索角色" type="search" placeholder="搜索角色名称"/><select id={`${prefix}-${name}`} name="character" aria-label="角色 · 必填" required><option value="">请选择角色</option></select></>:name==='rightsBasis'?<select id={`${prefix}-${name}`} name={name} required={live}><option value="">{labels.basis}</option><option value="official">{labels.official}</option><option value="original">{labels.original}</option><option value="authorized">{labels.authorized}</option></select>:<><input id={`${prefix}-${name}`} name={name} value={value} required={live&&['author','sourceTitle'].includes(name)||name==='character'} type={name==='sourceUrl'?'url':'text'} list={live&&name==='form'?`${prefix}-forms`:undefined} placeholder={name==='date'?'YYYY / YYYY-MM / YYYY-MM-DD':name==='tags'?'用逗号分隔':name==='form'?'选择已有形态或输入新名称':undefined}/>{live&&name==='form'&&<datalist id={`${prefix}-forms`} data-form-options/>}</>}</label>)}
 <label class="creation-fields__wide" for={`${prefix}-notes`}><span>设定备注</span><textarea id={`${prefix}-notes`} name="notes" rows="2" placeholder="作品背景、补充说明或需要审核者注意的内容"></textarea></label>
 {live&&<p class="creation-fields__wide creation-destination" data-set-destination>选择角色后，这套设定会归入该角色的图库。</p>}
</div>
