---
import { brandIcons } from '../lib/brandIcons.mjs';
interface Props {provider:'github'|'google';}
const {provider}=Astro.props;
---
<svg class="account-provider-icon site-brand-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false" data-brand={provider}><path fill="currentColor" d={brandIcons[provider].path}/></svg>
<style>.account-provider-icon{display:block;flex:none;width:20px;height:20px}</style>
