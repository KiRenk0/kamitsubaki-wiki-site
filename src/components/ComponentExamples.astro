---
import ContentTabs from './ContentTabs.astro';
import WorkspaceButton from './WorkspaceButton.astro';
import WorkspaceLinkCard from './WorkspaceLinkCard.astro';
const {locale='zh'}=Astro.props;
const labels=locale==='en'?['Live components','Overview','Details','Primary action','Secondary action','Documentation']:locale==='ja'?['実際のコンポーネント','概要','詳細','主操作','補助操作','ドキュメント']:['真实组件示例','概览','详情','主要操作','辅助操作','文档中心'];
---
<section class="component-examples"><h2>{labels[0]}</h2><ContentTabs id="component-demo" label={labels[0]} tabs={[{id:'overview',label:labels[1]},{id:'details',label:labels[2]}]}><div slot="overview"><WorkspaceLinkCard href={`/${locale}/docs/`} title={labels[5]} description="WorkspaceLinkCard"/></div><div slot="details"><code>ContentTabs · aria-selected · keyboard navigation</code></div></ContentTabs><div class="example-actions"><WorkspaceButton href={`/${locale}/contribute/`} tone="primary">{labels[3]}</WorkspaceButton><WorkspaceButton href={`/${locale}/docs/`}>{labels[4]}</WorkspaceButton></div></section>
<style>.component-examples{margin:28px 0;padding:24px;border:1px solid rgb(var(--theme-fg-rgb)/.15);border-radius:8px}.component-examples h2{font:22px var(--font-serif);margin-bottom:20px}.example-actions{display:flex;gap:12px;margin-top:20px;flex-wrap:wrap}</style>
