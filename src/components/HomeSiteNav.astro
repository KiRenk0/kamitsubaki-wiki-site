---
import {accountCopy} from '../lib/accountCopy.mjs';
import CompactLanguageSwitcher from './CompactLanguageSwitcher.astro';
import { resolveLocaleCopy } from '../lib/i18n.mjs';

type NavItem = {
  label: string;
  href: string;
};

type LocaleLink = {
  code: string;
  label: string;
  shortLabel: string;
  navShortLabel?: string;
  dropdownLabel?: string;
  href: string;
  current: boolean;
};

const { navItems, localeLinks, brandLines, homeHref = '/', compact = false } = Astro.props as {
  navItems: NavItem[];
  localeLinks: LocaleLink[];
  brandLines: string[];
  homeHref?: string;
  compact?: boolean;
};

const labsLabel = 'LABs';
const currentLocale = localeLinks.find((item) => item.current)?.code ?? 'en';
const menuCopy = resolveLocaleCopy({
  zh:{menu:'菜单',title:'探索与设置',about:'关于本站',experiences:'互动体验',database:'艺人资料',songs:'歌曲',albums:'专辑',projects:'企划',game:'游戏'},
  ja:{menu:'メニュー',title:'探索と設定',about:'サイトについて',experiences:'体験',database:'アーティスト',songs:'楽曲',albums:'アルバム',projects:'プロジェクト',game:'ゲーム'},
  en:{menu:'Menu',title:'Explore & settings',about:'About',experiences:'Experiences',database:'Artists',songs:'Songs',albums:'Albums',projects:'Projects',game:'Games'},
},currentLocale);
const itemLabel=(item:NavItem)=>menuCopy[item.href.split('#')[1] as keyof typeof menuCopy] || (item.href.includes('/games/')?menuCopy.game:item.label);
const searchLabel = resolveLocaleCopy({
  zh: '打开站内搜索',
  ja: 'サイト内検索を開く',
  en: 'Open site search',
}, currentLocale);
const themeCopy = resolveLocaleCopy({
  zh: {
    groupLabel: '主题模式',
    options: [
      { value: 'light', shortLabel: '日', label: '使用浅色模式' },
      { value: 'dark', shortLabel: '夜', label: '使用深色模式' },
      { value: 'system', shortLabel: '系', label: '跟随系统模式' },
    ],
  },
  ja: {
    groupLabel: 'テーマモード',
    options: [
      { value: 'light', shortLabel: '昼', label: 'ライトモードを使用' },
      { value: 'dark', shortLabel: '夜', label: 'ダークモードを使用' },
      { value: 'system', shortLabel: '自', label: 'システム設定に従う' },
    ],
  },
  en: {
    groupLabel: 'Theme mode',
    options: [
      { value: 'light', shortLabel: 'DAY', label: 'Use light mode' },
      { value: 'dark', shortLabel: 'NIGHT', label: 'Use dark mode' },
      { value: 'system', shortLabel: 'SYS', label: 'Follow system theme' },
    ],
  },
}, currentLocale);
---

<nav class:list={["site-nav home-chrome", compact ? "home-chrome--compact" : "site-nav--home"]} data-home-nav-collision aria-label={currentLocale === 'ja' ? 'メインナビゲーション' : currentLocale === 'en' ? 'Main navigation' : '主导航'}>
  <div class="site-nav__home-cluster">
    <a href={homeHref} class="home-chrome__brand" data-home-nav-brand>
      <p>{brandLines.map((line, index) => <>{line}{index < brandLines.length - 1 && <br />}</>)}</p>
    </a>
    <div class="site-nav__controls-destination" data-home-nav-controls-destination></div>
  </div>
  <div class="home-chrome__actions">
    <a class="account-nav" data-account-nav href={`/${currentLocale}/account/`}>{accountCopy(currentLocale).title}</a>
    <a href={`/${currentLocale}/labs/explore/`} class="home-chrome__labs">{labsLabel}<span aria-hidden="true">↗</span></a>
    <button class="home-chrome__search" type="button" data-search-open aria-label={searchLabel} title={searchLabel}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6" /><path d="m15 15 4.5 4.5" /></svg>
    </button>
    <details class="home-chrome__menu" data-chrome-menu>
      <summary><span>{menuCopy.menu}</span><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 6h14M3 14h14" /></svg></summary>
      <div class="home-chrome__panel">
        <p class="home-chrome__eyebrow">{menuCopy.title} <kbd data-search-shortcut>Ctrl+K</kbd></p>
        <div class="home-chrome__links">
          <a href={`/${currentLocale}/account/`} data-account-nav>{accountCopy(currentLocale).title}</a>
          {navItems.map((item, index) => <a href={item.href}><small aria-hidden="true">{String(index + 1).padStart(2, '0')}</small>{itemLabel(item)}<span aria-hidden="true">↗</span></a>)}
        </div>
        <div class="site-nav__controls-origin" data-home-nav-controls-origin>
          <div class="site-nav__portable-controls" data-home-nav-portable-controls>
            <div class="home-chrome__preferences">
              <CompactLanguageSwitcher localeLinks={localeLinks} />
              <div class="site-nav__theme-switcher" data-theme-switcher role="radiogroup" aria-label={themeCopy.groupLabel}>
                {themeCopy.options.map((option: { value: string; shortLabel: string; label: string }) => (
                  <button type="button" class="site-nav__theme-option" data-theme-toggle data-theme-value={option.value} role="radio" aria-checked="false" aria-label={option.label} title={option.label}>{option.shortLabel}</button>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </details>
  </div>
</nav>

<script>
  import '../scripts/homeNavCollision.js';
  import '../scripts/quietChrome.js';
</script>
