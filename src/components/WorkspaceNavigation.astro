---
interface Props { label: string; kind: 'hub' | 'labs' | 'account'; }
const {label,kind}=Astro.props;
const attributes=kind==='hub'?{'data-hub-nav':''}:kind==='labs'?{'data-labs-nav':''}:{};
---
<div data-workspace-nav-sentinel aria-hidden="true"></div>
<div class="workspace-nav-shell" data-workspace-nav-shell>
  <nav class:list={['workspace-nav',kind==='account'?'account-sections':'labs-nav']} aria-label={label} data-workspace-navigation {...attributes}>
    <span class="workspace-nav-indicator" data-workspace-indicator aria-hidden="true"></span>
    <slot/>
  </nav>
</div>
<script>
  import {initializeWorkspaceNavigation} from '../lib/workspaceNavigation.mjs';
  document.querySelectorAll('[data-workspace-navigation]').forEach(nav=>initializeWorkspaceNavigation(nav));
</script>
<style is:global>
html body .workspace-nav-shell{position:sticky;top:96px;z-index:40;min-height:50px;margin-bottom:20px;pointer-events:none}
html body nav.workspace-nav[data-workspace-navigation]{position:relative;top:auto;display:flex;flex-direction:row;flex-wrap:nowrap;isolation:isolate;gap:4px;width:100%;max-width:100%;margin:0 auto;padding:5px;overflow-x:auto;border:1px solid rgb(var(--theme-fg-rgb)/.14);border-radius:var(--ui-radius-panel);background:var(--theme-bg);scrollbar-width:thin;pointer-events:auto;transition:width var(--motion-glass) var(--motion-ease-glide),border-radius var(--motion-glass) var(--motion-ease-glide),background var(--motion-surface) var(--motion-ease-glide),box-shadow var(--motion-surface) var(--motion-ease-glide)}
html body nav.workspace-nav[data-workspace-navigation]>a{position:relative;z-index:1;display:flex;flex:1 0 auto;justify-content:center;align-items:center;min-height:36px;padding:8px 12px;font-size:13px;line-height:1.5;white-space:nowrap;border:0;border-radius:var(--ui-radius-control);color:rgb(var(--theme-fg-rgb)/.65);background:none;box-shadow:none;text-decoration:none;opacity:1;transition:color var(--motion-fast),background var(--motion-fast),font-size var(--motion-glass),padding var(--motion-glass),min-height var(--motion-glass)}
html body nav.workspace-nav[data-workspace-navigation]>a[aria-current]{color:var(--theme-accent-color);background:none;box-shadow:none;font-weight:500}
html body nav.workspace-nav[data-workspace-navigation]>a:not([aria-current]):hover{color:var(--theme-fg);background:rgb(var(--theme-fg-rgb)/.04)}
html body nav.workspace-nav[data-workspace-navigation]>a:focus-visible{outline:2px solid var(--theme-accent-color);outline-offset:-2px}
html body .workspace-nav-indicator{position:absolute;top:0;left:0;z-index:0;border:1px solid color-mix(in srgb,var(--theme-accent-color) 20%,transparent);border-radius:var(--ui-radius-control);background:color-mix(in srgb,var(--theme-accent-color) 7%,transparent);pointer-events:none;opacity:0}
html body [data-slider-ready]>.workspace-nav-indicator{opacity:1;transition:transform var(--motion-glass) var(--motion-ease-glide),width var(--motion-glass) var(--motion-ease-glide),height var(--motion-glass) var(--motion-ease-glide),border-radius var(--motion-glass) var(--motion-ease-glide)}
html body .workspace-nav-shell[data-compact] [data-workspace-navigation]{border-radius:22px;background:rgb(var(--theme-bg-rgb)/.9);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);box-shadow:0 5px 20px rgb(0 0 0/.08)}
html body .workspace-nav-shell[data-compact] [data-workspace-navigation]>a{font-size:11px;min-height:32px;padding:6px 8px;border-radius:18px}
html body .workspace-nav-shell[data-compact] .workspace-nav-indicator{border-radius:18px}
@media(min-width:1100px){html body .workspace-nav-shell{top:28px}html body .workspace-nav-shell[data-compact] [data-workspace-navigation]{width:min(760px,calc(100vw - 650px))}}
@media(max-width:760px){html body .workspace-nav-shell{top:80px}html body nav.workspace-nav[data-workspace-navigation]>a{padding-inline:10px;font-size:12px}}
@media(prefers-reduced-motion:reduce){html body nav.workspace-nav[data-workspace-navigation],html body nav.workspace-nav[data-workspace-navigation]>a,html body [data-slider-ready]>.workspace-nav-indicator{transition:none}}
@media(prefers-reduced-transparency:reduce){html body .workspace-nav-shell[data-compact] [data-workspace-navigation]{background:var(--theme-bg);backdrop-filter:none;-webkit-backdrop-filter:none}}
</style>
