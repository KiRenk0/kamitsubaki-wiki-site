---
import ResponsiveImage from './ResponsiveImage.astro';
import ExternalLinkCard from './ExternalLinkCard.astro';
import {entityLabel} from '../lib/entityLabels.mjs';
import {resolveLocaleCopy} from '../lib/i18n.mjs';
import type {ResolvedEntity,EntityRegistry} from '../lib/entityRegistry.mjs';
const {entry,registry,locale}=Astro.props as {entry:ResolvedEntity;registry:EntityRegistry;locale:string};
const d=entry.data;
const copy=resolveLocaleCopy({zh:{card:'资料卡',roles:'身份 / 职能',activity:'活动状态',start:'开始活动',date:'发行日期',duration:'时长',affiliations:'所属 / 厂牌',links:'官方链接',theme:'条目配色',credits:'制作名单',engine:'声库引擎',venue:'场地',release:'发行形式'},ja:{card:'情報欄',roles:'役割',activity:'活動状況',start:'活動開始',date:'発売日',duration:'長さ',affiliations:'所属',links:'公式リンク',theme:'テーマ配色',credits:'クレジット',engine:'音声エンジン',venue:'会場',release:'リリース形式'},en:{card:'Record details',roles:'Roles',activity:'Activity',start:'Active since',date:'Release date',duration:'Duration',affiliations:'Affiliations',links:'Official links',theme:'Palette',credits:'Credits',engine:'Voice engines',venue:'Venue',release:'Release type'}},locale);
const facts=[{label:copy.roles,value:d.roles?.map((role:string)=>entityLabel(role,locale)).join(' / ')},{label:copy.activity,value:d.lifecycle?.activity&&entityLabel(d.lifecycle.activity,locale)},{label:copy.start,value:d.lifecycle?.startedAt},{label:copy.date,value:d.releaseDate||d.dateRange?.start},{label:copy.duration,value:d.duration},{label:copy.release,value:d.releaseType&&entityLabel(d.releaseType,locale)},{label:copy.engine,value:d.voiceEngines?.map((e:{engine:string})=>e.engine).join(' / ')},{label:copy.venue,value:d.venue?.name}].filter(f=>f.value);
---
<section class="wiki-infobox entity-info" aria-label={copy.card}>
 <header><small>{copy.card} / {entityLabel(d.entityType,locale)}</small><h2>{d.name||d.title}</h2><p>{d.romanizedName||d.romanizedTitle}</p></header>
 {d.presentation?.image&&<figure><ResponsiveImage src={d.presentation.image} alt={d.name||d.title||d.id} widths={[192,480,960]} sizes="(min-width:1024px) 256px, 360px"/></figure>}
 <div class="entity-info-body"><dl>{facts.map(f=><div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}</dl>
 {d.affiliations?.length>0&&<section><h3>{copy.affiliations}</h3>{d.affiliations.map((a:{organization:string;current:boolean})=>{const e=registry.resolveEntity(a.organization,locale);return e&&<a class="info-relation" href={e.url}>{e.data.name||e.data.title}{!a.current&&<small>{entityLabel('historical',locale)}</small>}</a>})}</section>}
 {(d.credits||[]).length>0&&<section><h3>{copy.credits}</h3>{(d.credits||[]).map(c=>{const e=c.entity?registry.resolveEntity(c.entity,locale):undefined;return <div class="info-credit"><small>{entityLabel(c.role,locale)}</small>{e?<a href={e.url}>{e.data.name||e.data.title}</a>:<span>{c.name}</span>}</div>})}</section>}
 {d.officialLinks?.length>0&&<section><h3>{copy.links}</h3><div class="info-links">{d.officialLinks.map((link:{url:string;label?:string;platform?:string})=><ExternalLinkCard href={link.url} label={link.label||link.platform||link.url} compact/>)}</div></section>}
 {d.presentation?.theme?.palette?.length>0&&<section><h3>{copy.theme}</h3><div class="theme-swatch-row">{d.presentation.theme.palette.map((swatch:{value:string;label:string})=><span title={`${swatch.label} ${swatch.value}`}><i style={`background:${swatch.value}`} aria-hidden="true"></i><small>{swatch.label}</small></span>)}</div></section>}
 </div>
</section>
<style>
.entity-info{overflow:hidden;border:1px solid var(--reader-line);border-radius:var(--ui-radius-panel);background:rgb(var(--theme-fg-rgb)/.025);backdrop-filter:blur(12px)}header{padding:18px;border-bottom:1px solid var(--reader-line)}header>small{font:9px/1.8 var(--font-mono);color:var(--reader-muted);letter-spacing:.1em}header h2{font:500 23px/1.6 var(--font-serif);margin:6px 0}header p{font:10px var(--font-mono);color:var(--reader-muted)}figure{margin:0;padding:5px}figure :global(img){width:100%;aspect-ratio:1;object-fit:cover;border-radius:3px}.entity-info-body{padding:0 18px 18px}dl{margin:0}dl>div{display:grid;grid-template-columns:5rem 1fr;gap:12px;padding:12px 0;border-bottom:1px solid var(--reader-line);font-size:12px;line-height:1.8}dt{color:var(--reader-muted)}dd{margin:0;overflow-wrap:anywhere}section section{margin-top:20px}h3{font:500 11px var(--font-sans);letter-spacing:.06em;color:var(--reader-muted);margin-bottom:12px}.info-relation{display:flex;justify-content:space-between;font-size:12px;padding:8px 0}.info-relation small,.info-credit small{color:var(--reader-muted)}.info-credit{display:grid;grid-template-columns:5rem 1fr;font-size:12px;gap:12px;padding:6px 0}.info-links{display:grid;gap:8px}.theme-swatch-row{display:flex;gap:10px;flex-wrap:wrap}.theme-swatch-row>span{flex:1;min-width:40px}.theme-swatch-row i{display:block;height:18px;border-radius:3px}.theme-swatch-row small{display:block;font-size:9px;margin-top:6px;color:var(--reader-muted)}
</style>
