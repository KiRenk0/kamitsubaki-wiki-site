---
import '../styles/entityInfoBox.css';
import ResponsiveImage from './ResponsiveImage.astro';
import ExternalLinkCard from './ExternalLinkCard.astro';
import {entityInfoModel} from '../lib/entityInfoModel.mjs';
import type {ResolvedEntity,EntityRegistry} from '../lib/entityRegistry.mjs';
const {entry,registry,locale}=Astro.props as {entry:ResolvedEntity;registry:EntityRegistry;locale:string};
const d=entry.data;
const model=entityInfoModel(d,registry,locale);
const {kind,artwork,artists,copy,coreFacts,extraFacts,hasMore}=model;
---
<section class="wiki-infobox entity-info" data-card-kind="entity" data-entity-type={d.entityType} data-placeholder={artwork.placeholder||undefined} aria-label={copy.card}>
 <header><small>{copy.card} / {model.typeLabel}</small><h2>{model.title}</h2>{model.romanized&&<p class="info-romanized">{model.romanized}</p>}{artists.length>0&&<p class="info-artists">{artists.map((artist,index)=><>{index>0&&' / '}<a href={artist.url}>{artist.title}</a></>)}</p>}</header>
 {model.showArtwork&&<figure><ResponsiveImage src={artwork.src} alt={artwork.placeholder?'':d.name||d.title||d.id} widths={[192,480,960]} sizes="(min-width:1024px) 256px, 360px" data-original={artwork.src}/></figure>}
 <div class="entity-info-body"><dl class="entity-info-facts">{coreFacts.map(f=><div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}</dl>
 {hasMore&&<details class="entity-info-more" open={!kind||undefined}>
 <summary>{copy.more}</summary>
 <div class="entity-info-more-body">
 {extraFacts.length>0&&<dl class="entity-info-facts">{extraFacts.map(f=><div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}</dl>}
 {model.affiliations.length>0&&<section><h3>{copy.affiliations}</h3>{model.affiliations.map(a=><div><a class="info-relation" href={a.url}>{a.title}{a.historical&&<small>{a.historicalLabel}</small>}</a>{a.dates&&<small class="info-relation-date">{a.dates}</small>}</div>)}</section>}
 {model.credits.length>0&&<section id="entry-credits"><h3>{copy.credits}</h3><dl class="entity-info-credits">{model.credits.map(c=><div class="info-credit"><dt>{c.role}</dt><dd>{c.url?<a href={c.url}>{c.title}</a>:<span>{c.title}</span>}</dd></div>)}</dl></section>}
 {model.links.length>0&&<section><h3>{copy.links}</h3><div class="info-links">{model.links.map(link=><ExternalLinkCard href={link.url} label={link.label} compact/>)}</div></section>}
 {model.palette.length>0&&<section><h3>{copy.theme}</h3><div class="theme-swatch-row">{model.palette.map((swatch:{value:string;label:string})=><span title={`${swatch.label} ${swatch.value}`}><i style={`background:${swatch.value}`} aria-hidden="true"></i><small>{swatch.label}</small></span>)}</div></section>}
 </div>
 </details>}
 </div>
</section>
