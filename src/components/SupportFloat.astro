---
import WorkspaceButton from './WorkspaceButton.astro';
import Icon from './Icon.astro';
import { resolveLocaleCopy } from '../lib/i18n.mjs';
const { locale = 'en' } = Astro.props;
const giveCopy=resolveLocaleCopy({zh:{label:'发电',action:'为观测站发电'},ja:{label:'支援',action:'観測所を支援する'},en:{label:'Support',action:'Support the observatory'}},locale);
---

<aside class="support-float" data-support-float>
 <WorkspaceButton tone="primary" class="support-float__toggle" type="button" data-support-open aria-label={giveCopy.action} title={giveCopy.action} aria-haspopup="dialog" aria-controls="wiki-support-dialog"><Icon name="heart"/><span class="support-float__label">{giveCopy.label}</span></WorkspaceButton>
</aside>



<script>
  import '../scripts/supportFloat.js';
</script>
