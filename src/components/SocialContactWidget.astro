---
import ContactIcon from './ContactIcon.astro';
import Icon from './Icon.astro';
import { getLanguageTag } from '../lib/i18n.mjs';

type SocialContactItem = {
  label: string;
  href: string;
  handle?: string;
  description?: string;
  icon?: string;
  enabled?: boolean;
  featured?: boolean;
};

type SocialContactCopy = {
  enabled?: boolean;
  eyebrow: string;
  title: string;
  buttonLabel: string;
  closeLabel: string;
  helper?: string;
  maxVisible?: number;
  items: SocialContactItem[];
};

const { lang = 'zh', copy } = Astro.props as { lang?: string; copy: SocialContactCopy };
const languageTag = getLanguageTag(lang);

const items = copy.items
  .filter((item) => item.enabled !== false && item.href)
  .sort((a, b) => Number(Boolean(b.featured)) - Number(Boolean(a.featured)))
  .slice(0, copy.maxVisible ?? copy.items.length);
---

{copy.enabled !== false && items.length > 0 && (
  <aside class="social-contact" id="social-contact" data-social-contact lang={languageTag}>
    <div class="social-contact__panel" id="social-contact-panel" data-social-contact-panel role="dialog" aria-label={copy.title} hidden>
      <div class="social-contact__head">
        <div>
          <p>{copy.eyebrow}</p>
          <h2>{copy.title}</h2>
        </div>
        <button type="button" data-social-contact-close aria-label={copy.closeLabel}>
          <Icon name="x" />
        </button>
      </div>
      {copy.helper && <p class="social-contact__helper">{copy.helper}</p>}
      <div class="social-contact__list">
        {items.map((item) => {

          return (
            <a class:list={['social-contact__link', { 'is-featured': item.featured }]} href={item.href} aria-label={[item.label, item.handle || item.description].filter(Boolean).join(' · ')} target={item.href.startsWith('http') ? '_blank' : undefined} rel={item.href.startsWith('http') ? 'noreferrer' : undefined}>
              <span class="social-contact__icon" aria-hidden="true">
                <ContactIcon name={item.icon ?? 'link'} />
              </span>
              <span class="social-contact__text">
                <strong>{item.label}</strong>
                {(item.handle || item.description) && <small>{item.handle || item.description}</small>}
              </span>
            </a>
          );
        })}
      </div>
    </div>
    <button
      class="social-contact__toggle"
      type="button"
      data-social-contact-toggle
      aria-label={copy.buttonLabel}
      aria-controls="social-contact-panel"
      aria-expanded="false"
    >
      <span aria-hidden="true">//</span>
      <Icon name="share" />
    <strong>{copy.buttonLabel}</strong>
    </button>
  </aside>
)}

<script>
  import '../scripts/socialContact.js';
</script>
