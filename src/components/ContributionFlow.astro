---
import {resolveLocaleCopy} from '../lib/i18n.mjs';
import ContextAction from './ContextAction.astro';
import '../styles/contributionFlow.css';
interface Props {kind:'entry'|'article'|'gallery';locale:string;}
const {kind,locale}=Astro.props;
const c=resolveLocaleCopy({
 zh:{steps:{entry:['编辑词条','核对差异','提交审核'],article:['撰写文章','保存草稿','提交审核'],gallery:['建立设定','上传照片','提交审核']},guide:'查看投稿指南',next:{entry:'保留原文并补充资料；提交前核对差异。',article:'先写正文并保存云端草稿，再提交审核。',gallery:'每套设定单独添加照片；暂存完成后再提交审核。'},receipt:'已收到投稿',record:'投稿编号',progress:'查看审核进度'},
 en:{steps:{entry:['Edit entry','Review changes','Submit for review'],article:['Write article','Save draft','Submit for review'],gallery:['Create set','Upload photos','Submit for review']},guide:'Submission guide',next:{entry:'Preserve the source and review your changes before submitting.',article:'Write and save a cloud draft before submitting for review.',gallery:'Add photos to each set; submit only after staging is complete.'},receipt:'Contribution received',record:'Record ID',progress:'Track review'},
 ja:{steps:{entry:['項目を編集','差分を確認','審査に提出'],article:['記事を書く','下書きを保存','審査に提出'],gallery:['設定を作成','写真をアップロード','審査に提出']},guide:'投稿ガイド',next:{entry:'原文を残し、提出前に差分を確認します。',article:'本文を書いてクラウド下書きに保存してから提出します。',gallery:'設定ごとに写真を追加し、一時保存後に審査へ提出します。'},receipt:'投稿を受け付けました',record:'投稿番号',progress:'審査状況を見る'}
},locale);
const steps=c.steps[kind] as string[];
---
<section class="contribution-flow" data-contribution-flow data-flow-kind={kind} aria-label={c.guide}>
 <div class="contribution-flow__steps">{steps.map((step,index)=><span data-flow-step={index+1} data-active={index===0?'true':undefined}><i>{String(index+1).padStart(2,'0')}</i>{step}</span>)}<ContextAction href={`/${locale}/docs/contribute/${kind}/`} tone="quiet">{c.guide}</ContextAction></div>
 <p data-flow-next role="status">{c.next[kind]}</p>
 <div class="contribution-flow__receipt" data-flow-receipt hidden role="status"><strong>{c.receipt}</strong><span data-flow-receipt-state></span><small>{c.record} · <code data-flow-receipt-id></code></small><ContextAction data-flow-receipt-link>{c.progress}</ContextAction></div>
</section>
