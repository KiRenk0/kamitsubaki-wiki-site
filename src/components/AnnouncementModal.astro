---
import '../styles/announcements.css';
type Announcement = {
  id: string;
  date: string;
  type: string;
  title: string;
  summary: string;
  html: string;
  draft?: boolean;
};

const { announcement, labels } = Astro.props as {
  announcement?: Announcement;
  labels: { open: string; close: string; heading: string; draft: string };
};

if (!announcement) return;

---

<button
  class="announcement-launcher"
  type="button"
  data-announcement-open
  aria-label={labels.open}
  aria-controls="announcement-modal-panel"
>
  <span aria-hidden="true">//</span>
  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="M6.5 4.5h11v15h-11zM9 8h6M9 11.5h6M9 15h4" />
  </svg>
</button>

<div class="announcement-modal" data-announcement-modal data-announcement-id={announcement.id} data-announcement-draft={announcement.draft ? "true" : undefined} hidden>
  <button class="announcement-modal__scrim" type="button" data-announcement-close aria-label={labels.close}></button>
  <section id="announcement-modal-panel" class="announcement-modal__panel" role="dialog" aria-modal="true" aria-labelledby="announcement-modal-title" tabindex="-1">
    <div class="announcement-modal__topline">
      <span>{announcement.draft ? labels.draft : labels.heading}</span>
      <span>{announcement.date}</span>
    </div>
    <header class="announcement-modal__header">
      <h2 id="announcement-modal-title">{announcement.title}</h2>
    </header>
    <div class="announcement-modal__scroll" tabindex="0" role="region" aria-labelledby="announcement-modal-title">
      <article class="announcement-modal__content wiki-reader wiki-prose prose prose-invert max-w-none" set:html={announcement.html}></article>
    </div>
    <div class="announcement-modal__footer">
      <button type="button" class="announcement-modal__button announcement-modal__button--primary" data-announcement-close>{labels.close}</button>
    </div>
  </section>
</div>

<script>
  const modal = document.querySelector('[data-announcement-modal]');
  const openButton = document.querySelector('[data-announcement-open]');
  const closeButtons = modal?.querySelectorAll('[data-announcement-close]') ?? [];
  const announcementId = modal instanceof HTMLElement ? modal.dataset.announcementId ?? '' : '';
  const isDraft = modal instanceof HTMLElement && modal.dataset.announcementDraft === 'true';
  const storageKey = isDraft
    ? 'kamitsubaki-wiki-announcement-preview-seen'
    : 'kamitsubaki-wiki-announcement-seen';
  let hasSeenAnnouncement = false;
  try {
    hasSeenAnnouncement = window.localStorage.getItem(storageKey) === announcementId;
  } catch { /* The notice remains usable when storage is unavailable. */ }
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let closeTimer: number | undefined;
  let autoOpenTimer: number | undefined;

  const openModal = () => {
    if (!(modal instanceof HTMLElement)) return;
    if (autoOpenTimer !== undefined) window.clearTimeout(autoOpenTimer);
    if (closeTimer !== undefined) window.clearTimeout(closeTimer);
    modal.classList.remove('is-closing');
    modal.hidden = false;
    // First display counts as seen; a refresh or followed link must not reopen it.
    try { window.localStorage.setItem(storageKey, announcementId); } catch { /* Optional persistence. */ }
    document.body.classList.add('announcement-modal-open');
    window.requestAnimationFrame(() => {
      const panel = modal.querySelector('.announcement-modal__panel');
      if (panel instanceof HTMLElement) panel.focus({ preventScroll: true });
    });
  };

  const closeModal = () => {
    if (!(modal instanceof HTMLElement) || modal.hidden || modal.classList.contains('is-closing')) return;
    if (autoOpenTimer !== undefined) window.clearTimeout(autoOpenTimer);
    document.body.classList.remove('announcement-modal-open');
    modal.classList.add('is-closing');
    closeTimer = window.setTimeout(() => {
      modal.hidden = true;
      modal.classList.remove('is-closing');
      const dock = openButton?.closest('details');
      const focusTarget = dock instanceof HTMLDetailsElement && !dock.open ? dock.querySelector('summary') : openButton;
      if (focusTarget instanceof HTMLElement) focusTarget.focus();
    }, prefersReducedMotion ? 0 : 380);
  };

  if (!hasSeenAnnouncement && modal instanceof HTMLElement) {
    autoOpenTimer = window.setTimeout(openModal, 450);
  }

  openButton?.addEventListener('click', openModal);
  closeButtons.forEach((button) => button.addEventListener('click', closeModal));
  window.addEventListener('keydown', (event) => {
    if (!(modal instanceof HTMLElement) || modal.hidden) return;
    if (event.key === 'Escape') closeModal();
    if (event.key === 'Tab') {
      const focusable = [...modal.querySelectorAll<HTMLElement>('a[href], button, summary, [tabindex="0"], input, select, textarea')]
        .filter((element) => !element.hasAttribute('disabled') && element.getClientRects().length > 0 && !element.matches('.announcement-modal__scrim'));
      const first = focusable[0];
      const last = focusable.at(-1);
      if (!first || !last) return;
      if (event.shiftKey && (document.activeElement === first || document.activeElement?.matches('.announcement-modal__panel'))) {
        event.preventDefault(); last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault(); first.focus();
      }
    }
  });
</script>
