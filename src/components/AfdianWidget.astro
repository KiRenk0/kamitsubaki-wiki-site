---
import Icon from './Icon.astro';
import {supportCatalog} from '../lib/supportCatalog.mjs';
import {resolveLocaleCopy} from '../lib/i18n.mjs';
const {locale='zh'}=Astro.props;
const text=resolveLocaleCopy({
 zh:{title:'通过爱发电支持',intro:'在爱发电查看完整档位，选择适合自己的金额与组别。',frame:'爱发电官方创作者名片',link:'打开爱发电',note:'组件未显示时，可直接打开爱发电。'},
 ja:{title:'愛発電で支援する',intro:'愛発電でプランの詳細を確認し、お好きな金額とグループを選べます。',frame:'愛発電の公式クリエイターカード',link:'愛発電を開く',note:'表示されない場合は愛発電を直接開いてください。'},
 en:{title:'Support on Afdian',intro:'View the full plans on Afdian and choose an amount and observer group that suits you.',frame:'Official Afdian creator card',link:'Open Afdian',note:'If the card does not load, open Afdian directly.'}
},locale);
---
<div class="support-afdian">
 <div class="support-afdian__heading">
  <p class="support-eyebrow">AFDIAN</p><h2>{text.title}</h2><p>{text.intro}</p>
  <a class="support-afdian__link" href={supportCatalog.source} target="_blank" rel="noopener noreferrer">{text.link}<Icon name="arrow-up-right"/></a>
 </div>
 <div class="support-afdian__card">
  <iframe id="afdian_leaflet_LinkTh1rsty" src="https://afdian.com/leaflet?slug=LinkTh1rsty" title={text.frame} width="640" scrolling="no" height="200" frameborder="0" loading="lazy" referrerpolicy="no-referrer" sandbox="allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox allow-forms"></iframe>
  <p>{text.note}</p>
 </div>
</div>
