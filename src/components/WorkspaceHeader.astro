---
interface Props {title:string;intro:string;eyebrow?:string;backHref?:string;backLabel?:string;}
const {title,intro,eyebrow,backHref,backLabel}=Astro.props;
---
<header class="workspace-header">
  {backHref&&<div class="workspace-back-row"><a class="workspace-back" href={backHref}><span aria-hidden="true">←</span><span>{backLabel||'LABs'}</span></a></div>}
  <div class="workspace-heading">{eyebrow&&<p class="workspace-eyebrow">{eyebrow}</p>}<h1>{title}</h1><p>{intro}</p></div>
  <div class="workspace-actions"><slot/></div>
  <div class="workspace-header-status"><slot name="status"/></div>
</header>
<style>.workspace-header-status:empty,.workspace-header-status:not(:has(:not([hidden]):not(:empty))){display:none}.workspace-actions:empty{display:none}</style>
