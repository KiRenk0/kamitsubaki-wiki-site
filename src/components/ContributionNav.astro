---
import {resolveLocaleCopy} from '../lib/i18n.mjs';
import { editorCopy } from '../lib/visualEditorCopy.mjs';
const {locale='zh',current='edit'}=Astro.props;
const copy=editorCopy(locale);
const items=[['',resolveLocaleCopy({zh:'贡献中心',en:'Contribution hub',ja:'貢献センター'},locale)],['edit',copy.guide],['editor',copy.title],['syntax',copy.syntax],['format',copy.format],['files',resolveLocaleCopy({zh:'图片与文件',en:'Images and files',ja:'画像とファイル'},locale)]];
---
<nav class="contribution-nav" aria-label={copy.guide}>
  {items.map(([path,label])=><a href={path==='editor' ? `/${locale}/contribute/editor/` : path==='edit' ? `/${locale}/contribute/edit/` : path==='syntax'||path==='format' ? `/${locale}/docs/contribute/${path}/` : `/${locale}/contribute/${path ? '#'+path : ''}`} aria-current={current===path?'page':undefined}>{label}</a>)}
</nav>
<style>
 .contribution-nav { display:flex; flex-wrap:wrap; gap:8px 24px; padding:0 0 16px; margin-bottom:12px; border-bottom:1px solid var(--ui-line); }
 .contribution-nav a { display:inline-flex; align-items:center; min-height:44px; font-size:12px; line-height:1.5; color:rgb(var(--theme-fg-rgb)/.56); text-decoration:none; }
 .contribution-nav a[aria-current],.contribution-nav a:hover { color:var(--theme-accent-color); }
 .contribution-nav a[aria-current] { box-shadow:inset 0 -2px currentColor; }
 .contribution-nav a:focus-visible { outline:2px solid var(--theme-accent-color); outline-offset:3px; }
 @media(max-width:520px){.contribution-nav { flex-wrap:nowrap;overflow-x:auto;gap:4px 20px;scrollbar-width:thin; }.contribution-nav a{flex:none;font-size:12px}}
</style>
