---
import type {HTMLAttributes} from 'astro/types';
interface Props extends HTMLAttributes<'button'> {href?:string;tone?:'primary'|'secondary'|'quiet';}
const {href,tone='secondary',type='button',disabled=false,class:className,...attributes}=Astro.props;
const Tag=href?'a':'button';
---
<Tag {...attributes} class:list={['workspace-button',className]} data-tone={tone} href={disabled?undefined:href} type={href?undefined:type} disabled={href?undefined:disabled} aria-disabled={disabled?'true':undefined} tabindex={href&&disabled?-1:undefined}><slot/></Tag>
