---
import Icon from './Icon.astro';
const {labels}=Astro.props;
---
<button
  class="announcement-launcher"
  type="button"
  data-announcement-open
  aria-label={labels.open}
  aria-controls="announcement-modal-panel"
>
  <span aria-hidden="true">//</span>
  <Icon name="file-text" />
  <strong>{labels.heading}</strong>
</button>

