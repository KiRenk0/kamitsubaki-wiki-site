---
import HomeSiteNav from './HomeSiteNav.astro';
const { navItems, localeLinks, brandLines, homeHref = '/' } = Astro.props;
const resolvedNavItems = navItems.map((item: { label: string; href: string }) => ({
  ...item,
  href: item.href.startsWith('#') ? `${homeHref}${item.href}` : item.href,
}));
---

<HomeSiteNav navItems={resolvedNavItems} localeLinks={localeLinks} brandLines={brandLines} homeHref={homeHref} compact />
